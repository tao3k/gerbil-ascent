(import :gerbil-ascent/program/interface
        :gerbil-ascent/program/syntax
        :gerbil-ascent/program/higher-order
        :gerbil-ascent/interface/evidence-module
        (only-in :clan/poo/object .ref))
(export (import: :gerbil-ascent/program/interface)
        (import: :gerbil-ascent/program/syntax)
        (import: :gerbil-ascent/program/higher-order)
        ascent-evidence-module define-evidence
        make-declared-evidence recorded-evidence-explanation)

(def (recorded-evidence-explanation program result query scope)
  (hash ("status" "recorded-only") ("query" query) ("scope" scope)
        ("dependencies" (.ref program 'rules))
        ("gap" "Declaration dependencies and current source rows are not per-row proof or execution authority")))

;; Public labels are metadata, not a projection or an execution restriction.
;; Preserve the complete upstream Program, including opaque fields and callbacks.
(def (make-declared-evidence program sources outputs explain)
  (def (bindings values)
    (unless (and (list? values)
                 (andmap (lambda (value)
                           (and (pair? value) (symbol? (car value)) (symbol? (cdr value)))) values))
      (error "invalid Evidence relation bindings"))
    (let ((labels (make-hash-table-eq)) (handles (make-hash-table-eq)))
      (for-each (lambda (value)
        (when (or (hash-get labels (car value)) (hash-get handles (cdr value)))
          (error "duplicate Evidence relation binding" value))
        (hash-put! labels (car value) #t) (hash-put! handles (cdr value) #t)) values))
    values)
  (let* ((sources (bindings sources)) (outputs (bindings outputs))
         (names (map (cut .ref <> 'name) (.ref program 'relations)))
         (combined sources))
    (for-each (lambda (binding)
      (unless (memq (cdr binding) names)
        (error "Evidence binding does not name a declared relation" binding))
      (unless (member binding combined)
        (when (or (assq (car binding) combined)
                  (find (lambda (prior) (eq? (cdr prior) (cdr binding))) combined))
          (error "conflicting Evidence public relation binding" binding))
        (set! combined (append combined (list binding))))) outputs)
    (ascent-evidence-module
      (gerbil-ascent-program (.ref program 'relations) (.ref program 'rules)
        (.ref program 'max-input-facts) (.ref program 'max-derived-facts)
        (.ref program 'max-output-facts) (map cdr sources))
      explain combined)))

;; Ordinary hygienic Scheme binding: helpers, imports, macros and native
;; Program/Fragment/operator constructors retain their upstream semantics.
(defsyntax (define-evidence stx)
  (def (bindings entries)
    (with-syntax (((binding ...)
                  (map (lambda (entry)
                         (syntax-case entry ()
                           (name (identifier? (syntax name))
                            (syntax (cons 'name 'name)))
                           ((name handle) (and (identifier? (syntax name))
                                               (identifier? (syntax handle)))
                            (syntax (cons 'name 'handle)))
                           ((name handle) (identifier? (syntax name))
                            (syntax (cons 'name handle)))
                           (_ (raise-syntax-error #f "Evidence binding requires a relation identifier or (label handle)" stx entry))))
                       (syntax->list entries))))
      (syntax (list binding ...))))
  (syntax-case stx (sources outputs explain)
    ((_ (constructor argument ...) (sources source ...) (outputs output ...)
        (explain explanation) clause ...)
     (with-syntax ((source-bindings (bindings (syntax (source ...))))
                   (output-bindings (bindings (syntax (output ...)))))
       (syntax (def (constructor argument ...)
                 (make-declared-evidence (ascent clause ...)
                   source-bindings output-bindings explanation)))))
    ((_ (constructor argument ...) (sources source ...) (outputs output ...) clause ...)
     (with-syntax ((source-bindings (bindings (syntax (source ...))))
                   (output-bindings (bindings (syntax (output ...)))))
       (syntax (def (constructor argument ...)
                 (make-declared-evidence (ascent clause ...)
                   source-bindings output-bindings recorded-evidence-explanation)))))
    ((_ constructor (sources source ...) clause ...)
     (raise-syntax-error #f "Evidence sources must be followed by outputs" stx))
    ((_ (constructor argument ...) program explanation)
     (syntax (def (constructor argument ...) (ascent-evidence-module program explanation))))
    ((_ (constructor argument ...) program)
     (syntax (def (constructor argument ...) (ascent-evidence-module program))))))
