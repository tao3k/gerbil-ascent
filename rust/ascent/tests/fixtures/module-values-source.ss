(def (make-counter n) (lambda (x) (set! n (+ n x)) n))
(def (lexical-shadow)
  (let* ((x 1) (read (lambda () x)) (x 2)) (read)))
(def (rational) (/ 2 6))
(def (same-cycle)
  (let ((a (make-vector 1)) (b (make-vector 1)))
    (vector-set! a 0 a) (vector-set! b 0 b) (equal? a b)))
(def (shared)
  (let* ((v (vector 17)) (outer (vector v v)))
    (eq? (vector-ref outer 0) (vector-ref outer 1))))
(def (distinct-symbols)
  (not (eq? (string->uninterned-symbol "s") (string->uninterned-symbol "s"))))
(def (table-key)
  (let (table (make-hash-table))
    (hash-put! table (string-append "k" "ey") 7)
    (hash-ref table (string-append "ke" "y"))))
(def (pair-value) (car '(9 . 2)))
(defrules private-plus () ((_ x) (+ x 1)))
(defrules number-case () ((_ 1/3) 7) ((_ other) 9))
(def (macro-definition-scope)
  (let ((+ (lambda (a b) 99))) (private-plus 2)))
(def (macro-number-case) (number-case 2/6))
