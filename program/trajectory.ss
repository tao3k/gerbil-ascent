;;; Native ordered observations. Provider usage and grader verdicts are trusted
;;; host observations, not model-authored proof or reconstructed hidden thinking.
(import :std/encoding/json (only-in :std/hash/misc hash-key?))
(export ascent-trajectory)
(def owners (make-hash-table-eqv))
(def next-owner 0)
(def (text value) (and (string? value) (> (string-length value) 0)))
(def (natural value) (and (exact-integer? value) (>= value 0)))
(def (clone value)
  (call-with-input-string (json->string value)
    (lambda (port) (read-json port object-as-hash: #t))))
(def (totals)
  (hash ("modelCalls" 0) ("inputTokens" 0) ("outputTokens" 0) ("thinkingTokens" 0)
        ("usageComplete" #t) ("thinkingComplete" #t) ("repairModelCalls" 0)
        ("repairThinkingTokens" 0) ("repairThinkingComplete" #t)
        ("failedVerifications" 0) ("directAnswers" 0) ("evidenceEvents" 0)
        ("checkpoints" 0) ("supportedBranches" 0) ("contradictedBranches" 0) ("unknownBranches" 0)))
(def (add! stats key value) (hash-put! stats key (+ (hash-ref stats key) value)))
(def (observation state include-events (closed #f) (reason #f))
  (let* ((first (hash-ref state "firstCorrect")) (all (hash-ref state "totals"))
         (after (and first (hash ("modelCalls" (- (hash-ref all "modelCalls") (hash-ref first "modelCalls")))
             ("thinkingTokens" (- (hash-ref all "thinkingTokens") (hash-ref first "thinkingTokens")))
             ("thinkingComplete" (hash-ref all "thinkingComplete")))))
         (result (hash ("schema" "ascent.trajectory.v1") ("task" (hash-ref state "task"))
                ("sourceIdentity" (hash-ref state "sourceIdentity")) ("generation" (hash-ref state "generation"))
                ("eventCount" (length (hash-ref state "events")))
                ("totals" (clone all)) ("throughFirstCorrect" (clone first))
                ("postSuccess" after) ("verified" (if first #t #f))
                ("closed" closed) ("censored" (and closed (not first)))
                ("finishReason" reason) ("completedEpochs" (clone (hash-ref state "completedEpochs"))))))
    (when include-events (hash-put! result "events" (clone (hash-ref state "events")))) result))
(def comparison-premises '("questionIdentity" "scopeIdentity" "operationIdentity"
                           "inputIdentity" "toolIdentity" "modelIdentity"))
(def (reasoning-context state)
  (let (attempts [])
    (for-each (lambda (event)
      (when (equal? (hash-ref event "kind") "attempt")
        (let (premises (hash))
          (for-each (lambda (key)
            (when (hash-key? event key)
              (hash-put! premises key (hash-ref event key))))
            (append comparison-premises '("proposalIdentity" "purpose")))
          (set! attempts (cons
            (hash ("earlierEvent" (hash-ref event "id"))
                  ("generation" (hash-ref event "generation"))
                  ("historical" (not (= (hash-ref event "generation")
                                         (hash-ref state "generation"))))
                  ("premises" premises))
            attempts)))))
      (hash-ref state "events"))
    (hash ("schema" "ascent.trajectory-context.v1")
          ("ownerIdentity" (hash-ref state "ownerIdentity"))
          ("sourceIdentity" (hash-ref state "sourceIdentity"))
          ("generation" (hash-ref state "generation"))
          ("eventCount" (length (hash-ref state "events")))
          ("attempts" (reverse attempts))
          ("executionAuthorized" #f) ("actionSelected" #f))))
(def (exploration state candidate)
  (for-each (lambda (key)
    (unless (text (hash-ref candidate key #f)) (error "candidate identity required" key)))
    '("questionIdentity" "operationIdentity" "inputIdentity"))
  (for-each (lambda (key)
    (when (hash-key? candidate key)
      (unless (text (hash-ref candidate key)) (error "invalid optional candidate identity" key))))
    '("scopeIdentity" "toolIdentity" "modelIdentity" "contractIdentity"))
  (let (comparisons [])
    (for-each (lambda (earlier)
      (when (and (equal? (hash-ref earlier "kind") "attempt")
                 (equal? (hash-ref earlier "questionIdentity") (hash-ref candidate "questionIdentity")))
        (let ((changed []) (unknown [])
              (historical (not (= (hash-ref earlier "generation") (hash-ref state "generation")))))
          (for-each (lambda (key)
            (let ((old (hash-ref earlier key #f)) (new (hash-ref candidate key #f)))
              (cond ((or (not (text old)) (not (text new))) (set! unknown (cons key unknown)))
                    ((not (equal? old new)) (set! changed (cons key changed))))))
            comparison-premises)
          (let* ((reference (hash-ref earlier "resultReference" #f))
                 (relation (cond (historical "historical")
                                 ((pair? changed) "changed-premise")
                                 ((pair? unknown) "comparison-unknown")
                                 (else "exact-current"))))
            (set! comparisons (cons
              (hash ("earlierEvent" (hash-ref earlier "id")) ("relation" relation)
                    ("changedPremises" (reverse changed)) ("unknownPremises" (reverse unknown))
                    ("currentEvidenceReference"
                     (if (and (not historical) reference
                              (hash-key? (hash-ref state "verifiedReferences") reference)
                              (text (hash-ref earlier "contractIdentity" #f))
                              (equal? (hash-ref earlier "contractIdentity")
                                      (hash-ref candidate "contractIdentity" #f))
                              (equal? (hash-ref earlier "contractIdentity")
                                      (hash-ref (hash-ref state "consumed") reference #f)))
                         reference #f)))
              comparisons))))))
      (hash-ref state "events"))
    (hash ("schema" "ascent.trajectory-exploration.v1")
          ("ownerIdentity" (hash-ref state "ownerIdentity"))
          ("sourceIdentity" (hash-ref state "sourceIdentity"))
          ("generation" (hash-ref state "generation"))
          ("eventCount" (length (hash-ref state "events")))
          ("comparisons" (reverse comparisons))
          ("executionAuthorized" #f) ("actionSelected" #f))))
(def (append-event state supplied)
  ;; Mutate a fresh copy and publish only after every check succeeds.
  (let* ((next (clone state)) (event (clone supplied))
         (id (hash-ref event "id")) (kind (hash-ref event "kind"))
         (stats (hash-ref next "totals")) (seen (hash-ref next "seen"))
         (refs (hash-ref next "references")) (failures (hash-ref next "failures"))
         (consumed (hash-ref next "consumed")))
    (unless (and (text id) (text kind) (not (hash-key? seen id))) (error "duplicate or invalid trajectory event" id))
    (when (>= (length (hash-ref next "events")) 4096) (error "trajectory event capacity reached"))
    (unless (equal? (hash-ref event "sourceIdentity") (hash-ref next "sourceIdentity"))
      (error "stale trajectory event source"))
    (let (round (hash-ref event "round" (hash-ref next "round")))
      (unless (and (natural round) (>= round (hash-ref next "round"))) (error "trajectory round moved backwards"))
      (hash-put! next "round" round) (hash-put! event "round" round))
    (case (string->symbol kind)
      ((attempt)
       (for-each (lambda (key)
         (unless (text (hash-ref event key #f)) (error "attempt identity required" key)))
         '("questionIdentity" "operationIdentity" "inputIdentity"))
       (for-each (lambda (key)
         (when (hash-key? event key)
           (unless (text (hash-ref event key)) (error "invalid optional attempt identity" key))))
         '("scopeIdentity" "toolIdentity" "modelIdentity" "proposalIdentity" "purpose" "contractIdentity"))
       (when (hash-key? event "resultReference")
         (unless (hash-key? refs (hash-ref event "resultReference"))
           (error "current attempt result reference required"))
         (unless (text (hash-ref event "contractIdentity" #f))
           (error "attempt result contract identity required"))))
      ((model-call)
       (let ((usage (hash-ref event "usage" (hash))) (repair (hash-ref event "repairOf" #f)))
         (when (and repair (not (hash-key? failures repair))) (error "repair must reference a failed current-generation verdict"))
         (add! stats "modelCalls" 1)
         (when repair (add! stats "repairModelCalls" 1))
         (for-each (lambda (key)
           (let (value (hash-ref usage key #f))
             (cond ((natural value) (add! stats key value))
                   ((eq? value #f) (hash-put! stats (if (equal? key "thinkingTokens") "thinkingComplete" "usageComplete") #f))
                   (else (error "invalid provider usage" key))))) '("inputTokens" "outputTokens" "thinkingTokens"))
         (when repair
           (let (thinking (hash-ref usage "thinkingTokens" #f))
             (if (natural thinking) (add! stats "repairThinkingTokens" thinking)
                 (hash-put! stats "repairThinkingComplete" #f))))))
      ((evidence)
       (unless (and (text (hash-ref event "resultReference")) (text (hash-ref event "pathIdentity")))
         (error "native evidence references required"))
       (hash-put! refs (hash-ref event "resultReference") (hash-ref next "generation"))
       (add! stats "evidenceEvents" 1))
      ((direct-answer)
       (unless (hash-key? refs (hash-ref event "resultReference")) (error "unknown or invalidated evidence reference"))
       (add! stats "directAnswers" 1))
      ((checkpoint)
       (unless (equal? (hash-ref seen (hash-ref event "modelCall") #f) "model-call") (error "checkpoint requires an observed model call"))
       (let ((branches (hash-ref event "branches")) (ids (make-hash-table)))
         (unless (and (list? branches) (<= (length branches) 128)) (error "bounded checkpoint branches required"))
         (for-each (lambda (branch)
           (let ((id (hash-ref branch "id")) (status (hash-ref branch "status")))
             (unless (and (text id) (not (hash-key? ids id))) (error "distinct branch identities required"))
             (hash-put! ids id #t)
             (unless (member status '("supported" "contradicted" "unknown")) (error "invalid branch status"))
             (unless (equal? status "unknown")
               (unless (hash-key? refs (hash-ref branch "resultReference")) (error "current branch evidence required")))
             (when (equal? status "contradicted")
               (unless (eq? (hash-ref branch "complete" #f) #t) (error "negative branch requires complete domain check")))
             (add! stats (cond ((equal? status "supported") "supportedBranches")
                              ((equal? status "contradicted") "contradictedBranches")
                              (else "unknownBranches")) 1))) branches))
       (add! stats "checkpoints" 1))
      ((consumption)
       (let (interpretation (hash-ref event "interpretation" #f))
         ;; An LLM interpretation remains an observation, never an NL proof.
         (when interpretation
           (unless (and (hash-table? interpretation)
                        (equal? (hash-ref interpretation "scope") "model-interpreted")
                        (text (hash-ref interpretation "utteranceIdentity"))
                        (text (hash-ref interpretation "resolver"))
                        (equal? (hash-ref seen (hash-ref interpretation "modelCall") #f) "model-call"))
             (error "interpretation must bind an observed model call and utterance"))))
       (unless (and (hash-key? refs (hash-ref event "consumedReference"))
                    (hash-key? refs (hash-ref event "resultReference"))
                    (text (hash-ref event "intentIdentity"))
                    (text (hash-ref event "contractIdentity")))
         (error "current admitted evidence consumption required"))
       (hash-put! consumed (hash-ref event "resultReference") (hash-ref event "contractIdentity")))
      ((verification)
       (unless (and (text (hash-ref event "verifier")) (boolean? (hash-ref event "correct")))
         (error "independent verifier identity and Boolean verdict required"))
       (let (scope (hash-ref event "scope" "task"))
       (unless (member scope '("task" "subgoal")) (error "invalid verification scope"))
       (when (hash-ref event "consumptionReference" #f)
         (let (reference (hash-ref event "consumptionReference"))
           (unless (hash-key? consumed reference)
             (error "verification requires an admitted consumption reference"))
           (if (hash-ref event "correct")
             (hash-put! (hash-ref next "verifiedReferences") reference #t)
             (hash-remove! (hash-ref next "verifiedReferences") reference))))
       (if (hash-ref event "correct")
         (unless (or (equal? scope "subgoal") (hash-ref next "firstCorrect"))
           (let (first (clone stats))
             (hash-put! first "event" id) (hash-put! first "round" (hash-ref event "round"))
             (hash-put! next "firstCorrect" first)))
         (begin (hash-put! failures id #t) (add! stats "failedVerifications" 1)))))
      ((invalidate)
       (unless (text (hash-ref event "nextSourceIdentity")) (error "new source identity required"))
       (hash-put! next "completedEpochs" (append (hash-ref next "completedEpochs")
         [(hash ("sourceIdentity" (hash-ref next "sourceIdentity")) ("generation" (hash-ref next "generation"))
                ("totals" (clone stats)) ("throughFirstCorrect" (clone (hash-ref next "firstCorrect"))))]))
       (hash-put! next "generation" (+ 1 (hash-ref next "generation")))
       (hash-put! next "sourceIdentity" (hash-ref event "nextSourceIdentity"))
       (hash-put! next "references" (hash)) (hash-put! next "verifiedReferences" (hash))
       (hash-put! next "failures" (hash)) (hash-put! next "consumed" (hash))
       (hash-put! next "totals" (totals)) (hash-put! next "firstCorrect" #f) (hash-put! next "round" 0))
      (else (error "unknown trajectory event kind" kind)))
    (hash-put! event "sequence" (+ 1 (length (hash-ref next "events"))))
    (hash-put! event "generation" (hash-ref state "generation"))
    (hash-put! seen id kind)
    (hash-put! next "events" (append (hash-ref next "events") [event])) next))
(def (ascent-trajectory request)
  (case (string->symbol (hash-ref request "action"))
    ((open)
     (let ((task (hash-ref request "task")) (source (hash-ref request "sourceIdentity")))
       (unless (and (text task) (text source)) (error "task and source identities required"))
       (when (>= (hash-length owners) 64) (error "trajectory owner capacity reached"))
       (set! next-owner (+ next-owner 1))
       (hash-put! owners next-owner (hash ("task" task) ("sourceIdentity" source) ("generation" 0)
         ("ownerIdentity" next-owner) ("round" 0) ("events" []) ("seen" (hash)) ("references" (hash))
         ("verifiedReferences" (hash)) ("failures" (hash)) ("consumed" (hash))
         ("totals" (totals)) ("firstCorrect" #f) ("completedEpochs" [])))
       (hash ("trajectory" next-owner) ("sourceIdentity" source))))
    (else
     (let* ((handle (hash-ref request "trajectory")) (state (hash-get owners handle)))
       (unless state (error "unknown or closed trajectory"))
       (case (string->symbol (hash-ref request "action"))
         ((append)
          (let (next (append-event state (hash-ref request "event")))
            (hash-put! owners handle next) (observation next #f)))
         ((snapshot) (observation state (hash-ref request "includeEvents" #t)))
         ((context) (reasoning-context state))
         ((explore) (exploration state (hash-ref request "candidate")))
         ((exploration-current)
          (let (packet (hash-ref request "packet"))
            (and (member (hash-ref packet "schema" #f)
                         '("ascent.trajectory-exploration.v1" "ascent.trajectory-context.v1"))
                 (equal? (hash-ref packet "ownerIdentity" #f) (hash-ref state "ownerIdentity"))
                 (equal? (hash-ref packet "sourceIdentity" #f) (hash-ref state "sourceIdentity"))
                 (equal? (hash-ref packet "generation" #f) (hash-ref state "generation"))
                 (equal? (hash-ref packet "eventCount" #f) (length (hash-ref state "events"))))))
         ((close)
          (let (result (observation state #t #t (hash-ref request "reason" "closed")))
            (hash-remove! owners handle) result))
         (else (error "unknown trajectory action")))))))
