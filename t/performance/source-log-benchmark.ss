(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/program/source-log
        :gerbil-ascent/t/performance/source-log/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "SOURCE-LOG-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass?
          (case mode
            ((kernel) (and (<= (median bb) (* 0.10 (median ab)))
                           (<= (median bc) (* 0.70 (median ac))) (>= wins 35)))
            ((pending) (and (<= (median bb) (* 0.10 (median ab)))
                            (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))
            ((update) (and (<= (median bb) (* 0.92 (median ab)))
                           (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))
            (else (and (<= (median bb) (+ (median ab) 1024))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))))
      ;; Fixed gates: empty-addition / mismatch kernels save 90% allocation,
      ;; 30% CPU / 35 wins. Pending comparison saves 90% allocation;
      ;; public updates save 8%. Nonkernel CPU <=5%+20 us; small <=1 KiB.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (unless (member scenario '("join" "equal" "pending" "mismatch" "update" "appended-update" "small"))
    (error "unknown source log scenario" scenario))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "source log benchmark requires symmetric native modules" name))))
   '("program/source-log" "program/session" "program/evaluate"
     "t/performance/source-log/reference-update-selection" "t/performance/source-log/reference-reuse"
     "t/performance/source-log/reference-evaluate" "t/performance/source-log/reference-session"
     "t/performance/source-log/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((update? (member scenario '("update" "appended-update" "small")))
         (mode (cond ((string=? scenario "small") 'control) (update? 'update)
                     ((string=? scenario "pending") 'pending) (else 'kernel)))
         (result
          (if update?
            (let* ((count (if (string=? scenario "small") 2 16))
                   (size (if (= count 2) 1 1024))
                   (program (source-log-program count size))
                   (append? (string=? scenario "appended-update"))
                   (a (source-log-request #t program append?))
                   (b (source-log-request #f program append?))
                   (expected (cons (if append? (append (map list (iota size)) '((9999))) (map list (iota size)))
                                   (make-list (- count 2) (map list (iota size))))))
              (paired scenario (lambda () (source-log-update a count)) (lambda () (source-log-update b count))
                      (lambda (a b)
                        (unless (and (equal? a b) (car b)
                                     (eq? (cadr b) 'stratified-dependency-invalidation)
                                     (member (car (caddr b)) '(((7000)) ((7001))))
                                     (equal? (cdr (caddr b)) expected))
                          (error "public source transaction independent rows parity"))) 4 mode))
            (let* ((base (map list (iota 4096)))
                   (additions (if (string=? scenario "pending") (map list (iota 128 4096)) []))
                   (rows (if (string=? scenario "mismatch") '((bad)) (append base (reverse additions))))
                   (join? (string=? scenario "join"))
                   (old (lambda () (let (joined (append base (reverse additions))) (if join? joined (equal? joined rows)))))
                   (new (lambda () (if join? (gerbil-ascent-source-log-rows base additions)
                                      (gerbil-ascent-source-log-equal? base additions rows)))))
              (paired scenario old new
                      (lambda (a b) (unless (and (equal? a b)
                                                 (equal? b (if join? base (not (string=? scenario "mismatch")))))
                                      (error "ordered source kernel parity"))) 64 mode)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline '42fce45e9ba2e19de68eb88cdd62badddcbed9d3)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "source log allocation/CPU gate failed" scenario)))
  (displayln "OK") (force-output))
