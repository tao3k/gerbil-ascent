(import (only-in :asp-gerbil-scheme/benchmark-api
                 benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/core/positive-plan
                 gerbil-ascent-compile-positive-plan gerbil-ascent-run-positive-plan! gerbil-ascent-index-key)
        (rename-in (only-in :gerbil-ascent/t/performance/slot-projection/reference
                           gerbil-ascent-compile-positive-plan gerbil-ascent-run-positive-plan! gerbil-ascent-index-key)
                   (gerbil-ascent-compile-positive-plan old-compile)
                   (gerbil-ascent-run-positive-plan! old-run)
                   (gerbil-ascent-index-key old-key)))
(export main)
;; : (-> (List Number) Number)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
;; : (forall (a) (-> (-> a) Nat (values a Number Number)))
(def (measure call repetitions)
  (##gc)
  (let (before (##process-statistics))
    (let loop ((n repetitions) (result #f))
      (if (zero? n)
        (let* ((after (##process-statistics))
               (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9))))
          (unless (>= bytes 0) (error "invalid cumulative allocation delta"))
          (values result (/ bytes repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- n 1) (call))))))
;; : (-> String Path Path Void)
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/slot-projection/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid slot projection fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown slot projection scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "slot projection module mismatch" name)))
    '("core/positive-plan" "t/performance/slot-projection/reference"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (width (get 'width))
         (columns (case (get 'shape)
                    ((sparse) (filter even? (iota width)))
                    ((reverse) (reverse (iota width)))
                    ((repeat) (append (reverse (iota width)) (iota width)))
                    ((empty) [])
                    ((single) (list (- width 1)))
                    (else (iota width))))
         (terms (map (lambda (_) (cons 'variable (gensym 'slot))) (iota width)))
         (source-atom (vector 0 terms [])) (indexed-atom (vector 1 terms columns))
         (heads (list (vector 2 (list (car terms)))))
         (body (list (vector 'atom source-atom) (vector 'atom indexed-atom)))
         (rows (map (lambda (n) (map (lambda (column) (+ (* n width) column)) (iota width))) (iota 4)))
         (index (make-hash-table)) (expected (map (lambda (row) (list (car row))) rows))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (for-each (lambda (row)
                (hash-put! index (map (lambda (column) (list-ref row column)) columns) (list row))) rows)
    (def (lifecycle compile run key)
      (let* ((plan (compile heads body)) (frame (make-vector (vector-ref plan 2) #f)) (output []))
        (run plan frame -1
          (lambda (atom environment delta? selected)
            (if (or (eq? atom source-atom) (null? columns)) rows
                (hash-ref index (key terms columns environment selected))))
          (lambda (head row) (set! output (cons row output))))
        ;; Return metadata as well as rows; equality remains outside timing.
        (list (reverse output) plan)))
    (def (old) (lifecycle old-compile old-run old-key))
    (def (new) (lifecycle gerbil-ascent-compile-positive-plan gerbil-ascent-run-positive-plan! gerbil-ascent-index-key))
    (def (check a b)
      (unless (and (equal? a b) (equal? (car a) expected)) (error "compiled metadata or direct join truth differs" scenario))
      (let* ((atom (cadr (vector-ref (cadr b) 1))) (actions (vector-ref atom 1)))
        (unless (and (or (null? columns) (not (eq? actions (vector-ref atom 2))))
                     (andmap (lambda (action column) (eq? action (list-ref actions column))) (vector-ref atom 2) columns))
          (error "selected action identity or spine differs" scenario))))
    (def (sample)
      (let-values (((a x u b y v)
        (if (even? count)
          (let-values (((a x u) (measure old (get 'repetitions))) ((b y v) (measure new (get 'repetitions)))) (values a x u b y v))
          (let-values (((b y v) (measure new (get 'repetitions))) ((a x u) (measure old (get 'repetitions)))) (values a x u b y v)))))
        (check a b)
        (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
        (when (< v u) (set! wins (+ wins 1))))
      (set! count (+ count 1))
      (when (zero? (modulo count 5))
        (displayln "SLOT-PAIRS " scenario " " count "/50") (force-output))
      count)
    (check (old) (new))
    (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= y (+ (* x (get 'allocationRatio)) (get 'allocationOverheadBytes)))
                         (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path (lambda (port)
          (write (list (cons 'scenario scenario) (cons 'baseline (benchmark-fixture-ref contract 'baseline))
            (cons 'passed? pass?) (cons 'asp-receipt api-receipt) (cons 'cpu-wins wins)
            (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
            (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                   " bytes " x " -> " y " wins " wins)
        (force-output) (unless pass? (error "slot projection performance gate failed" scenario))))))
