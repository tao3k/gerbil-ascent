(import (only-in :asp-gerbil-scheme/benchmark-api benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/temporal/lens temporal-lens temporal-source temporal-solve temporal-projection temporal-receipt temporal-status temporal-evidence-verdicts)
        (rename-in (only-in :gerbil-ascent/t/performance/temporal-projection/reference temporal-solve)
          (temporal-solve old-solve)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call)
  (##gc)
  (let* ((before (##process-statistics)) (result (call)) (after (##process-statistics))
         (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9)))
         (cpu (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                 (+ (f64vector-ref before 0) (f64vector-ref before 1)))))
    (unless (>= bytes 0) (error "invalid cumulative allocation counter"))
    (values result bytes cpu)))
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/temporal-projection/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid temporal fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown temporal scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "temporal module mismatch" name))) '("temporal/lens" "t/performance/temporal-projection/reference"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (n (get 'width)) (shape (get 'shape))
         (ids (map (lambda (i) (string->symbol (string-append "event-" (number->string (+ 1000 i))))) (iota n)))
         (root (car ids))
         (edges (case shape
                  ((fan) (append (map (lambda (id) (list root id)) (cdr ids))
                           (map (lambda (a b) (list a b)) (cdr ids) (cddr ids))))
                  (else (map (lambda (a b) (list a b)) ids (cdr ids)))))
         (events (map (lambda (id) (list id 0 0)) ids))
         (lens (temporal-lens 0 'positions (if (eq? shape 'empty) 1 0) 10 0 'cut ids (get 'horizon) (get 'closed)))
         (source (temporal-source 'source 0 'positions events edges))
         (expected-frontier (case shape
           ((chain) (list '(open-cut cut) (list 'horizon-frontier (list (list-ref ids (+ 1 (get 'horizon)))))))
           ((fan) (list '(open-cut cut) (list 'horizon-frontier (reverse (cdr ids)))))
           (else [])))
         (expected-status (if (memq shape '(chain fan)) 'partial 'complete))
         (expected-rows (if (eq? shape 'complete) (map (lambda (id) (list root id)) (cdr ids)) []))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (def (check a b)
      (let ((pa (temporal-projection a)) (pb (temporal-projection b)))
        (unless (and (equal? pa pb) (eq? (car pb) expected-status)
                     (equal? (list-ref pb 4) expected-rows) (equal? (list-ref pb 5) expected-frontier)
                     (eq? (not (not (temporal-receipt a))) (not (not (temporal-receipt b)))))
          (error "temporal projection or direct truth differs" scenario))))
    (def (sample)
      (let-values (((a x u b y v)
        (if (even? count)
          (let-values (((a x u) (measure (lambda () (old-solve lens source root))))
                       ((b y v) (measure (lambda () (temporal-solve lens source root))))) (values a x u b y v))
          (let-values (((b y v) (measure (lambda () (temporal-solve lens source root))))
                       ((a x u) (measure (lambda () (old-solve lens source root))))) (values a x u b y v)))))
        (check a b)
        (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
        (when (< v u) (set! wins (+ wins 1))))
      (set! count (+ count 1))
      (displayln "TEMPORAL-PAIRS " scenario " " count "/50") (force-output) count)
    (let ((a (old-solve lens source root)) (b (temporal-solve lens source root)))
      (check a b)
      (unless (equal? (temporal-evidence-verdicts a) (temporal-evidence-verdicts b)) (error "temporal evidence verdict differs")))
    (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= y (+ x (get 'allocationOverheadBytes)))
                         (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path (lambda (port)
          (write (list (cons 'scenario scenario) (cons 'baseline (benchmark-fixture-ref contract 'baseline))
            (cons 'passed? pass?) (cons 'asp-receipt api-receipt) (cons 'cpu-wins wins)
            (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
            (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                   " bytes " x " -> " y " wins " wins)
        (force-output) (unless pass? (error "temporal performance gate failed" scenario))))))
