(import (only-in :asp-gerbil-scheme/benchmark-api
                 benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :std/list/list delete-duplicates/hash)
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/table/index-sharing
        (rename-in (only-in :gerbil-ascent/t/performance/index-sharing/reference
                           gerbil-ascent-shared-index-build gerbil-ascent-shared-index-extend!
                           gerbil-ascent-shared-index-rows)
                   (gerbil-ascent-shared-index-build old-build)
                   (gerbil-ascent-shared-index-extend! old-extend!)
                   (gerbil-ascent-shared-index-rows old-rows)))
(export main)
;; : (-> (List Number) Number)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
;; : (-> Nat Nat Nat Rows)
(def (source size width offset)
  (map (lambda (n) (map (lambda (column) (if (= (modulo column 7) 0) #f (+ (modulo n 32) column)))
                        (iota width))) (iota size offset)))
;; : (-> IndexBuilder IndexExtender IndexReader Rows Rows Columns Keys Rows)
(def (lifecycle build extend lookup rows batch columns queries)
  (let (index (build rows columns))
    (extend index batch)
    (map (lambda (query) (lookup index (car query) (cdr query))) queries)))
;; : (forall (a) (-> (-> a) Nat (values a Number Number)))
;; : (-> Thunk Repetitions (values Result AllocatedBytes CpuSeconds))
(def (measure call repetitions)
  (##gc)
  (let (before (##process-statistics))
    (let loop ((n repetitions) (result #f))
      (if (zero? n)
        (let* ((after (##process-statistics))
               (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9))))
          (unless (>= bytes 0) (error "invalid cumulative allocation delta"))
          (values result (/ bytes repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- n 1) (call))))))
;; : (-> String Path Path Void)
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/index-sharing/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid shared index fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown shared index scenario" scenario))
  (for-each (lambda (name)
    (unless (and (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                         (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
                 (file-exists? (path-expand (string-append "gerbil-ascent/" name ".o1") library)))
      (error "shared index benchmark module mismatch" name)))
    '("table/index-sharing" "t/performance/index-sharing/reference"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (rows (source (get 'rows) (get 'width) 0))
         (batch (source (get 'batch) (get 'width) (get 'rows)))
         (columns (get 'columns))
         (queries (foldr append []
                    (map (lambda (size)
                           (let (logical (reverse (take columns size)))
                             (map (lambda (row)
                                    (cons logical (map (lambda (column) (list-ref row column)) logical)))
                                  (take rows (min 2 (length rows))))))
                         (delete-duplicates/hash (list 1 (max 1 (quotient (length columns) 2)) (length columns))))))
         (expected (map (lambda (query)
                          (filter (lambda (row)
                                    (equal? (cdr query) (map (lambda (column) (list-ref row column)) (car query))))
                                  (append (reverse batch) rows))) queries))
         (old (lambda () (lifecycle old-build old-extend! old-rows rows batch columns queries)))
         (new (lambda () (lifecycle gerbil-ascent-shared-index-build gerbil-ascent-shared-index-extend!
                                    gerbil-ascent-shared-index-rows rows batch columns queries)))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (def (check a b)
      (unless (and (equal? a expected) (equal? b expected)) (error "independent ordered rows differ" scenario)))
    (def (sample)
      (let (i count)
        (let-values (((a x u b y v)
          (if (even? i)
            (let-values (((a x u) (measure old (get 'repetitions))) ((b y v) (measure new (get 'repetitions)))) (values a x u b y v))
            (let-values (((b y v) (measure new (get 'repetitions))) ((a x u) (measure old (get 'repetitions)))) (values a x u b y v)))))
          (check a b)
          (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
          (when (< v u) (set! wins (+ wins 1))))
        (set! count (+ i 1))
        (when (zero? (modulo count 5))
          (displayln "SHARED-INDEX-PAIRS " scenario " " count "/" (benchmark-fixture-ref contract 'sampleCount)) (force-output))
        i))
    (check (old) (new))
    (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
      (unless (and (= count 50) (eq? (benchmark-fixture-ref api-receipt 'status) 'pass))
        (error "shared index ASP sample admission failed" scenario count api-receipt))
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= y (+ x (get 'allocationOverheadBytes)))
                         (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path (lambda (port)
          (write (list (cons 'scenario scenario) (cons 'baseline (benchmark-fixture-ref contract 'baseline))
            (cons 'passed? pass?) (cons 'asp-receipt api-receipt) (cons 'cpu-wins wins)
            (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
            (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                   " bytes " x " -> " y " wins " wins)
        (force-output) (unless pass? (error "shared index performance gate failed" scenario))))))
