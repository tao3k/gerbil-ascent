diff --git a/t/precedence-cache-reference-fixture.ss b/t/precedence-cache-reference-fixture.ss
new file mode 100644
index 0000000..428ebc8
--- /dev/null
+++ b/t/precedence-cache-reference-fixture.ss
@@ -0,0 +1,31 @@
+;;; -*- Gerbil -*-
+;;; Original cached/cold algorithm from 099b381588360a8a49fd772f666a1a00351366f5.
+(import (only-in ../object object-%precedence-list object-%precedence-list-set!
+                 object-supers invalid-object-summary)
+        (only-in :std/values first-value)
+        (only-in :gerbil/runtime/c3 c4-linearize))
+(export precedence-reference!)
+
+(def (precedence-reference! self (heads '()))
+  ;; Preserve the ordered heads for diagnostics while keeping the cycle guard
+  ;; as private implementation state at this abstraction boundary.
+  (def active (make-hash-table-eq))
+  (for-each (lambda (head) (hash-put! active head #t)) heads)
+  (let compute ((object self) (heads heads))
+    (cond
+     ((object-%precedence-list object))
+     ((hash-key? active object)
+      (error "Circular precedence graph" (member object heads)))
+     (else
+      (hash-put! active object #t)
+      (let (precedence-list
+            (first-value
+             (c4-linearize
+              [object] (object-supers object)
+              get-precedence-list:
+              (lambda (super) (compute super [object . heads]))
+              eq: eq?
+              get-name: invalid-object-summary)))
+        (hash-remove! active object)
+        (object-%precedence-list-set! object precedence-list)
+        precedence-list)))))
diff --git a/t/precedence-cache-benchmark.ss b/t/precedence-cache-benchmark.ss
new file mode 100644
index 0000000..8ac35ee
--- /dev/null
+++ b/t/precedence-cache-benchmark.ss
@@ -0,0 +1,94 @@
+;;; Matched compiled old/new ancestry over the same cached native objects.
+(import (only-in :clan/poo/object .o .mix compute-precedence-list!)
+        (only-in :clan/poo/t/precedence-cache-reference-fixture precedence-reference!))
+
+(def (statistic samples percent)
+  (list-ref (list-sort < samples)
+            (- (quotient (* (length samples) percent) 100) 1)))
+
+(def (timed call repetitions)
+  (let ((started (current-jiffy)) (result #f))
+    (for-each (lambda (_) (set! result (call))) (iota repetitions))
+    (values result (quotient (* (- (current-jiffy) started) 1000000000)
+                             (* repetitions (jiffies-per-second))))))
+
+(def (matched name old new repetitions required-wins regression-percent)
+  (displayln "CASE " name " samples=1000 repetitions=" repetitions)
+  (force-output)
+  (for-each (lambda (_) (unless (equal? (old) (new)) (error "ancestry changed" name)))
+            (iota 20))
+  (let ((old-samples []) (new-samples []) (wins 0))
+    (for-each
+     (lambda (sample)
+       (let-values (((old-result old-ns new-result new-ns)
+                     (if (even? sample)
+                       (let-values (((left left-ns) (timed old repetitions))
+                                    ((right right-ns) (timed new repetitions)))
+                         (values left left-ns right right-ns))
+                       (let-values (((right right-ns) (timed new repetitions))
+                                    ((left left-ns) (timed old repetitions)))
+                         (values left left-ns right right-ns)))))
+         (unless (equal? old-result new-result) (error "cached result changed" name))
+         (set! old-samples (cons old-ns old-samples))
+         (set! new-samples (cons new-ns new-samples))
+         (when (< new-ns old-ns) (set! wins (+ wins 1))))
+       (when (zero? (modulo (+ sample 1) 100))
+         (displayln "PROGRESS " name " " (+ sample 1) "/1000")
+         (force-output)))
+     (iota 1000))
+    (let ((old-p50 (statistic old-samples 50)) (new-p50 (statistic new-samples 50)))
+      (displayln "RESULT " name " old-p50-ns=" old-p50 " new-p50-ns=" new-p50
+                 " paired-wins=" wins "/1000")
+      (force-output)
+      (list (cons 'name name) (cons 'repetitions repetitions)
+            (cons 'required-wins required-wins) (cons 'regression-percent regression-percent)
+            (cons 'old-p50-ns old-p50) (cons 'new-p50-ns new-p50)
+            (cons 'old-p95-ns (statistic old-samples 95))
+            (cons 'new-p95-ns (statistic new-samples 95))
+            (cons 'paired-wins wins)
+            (cons 'old-samples-ns (reverse old-samples))
+            (cons 'new-samples-ns (reverse new-samples))))))
+
+(def (diamond)
+  (let* ((root (.o)) (left (.o (:: @ root))) (right (.o (:: @ root))))
+    (.mix left right)))
+
+(def (hot name object)
+  (let (cached (precedence-reference! object))
+    (matched name
+             (lambda ()
+               (let (actual (precedence-reference! object))
+                 (unless (eq? actual cached) (error "old cache identity changed"))
+                 (length actual)))
+             (lambda ()
+               (let (actual (compute-precedence-list! object))
+                 (unless (eq? actual cached) (error "new cache identity changed"))
+                 (length actual)))
+             128 900 0)))
+
+(let (receipts
+      (list (hot 'cached-root (.o)) (hot 'cached-diamond (diamond))
+            ;; A cold call performs an extra cache read. Its fixed 5% median
+            ;; allowance is declared before measurement; the hot gates have
+            ;; no regression allowance and require 900 strictly faster pairs.
+            (matched 'cold-diamond
+                     (lambda () (length (precedence-reference! (diamond))))
+                     (lambda () (length (compute-precedence-list! (diamond))))
+                     32 0 5)))
+  (call-with-output-file (getenv "POO_PRECEDENCE_RECEIPT")
+    (lambda (port)
+      (write (list (cons 'baseline-commit '099b381)
+                   (cons 'sample-count 1000) (cons 'cases receipts)) port)
+      (newline port)))
+  (for-each
+   (lambda (receipt)
+     (unless (and (>= (cdr (assq 'paired-wins receipt))
+                      (cdr (assq 'required-wins receipt)))
+                  (<= (* (cdr (assq 'new-p50-ns receipt)) 100)
+                      (* (cdr (assq 'old-p50-ns receipt))
+                         (+ 100 (cdr (assq 'regression-percent receipt))))))
+       (error "precedence benchmark failed the matched gate" (cdr (assq 'name receipt)))))
+   receipts))
+(displayln "OK")
+(force-output)
+(exit 0)
