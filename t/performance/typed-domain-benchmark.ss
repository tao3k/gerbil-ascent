(import (only-in :asp-gerbil-scheme/benchmark-api benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/program/scheme-language relational-admit relational-solve relational-query-name)
        (only-in :gerbil-ascent/program/higher-order relational-relation-type relational-typed-source relational-typed-join relational-typed-project relational-typed-compile)
        (rename-in (only-in :gerbil-ascent/t/performance/typed-domain/reference relational-relation-type relational-typed-source relational-typed-join relational-typed-project relational-typed-compile)
          (relational-relation-type old-type) (relational-typed-source old-source) (relational-typed-join old-join)
          (relational-typed-project old-project) (relational-typed-compile old-compile)))
(export main)
(def (input make-type source join project width stages permuted)
  (let* ((domain (iota width)) (rows (list (list (- width 1)) (list (- width 2))))
         (seed (source 'seed (make-type 1 domain) rows)))
    (let loop ((i 0) (term seed))
      (if (= i stages) term
        (let* ((atoms (if (and permuted (even? i)) (reverse domain) domain))
               (next (source (string->symbol (string-append "source-" (number->string i))) (make-type 1 atoms) rows)))
          (loop (+ i 1) (project (join term next 0 0) '(0))))))))
(def (compile-result compile term)
  (let-values (((program output) (compile term 64 4096 4096))) (cons program output)))
(def (projection result)
  (map (lambda (relation) (list (.ref relation 'arity) (.ref relation 'rows)
                               (vector-ref (.ref relation 'checked-domain) 1)))
       (.ref (car result) 'relations)))
(def (check a b expected)
  (unless (equal? (projection a) (projection b)) (error "typed compiled domains or source rows differ"))
  (for-each (lambda (result)
    (let (rows (relational-query-name (relational-solve (relational-admit (car result))) (cdr result)))
      (unless (and (= (length rows) (length expected))
                   (andmap (lambda (row) (and (member row rows) #t)) expected))
        (error "typed compiled native truth differs" rows expected)))) (list a b)))
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call)
  (##gc)
  (let* ((before (##process-statistics)) (result (call)) (after (##process-statistics))
         (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9)))
         (cpu (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                 (+ (f64vector-ref before 0) (f64vector-ref before 1)))))
    (unless (>= bytes 0) (error "invalid cumulative allocation counter"))
    (values result bytes cpu)))
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/typed-domain/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid typed domain fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown typed domain scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                   (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "typed domain module mismatch" name))) '("program/higher-order" "t/performance/typed-domain/reference"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (let* ((width (get 'width)) (stages (get 'stages)) (permuted (get 'permuted))
           (a-term (input old-type old-source old-join old-project width stages permuted))
           (b-term (input relational-relation-type relational-typed-source relational-typed-join relational-typed-project width stages permuted))
           (expected (list (list (- width 1)) (list (- width 2)))))
        (def (old-call) (compile-result old-compile a-term))
        (def (new-call) (compile-result relational-typed-compile b-term))
        (def (sample)
          (let-values (((a x u b y v)
            (if (even? count)
              (let-values (((a x u) (measure old-call)) ((b y v) (measure new-call))) (values a x u b y v))
              (let-values (((b y v) (measure new-call)) ((a x u) (measure old-call))) (values a x u b y v)))))
            (check a b expected)
            (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
            (when (< v u) (set! wins (+ wins 1))))
          (set! count (+ count 1)) (displayln "TYPED-PAIRS " scenario " " count "/50") (force-output) count)
        (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
          (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
                 (pass? (and (<= y (+ x (get 'allocationOverheadBytes)))
                             (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                             (>= wins (get 'minimumCpuWins)))))
            (call-with-output-file receipt-path (lambda (port)
              (write (list (cons 'scenario scenario) (cons 'passed? pass?) (cons 'asp-receipt api-receipt)
                (cons 'cpu-wins wins) (cons 'old-bytes x) (cons 'new-bytes y)
                (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
                (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
            (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                       " bytes " x " -> " y " wins " wins)
            (force-output) (unless pass? (error "typed domain performance gate failed" scenario)))))))
