(import :std/test :clan/poo/object :gerbil-ascent/program/objects
        :gerbil-ascent/t/performance/round-workspace/fixture
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/round-workspace/reference-evaluate old-)
        :gerbil-ascent/program/syntax)
(export ascent-round-workspace-test)
(def (session maker program) (maker program #t))
(def (run engine) ((.ref engine '.run)))
(def (rows result name) ((.ref result 'rows-of) name))
(def ascent-round-workspace-test
  (test-suite "Sparse native round publication"
    (test-case "six full engines preserve independent result truth"
      (for-each (lambda (scenario)
                  (let ((old (round-prepare #t scenario)) (new (round-prepare #f scenario)))
                    (check-equal? (round-consume old scenario #t) (round-expected old scenario))
                    (check-equal? (round-consume new scenario #f) (round-expected new scenario))))
                '(wide chain cold indexed small serial)))
    (test-case "every timeout cut preserves frontier and earlier snapshots"
      (let* ((program (round-program 'resume))
             (old (session old-gerbil-ascent-make-engine program))
             (new (session gerbil-ascent-make-engine program))
             (first ((.ref new '.run-timeout) 0))
             (saved (rows first 'counter)))
        (check-equal? (round-project first) (round-project ((.ref old '.run-timeout) 0)))
        (for-each (lambda (_)
                    (check-equal? (round-project ((.ref new '.run-timeout) 0))
                                  (round-project ((.ref old '.run-timeout) 0)))) (iota 20))
        (check-equal? (rows first 'counter) saved)
        (check-equal? (round-project (run new)) (round-project (run old)))
        (check-equal? (eq? (run new) (run new)) #t)))
    (test-case "retained append seeds newly nonempty high slots and duplicate no-op"
      (let* ((program (ascent
                       (relation unused (x)) (relation output (x)) (relation source (x))
                       ((output x) <-- (source x)) (bounds 100 100 1000)))
             (old (session old-gerbil-ascent-make-engine program))
             (new (session gerbil-ascent-make-engine program))
             (initial (run new)))
        (run old)
        (for-each (lambda (engine) ((.ref engine '.append-source!) 'source '(7))) (list old new))
        (check-equal? (round-project (run new)) (round-project (run old)))
        (check-equal? (rows (run new) 'output) '((7)))
        (check-equal? (rows initial 'output) [])
        (let (before (run new))
          ((.ref new '.append-source!) 'source '(7))
          (check-equal? (eq? before (run new)) #t))))
    (test-case "stratum handoff clears exhausted deltas and seeds negative reads"
      (let* ((program (ascent
                       (relation source (x) '((1) (2))) (relation blocked (x) '((2)))
                       (relation unused (x)) (relation positive (x)) (relation output (x))
                       ((positive x) <-- (source x) (if (x) (> x 0)))
                       ((output x) <-- (positive x) (not (blocked x))) (bounds 100 100 1000)))
             (old (session old-gerbil-ascent-make-engine program))
             (new (session gerbil-ascent-make-engine program)))
        (check-equal? (round-project (run new)) (round-project (run old)))
        (check-equal? (rows (run new) 'output) '((1)))
        (for-each (lambda (engine) ((.ref engine '.append-source!) 'source '(3))) (list old new))
        (check-equal? (round-project (run new)) (round-project (run old)))))
    (test-case "multihead writes preserve callback multiplicity and declaration order"
      (def (observe maker)
        (let ((trace []) (x (gerbil-ascent-variable 'x)))
          (def (atom name) (gerbil-ascent-atom name (list x)))
          (def (guard tag)
            (gerbil-ascent-guard '(x) (lambda (v) (set! trace (cons (list tag v) trace)) #t)))
          (let* ((program (gerbil-ascent-program
                          (list (gerbil-ascent-relation 'source 1 '((1) (2)))
                                (gerbil-ascent-relation 'unused-low 1 [])
                                (gerbil-ascent-relation 'low 1 [])
                                (gerbil-ascent-relation 'unused-high 1 [])
                                (gerbil-ascent-relation 'high 1 []))
                          (list (gerbil-ascent-rule (list (atom 'high) (atom 'low))
                                  (list (atom 'source) (guard 'seed)))
                                (gerbil-ascent-rule (list (atom 'low))
                                  (list (atom 'high) (guard 'copy)))) 10 10 20))
                 (engine (session maker program)) (result (run engine)))
            (list (round-project result) (reverse trace)))))
      (check-equal? (observe gerbil-ascent-make-engine) (observe old-gerbil-ascent-make-engine)))
    (test-case "callback rejection drops candidate workspace before retry"
      (let ((reject? #t) (x (gerbil-ascent-variable 'x)))
        (let* ((program (gerbil-ascent-program
                         (list (gerbil-ascent-relation 'source 1 '((1) (2)))
                               (gerbil-ascent-relation 'unused 1 [])
                               (gerbil-ascent-relation 'output 1 []))
                         (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'output (list x)))
                                 (list (gerbil-ascent-atom 'source (list x))
                                       (gerbil-ascent-guard '(x)
                                         (lambda (v) (when (and reject? (= v 2)) (error "rejected")) #t)))))
                         10 10 20))
               (new (session gerbil-ascent-make-engine program)))
          (check-exception (run new) true)
          (set! reject? #f)
          (check-equal? (round-project (run new))
                        (round-project (run (session old-gerbil-ascent-make-engine program)))))))))
