(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/table/provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-evaluate-program)
        (rename-in (only-in :gerbil-ascent/t/performance/index-entry/reference-evaluate
                           gerbil-ascent-evaluate-program)
                   (gerbil-ascent-evaluate-program old-evaluate))
        :gerbil-ascent/t/performance/index-entry/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "INDEX-ENTRY-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass? (if (eq? mode 'observe) #t (if (eq? mode 'large)
                  (and (<= (median bb) (+ (median ab) 256))
                       (<= (median bc) (* 0.85 (median ac))) (>= wins 35))
                  (and (<= (median bb) (+ (median ab) 8192))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))))
      ;; Gates are fixed before sampling: wide index kernels require
      ;; 15% CPU with 35 wins and <=256 bytes; controls <=8 KiB and <=5%+20 us.
      (list (cons 'name name) (cons 'passed? pass?)
            (cons 'measurement-mode mode)
            (cons 'performance-admitted? (and (not (eq? mode 'observe)) pass?)) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "index entry benchmark requires symmetric native modules" name))))
   '("program/index" "program/evaluate" "t/performance/index-entry/reference"
     "t/performance/index-entry/reference-evaluate" "t/performance/index-entry/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((width (if (member scenario '("scalar" "solve-small")) 1 64))
         (rows (map (lambda (n) (map (lambda (c) (+ n c)) (iota width))) (iota 128)))
         (atom (index-entry-atom (iota width) (iota width)))
         (mode (if (member scenario '("all" "delta" "advance")) 'large 'control))
         (result
          (cond
           ((member scenario '("all" "delta" "scalar"))
            (let* ((a (index-entry-harness #t rows gerbil-ascent-hash-index-provider))
                   (b (index-entry-harness #f rows gerbil-ascent-hash-index-provider))
                   (delta? (string=? scenario "delta"))
                   (old (lambda () ((vector-ref a 0) atom [] delta? #f)))
                   (new (lambda () ((vector-ref b 0) atom [] delta? #f))))
              (paired scenario old new
                      (lambda (a b) (unless (and (equal? a (list (car rows))) (equal? b a)) (error "warm lookup parity")))
                      512 mode)))
           ((string=? scenario "advance")
            (let* ((a (index-entry-harness #t rows gerbil-ascent-hash-index-provider))
                   (b (index-entry-harness #f rows gerbil-ascent-hash-index-provider)))
              (def (step h)
                ((vector-ref h 1) 0 (list (car rows)))
                (vector-set! (vector-ref h 6) 0 (+ 1 (vector-ref (vector-ref h 6) 0)))
                ((vector-ref h 0) atom [] #f #f))
              ((vector-ref a 0) atom [] #f #f) ((vector-ref b 0) atom [] #f #f)
              (paired scenario (lambda () (step a)) (lambda () (step b))
                      (lambda (a b) (unless (and (equal? a b) (equal? (car a) (car rows))) (error "advanced entry parity")))
                      10 mode)))
           ((string=? scenario "cold")
            (paired scenario
                    (lambda () ((vector-ref (index-entry-harness #t rows gerbil-ascent-hash-index-provider) 0) atom [] #f #f))
                    (lambda () ((vector-ref (index-entry-harness #f rows gerbil-ascent-hash-index-provider) 0) atom [] #f #f))
                    (lambda (a b) (unless (and (equal? a b) (equal? a (list (car rows)))) (error "cold index parity"))) 10 mode))
           ((string=? scenario "solve-sharing")
            (let* ((program (index-sharing-program 40)) (expected (map list (iota 40))))
              (paired scenario (lambda () (old-evaluate program))
                      (lambda () (gerbil-ascent-evaluate-program program))
                      (lambda (a b)
                        (for-each (lambda (result)
                                    (unless (equal? (list-sort (lambda (a b) (< (car a) (car b)))
                                                    (index-entry-result-rows result)) expected)
                                      (error "shared index independent truth mismatch"))) (list a b)))
                      1 'observe)))
           ((member scenario '("solve-wide" "solve-small"))
            (let* ((program (index-entry-program 128 width 4)) (expected (map list (iota 128))))
              (paired scenario (lambda () (old-evaluate program)) (lambda () (gerbil-ascent-evaluate-program program))
                      (lambda (a b)
                        (unless (and (equal? (index-entry-result-rows a) (index-entry-result-rows b))
                                     (equal? (list-sort (lambda (a b) (< (car a) (car b))) (index-entry-result-rows b)) expected))
                          (error "complete indexed solve parity"))) 10 mode)))
           (else (error "unknown index entry scenario" scenario)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline 'a890b9919504f1daadb9990aa501797777a00856)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "index entry CPU/allocation gate failed" scenario)))
  (displayln "OK") (force-output))
