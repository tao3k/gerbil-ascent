import Std

/-! Checked declaration permission and metadata-erasure laws. Scheme decoding,
macro expansion and mutable Session correspondence are separate obligations. -/
namespace Ascent.DslDeclarations
inductive Role where
  | input | derived | mixed
  deriving DecidableEq, Repr

def acceptsSource : Role → Bool
  | .input | .mixed => true
  | .derived => false
def acceptsHead : Role → Bool
  | .derived | .mixed => true
  | .input => false
def updateAllowed (role : Role) (handle requested : Bool) : Bool :=
  requested && handle && acceptsSource role

theorem derived_update_refused (handle requested : Bool) :
    updateAllowed .derived handle requested = false := by simp [updateAllowed, acceptsSource]
theorem absent_handle_refuses (role : Role) (requested : Bool) :
    updateAllowed role false requested = false := by simp [updateAllowed]
theorem input_head_refused : acceptsHead .input = false := rfl
theorem mixed_permissions (handle requested : Bool) :
    updateAllowed .mixed handle requested = (requested && handle) ∧
    acceptsHead .mixed = true := by simp [updateAllowed, acceptsSource, acceptsHead]

structure Declaration (Key : Type) where
  key : Key
  role : Role
def sourceHandles (declarations : List (Declaration Key)) : List Key :=
  (declarations.filter fun d => acceptsSource d.role).map Declaration.key
theorem source_handles_exact (declarations : List (Declaration Key)) (key : Key) :
    key ∈ sourceHandles declarations ↔
      ∃ declaration ∈ declarations, acceptsSource declaration.role = true ∧ declaration.key = key := by
  simp only [sourceHandles, List.mem_map, List.mem_filter]
  constructor
  · rintro ⟨d, ⟨hd, hs⟩, hk⟩
    exact ⟨d, hd, hs, hk⟩
  · rintro ⟨d, hd, hs, hk⟩
    exact ⟨d, ⟨hd, hs⟩, hk⟩
theorem composition_preserves_handles (left right : List (Declaration Key)) :
    sourceHandles (left ++ right) = sourceHandles left ++ sourceHandles right := by
  simp [sourceHandles, List.filter_append]

def inDomain [DecidableEq α] (domain : List α) (value : α) : Bool := domain.contains value
theorem domain_admission_exact [DecidableEq α] (domain : List α) (value : α) :
    inDomain domain value = true ↔ value ∈ domain := by simp [inDomain]

structure Located (Origin α : Type) where
  value : α
  origin : Origin
def erase (term : Located Origin α) : α := term.value
theorem origin_does_not_change_meaning (meaning : α → β) (value : α) (a b : Origin) :
    meaning (erase ⟨value, a⟩) = meaning (erase ⟨value, b⟩) := rfl

/-! The production permission kernel is emitted from the same finite decision
rows proved here. Host symbol identity, macro decoding and mutable snapshots
remain explicit external premises; this is not a proof of the entire DSL. -/
def roles : List Role := [.input, .derived, .mixed]
def spelling : Role → String
  | .input => "input"
  | .derived => "derived"
  | .mixed => "mixed"
def decode : String → Option Role
  | "input" => some .input
  | "derived" => some .derived
  | "mixed" => some .mixed
  | _ => none

theorem decode_spelling (role : Role) : decode (spelling role) = some role := by
  cases role <;> rfl

def compileCases (decision : Role → Bool) : List (String × Bool) :=
  roles.map fun role => (spelling role, decision role)
def runCases (code : List (String × Bool)) (symbol : String) : Bool :=
  ((code.find? fun entry => entry.1 == symbol).map Prod.snd).getD false

theorem compile_cases_exact (decision : Role → Bool) (role : Role) :
    runCases (compileCases decision) (spelling role) = decision role := by
  cases role <;> simp [runCases, compileCases, roles, spelling]

def emitCases (name : String) (decision : Role → Bool) : String :=
  ";;; Boundary: the caller admits role symbols before invoking this pure kernel.\n" ++
  ";;; Invariant: permissions grant no source handle and publish no mutable state.\n" ++
  s!";; : (-> RelationRole Boolean)\n(def ({name} role)\n  (case role\n" ++
  String.join ((compileCases decision).map fun entry =>
    s!"    (({entry.1}) " ++ (if entry.2 then "#t" else "#f") ++ ")\n") ++
  "    (else #f)))\n"

def schemeSource : String :=
  ";;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later\n" ++
  ";;; Generated by DslDeclarations.lean; finite permissions only.\n" ++
  "(export relational-role-source? relational-role-head?)\n" ++
  emitCases "relational-role-source?" acceptsSource ++
  emitCases "relational-role-head?" acceptsHead

def quintDeclarations : String :=
  "  // Same finite role cases as the production permission kernel.\n" ++
  "  pure def declaration_source(role: str): bool =\n    Mutation == \"roleSource\" or " ++
  String.intercalate " or " ((compileCases acceptsSource).filterMap fun entry =>
    if entry.2 then some ("role == \"" ++ entry.1 ++ "\"") else none) ++ "\n" ++
  "  pure def declaration_head(role: str): bool =\n    Mutation == \"roleHead\" or " ++
  String.intercalate " or " ((compileCases acceptsHead).filterMap fun entry =>
    if entry.2 then some ("role == \"" ++ entry.1 ++ "\"") else none) ++ "\n"
end Ascent.DslDeclarations
