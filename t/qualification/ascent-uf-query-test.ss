(import :std/test :std/list/list-builder :gerbil-ascent/core/relation-view)
(export ascent-uf-query-test)
(def (part-rows visit view columns key)
  (with-list-builder (emit!)
    (visit view columns key (lambda (prefix left right) (emit! (append prefix (list left right)))))))
(def (check-consumers view columns key)
  (let* ((full (gerbil-ascent-view-rows view))
         (expected (filter (lambda (row)
                     (andmap (lambda (column value) (equal? (list-ref row column) value)) columns key)) full)))
    (check-equal? (gerbil-ascent-view-rows view columns key) expected)
    (check-equal? (with-list-builder (emit!)
                    (gerbil-ascent-for-each-row emit! (gerbil-ascent-view-select view columns key))) expected)
    (for-each (lambda (visit) (check-equal? (part-rows visit view columns key) expected))
      (list gerbil-ascent-visit-view-parts! gerbil-ascent-visit-admitted-view-parts!))))
(def ascent-uf-query-test
  (test-suite "Invocation-owned grouped and composite UF queries"
    (test-case "partial grouped probes preserve stored singletons and unbound axes"
      (let* ((tokens (map (lambda (_) (list 'stored)) (iota 65)))
             (blocks (map (lambda (group token)
                            (let (axis (list #f token 2 3 4 5 6 7 8 9))
                              (make-rectangle (list group) axis axis)))
                       (iota 65) tokens))
             (view (gerbil-ascent-rectangle-view
                     (append blocks (list (list-ref blocks 7))) 6600 1320 #t)))
        (for-each (lambda (value)
                    (check-consumers view '(0 1 0) (list 7 value 7))
                    (check-consumers view '(0 2 0) (list 7 value 7)))
          (list #f (list 'stored) 3 9 'absent))
        (let (rows (gerbil-ascent-view-rows view '(0 1 0) (list 7 (list 'stored) 7)))
          (check (length rows) => 20)
          (for-each (lambda (row) (check (eq? (cadr row) (list-ref tokens 7)) => #t)) rows)
          (set-car! (cdar rows) 'detached)
          (check-consumers view '(0 1 0) (list 7 (list 'stored) 7)))
        (gerbil-ascent-visit-view-parts! view '(0 1 0) '(7 3 7)
          (lambda (_prefix _left _right)
            (check-equal? (length (gerbil-ascent-view-rows view '(0 2 0) '(8 9 8))) 10)))
        (check-consumers view '(0 1 0) '(7 3 8))
        (check-exception (gerbil-ascent-view-rows view '(0 1 0 3) '(7 3 8 0)) exception?)))
    (test-case "complete compact keys preserve duplicate owners and stored representatives"
      (let* ((first (list 'stored)) (second (list 'stored))
             (blocks (list (make-rectangle '(same) (list #f first 2) '(#f 9))
                           (make-rectangle '(#f) '(2 3) '(#f 9))
                           (make-rectangle (list 'same) (list second 2) '(#f 9))
                           (make-rectangle '(empty) [] '(9))))
             (view (gerbil-ascent-rectangle-view blocks 14 15 #t)))
        (for-each (lambda (row) (check-consumers view '(0 1 2) row))
          (append (gerbil-ascent-view-rows view)
                  (list (list 'same (list 'stored) 9) '(missing 2 9) '(empty 2 9)
                        '(same 99 9) '(same 2 99))))
        (let (rows (gerbil-ascent-view-rows view '(0 1 2) (list 'same (list 'stored) 9)))
          (check (eq? (cadar rows) first) => #t)
          (check (eq? (cadadr rows) second) => #t)
          (set-car! (cdar rows) 'detached)
          (check-consumers view '(0 1 2) (list 'same (list 'stored) 9)))
        (gerbil-ascent-visit-view-parts! view '(0 1 2) '(same #f 9)
          (lambda (_prefix _left _right) (check-consumers view '(0 1 2) '(#f 2 #f))))))
    (test-case "complete compact key admission rejects malformed keys before an absent group"
      (let (view (gerbil-ascent-rectangle-view
                  (map (lambda (group) (make-rectangle (list group) '(#f 2) '(3 4)))
                    '(a b c)) 12 12 #t))
        (for-each (lambda (key)
          (check-exception (gerbil-ascent-view-rows view '(0 1 2) key) exception?))
          (list [] '(missing) '(missing 2) '(missing 2 3 extra) '(missing 2 . 3)))
        (check-consumers view '(0 1 2) '(missing 2 3))))
    (test-case "compact layouts retain interleaved prefix owners and all range obligations"
      (let* ((p '(same)) (q (list 'same)) (token (list 'stored))
             (a (list #f token 2)) (b '(2 3))
             (view (gerbil-ascent-rectangle-view
                     (list (make-rectangle p a a) (make-rectangle q b b)
                           (make-rectangle p a a) (make-rectangle '(#f) b b)) 26 20 #t)))
        (for-each (lambda (columns key) (check-consumers view columns key))
          '((2 0 1 2 0) (1 2 1 2 1 2 1 2) (0 1 0) (0 0) (1 2 1) (0 1 0) (2 0 1 0))
          (list '(2 same 2 2 same) '(2 2 2 2 2 2 2 2)
                (list 'same #f 'same) '(same other) '(2 2 3) '(missing 2 missing) '(2 #f 2 #f)))
        (for-each (lambda (visit)
          (check-exception (visit view '(1 1 3) '(2 3 2) void) exception?))
          (list gerbil-ascent-visit-view-parts! gerbil-ascent-visit-admitted-view-parts!))
        (check-exception (gerbil-ascent-view-rows view '(1 1 3) '(2 3 2)) exception?)
        (let (binary (gerbil-ascent-rectangle-view
                       (list (make-rectangle [] a a) (make-rectangle [] b b)
                             (make-rectangle [] a a)) 22 16 #t))
          (for-each (lambda (columns key) (check-consumers binary columns key))
            '((1 0 1 0) (0 1 0) (0 1)) '((2 2 2 2) (#f 2 #f) (99 2)))
          (check-exception (gerbil-ascent-view-rows binary '(0 0 2) '(2 3 2)) exception?))))
    (test-case "an omitted single-owner plan preserves legal grouped query results"
      (let (view (gerbil-ascent-rectangle-view
                   (map (lambda (group)
                     (let (axis (if (= group 7) '(#f 2 3) '(2 3)))
                       (make-rectangle (list group) axis axis))) (iota 8)) 37 34 #t))
        (for-each (lambda (columns key) (check-consumers view columns key))
          '((1 2) (2 1 2 1) (1 2 1 2 1 2) (1 2) (0 1 0))
          '((#f 2) (2 #f 2 #f) (#f 2 #f 2 #f 2) (absent 2) (7 #f 7)))))
    (test-case "group routing borrows the narrowest covered bucket or ordered axis plan"
      (for-each (lambda (self?)
        (let* ((blocks (apply append (map (lambda (group)
                         (map (lambda (component)
                           (let (axis (list (* component 2) (+ (* component 2) 1)))
                             (make-rectangle (list group) axis
                               (if self? axis (map values axis))))) (iota 8))) (iota 3))))
               (view (gerbil-ascent-rectangle-view blocks 96 96 #t)))
          ;; Each prefix owns eight descriptors, each endpoint only three.
          ;; Self axes borrow a plan; distinct axes exercise uncached routing.
          (for-each (lambda (columns key) (check-consumers view columns key))
            '((2 0 1 0 2) (0 1 0) (0 2 0) (0 1 2) (0 1 1))
            '((7 1 6 1 7) (1 6 1) (1 7 1) (1 6 9) (1 6 7))))) '(#t #f))
      (let* ((blocks (map (lambda (component)
                           (let (axis (list (* component 2) (+ (* component 2) 1)))
                             (make-rectangle '(same) axis axis))) (iota 8)))
             (view (gerbil-ascent-rectangle-view blocks 32 32 #t)))
        ;; A unique endpoint narrows a shared prefix to one borrowed bucket.
        (check-consumers view '(2 0 1 0 2) '(7 same 6 same 7))
        (check-consumers view '(0 1 0) '(same 6 same))))
    (test-case "complete large points retain owner identity, empty axes and nested reads"
      (let* ((tokens (map (lambda (_) (list 'token)) (iota 8)))
             (view (gerbil-ascent-rectangle-view
                    (map (lambda (group token)
                           (make-rectangle (list group 'scope)
                             (if (= group 4) [] (list #f token 2))
                             (if (= group 6) [] (list token 9)))) (iota 8) tokens)
                    36 35 #t)))
        (for-each (lambda (group)
          (let (key (list group 'scope (list 'token) 9))
            (check-consumers view '(0 1 2 3) key)
            (check-consumers view '(3 2 1 0) (reverse key))
            (unless (memq group '(4 6))
              (check (eq? (list-ref (car (gerbil-ascent-view-rows view '(0 1 2 3) key)) 2)
                          (list-ref tokens group)) => #t)))) (iota 8))
        (check-consumers view '(0 1 2 3) '(99 scope #f 9))
        (gerbil-ascent-visit-view-parts! view '(0 1 2 3) '(3 scope #f 9)
          (lambda (_prefix _left _right) (check-consumers view '(0 1 2 3) '(7 scope #f 9))))))
    (test-case "tiny owner associations preserve shared and equal distinct axes"
      (for-each (lambda (shared?)
        (let* ((a (list (list 'token) #f 2))
               (b (if shared? a (list (list 'token) #f 2)))
               (view (gerbil-ascent-rectangle-view
                      (list (make-rectangle '(0) a a) (make-rectangle '(1) b b)) 18 12 #t)))
          (for-each (lambda (columns key) (check-consumers view columns key))
            '((0 1 2) (1) (2) (1 2) (2 1 2) ())
            (list (list 1 (list 'token) #f) (list (list 'token)) '(#f)
                  (list (list 'token) #f) (list #f (list 'token) #f) []))
          (check (eq? (cadar (gerbil-ascent-view-rows view '(0 1 2) (list 1 (list 'token) #f)))
                      (car b)) => #t))) '(#t #f)))
    (test-case "complete tiny keys borrow canonical values and retain checked fallbacks"
      (let* ((token (list 'token)) (axis (list #f token 2))
             (view (gerbil-ascent-rectangle-view (list (make-rectangle '(7) axis axis)) 9 6 #t)))
        (for-each (lambda (columns key) (check-consumers view columns key))
          '((0 1 2) (0 1 2) (0 1 2) (2 0 1) (0 1 2 1))
          (list '(7 #f 2) (list 7 (list 'token) 2) '(99 #f 2)
                '(2 7 #f) '(7 #f 2 2)))
        (let (rows (gerbil-ascent-view-rows view '(0 1 2) (list 7 (list 'token) 2)))
          (check (eq? (cadar rows) token) => #t))
        (gerbil-ascent-visit-view-parts! view '(0 1 2) '(7 #f 2)
          (lambda (_prefix _left _right) (check-consumers view '(0 1 2) '(7 2 #f))))))
    (test-case "frozen ordinal intersection skips unrelated owners and keeps stored values"
      (let* ((token (list 'token))
             (view (gerbil-ascent-rectangle-view
                    (map (lambda (group)
                           (let (axis (case group
                                        ((0 3 6) (list token #f 2))
                                        ((1 4) (list token 1))
                                        (else '(#f 2 3))))
                             (make-rectangle (list group) axis axis))) (iota 8))
                    62 44 #t)))
        (for-each (lambda (columns key) (check-consumers view columns key))
          '((1 2) (2 1 2 1) (0 1 2) (1 2 1) (1 2))
          (list (list (list 'token) 2) (list 2 (list 'token) 2 (list 'token))
                (list 3 (list 'token) 2) (list token 2 'missing) '(#f 2)))
        (check-exception (gerbil-ascent-view-rows view '(1 1 3) '(0 99 1)) exception?)
        (let (rows (gerbil-ascent-view-rows view '(1 2) (list (list 'token) 2)))
          (check-equal? (map car rows) '(0 3 6))
          (check (eq? (cadar rows) token) => #t)
          (gerbil-ascent-visit-view-parts! view '(1 2) (list token 2)
            (lambda (_prefix _left _right)
              (check-consumers view '(2 1) (list #f token)))))))
    (test-case "group scopes, condition order, repeats and false bindings share one contract"
      (for-each (lambda (indexed?)
        (let (view (gerbil-ascent-rectangle-view
                    (map (lambda (group)
                           (let (axis '(#f 0 1 2 3))
                             (make-rectangle (list group) (map values axis) (map values axis)))) '(0 7 9))
                    75 30 indexed?))
          (for-each (lambda (columns key) (check-consumers view columns key))
            '((0 1 2) (2 0 1 0 2) (1 2) (1 2 1) (0 0) (1 2 1) () (0 1))
            '((7 #f 2) (2 7 #f 7 2) (#f 2) (1 2 1) (7 9) (1 2 3) () (99 1)))))
        '(#t #f)))
    (test-case "mixed schemas and arbitrary prefixes keep checked fallback"
      (let (view (gerbil-ascent-rectangle-view
                  (list (make-rectangle [] '(0 1) '(2 3))
                        (make-rectangle '(scope label) '(0 1) '(2 3))) 8 8 #t))
        (for-each (lambda (columns key) (check-consumers view columns key))
          '((1 0 1) (0 0) ()) '((3 1 3) (missing missing) ()))
        ;; Mixed-width routing may select only the wider descriptors. A tiny
        ;; scan cannot force checked admission on an unrelated shorter row.
        (check-equal? (gerbil-ascent-view-rows view '(3) '(3))
          '((scope label 0 3) (scope label 1 3)))))
    (test-case "range admission is not bypassed by absent or conflicting constraints"
      (let (view (gerbil-ascent-rectangle-view (list (make-rectangle '(7) '(1 2) '(3 4))) 4 4 #t))
        (for-each (lambda (columns key)
                    (check-exception (gerbil-ascent-view-rows view columns key) exception?)
                    (check-exception (gerbil-ascent-visit-view-parts! view columns key void) exception?))
          '((0 3) (0 0 3) (-1) (0)) '((999 1) (7 9 1) (1) ()))))
    (test-case "streamed admission checks complete malformed tails before publication"
      (let* ((axis '(#f 1 2))
             (view (gerbil-ascent-rectangle-view
                     (map (lambda (group) (let (members (map values axis))
                       (make-rectangle (list group) members members))) '(0 7 9)) 27 18 #t)))
        (for-each (lambda (columns key)
          (for-each (lambda (visit)
            (let (calls 0)
              (check-exception (visit view columns key
                (lambda (_prefix _left _right) (set! calls (+ calls 1)))) exception?)
              (check-equal? calls 0)))
            (list gerbil-ascent-visit-view-parts!))
          (check-exception (gerbil-ascent-view-rows view columns key) exception?)
          (check-exception (gerbil-ascent-for-each-row void
                             (gerbil-ascent-view-select view columns key)) exception?))
          '((1 1 3) (1 1 -1) (1 1 nope) (1 1 0) (1 1) (3 1 nope) (1 2 . 0))
          '((1 2 0) (1 2 0) (1 2 0) (1 2) (1 2 0) (0 1 0) (1 2 0)))
        (check-consumers view '(2 0 1 2 1) '(#f 7 #f #f #f))
        (check-consumers view '(1 1) '(#f 1))))
    (test-case "point intersections preserve sparse ordinals stored values and callback boundaries"
      (let* ((lefts (map (lambda (_) (list 'left)) (iota 16)))
             (rights (map (lambda (_) (list 'right)) (iota 16)))
             (blocks (map (lambda (group left right)
                            (let (axis (append
                                         (if (= (modulo group 3) 1) [] (list left))
                                         (if (= (modulo group 4) 1) [] (list right))
                                         (iota 8)))
                              (make-rectangle (list group) axis axis)))
                          (iota 16) lefts rights))
             (sizes (map (lambda (group)
                           (+ 8 (if (= (modulo group 3) 1) 0 1)
                                (if (= (modulo group 4) 1) 0 1))) (iota 16)))
             (all-blocks (append blocks (list (list-ref blocks 6))))
             (view (gerbil-ascent-rectangle-view all-blocks
                     (foldl (lambda (size total) (+ total (* size size))) 100 sizes)
                     (foldl (lambda (size total) (+ total (* 2 size))) 20 sizes) #t))
             (groups (append (filter (lambda (group)
                                       (and (not (= (modulo group 3) 1))
                                            (not (= (modulo group 4) 1)))) (iota 16)) '(6)))
             (expected (map (lambda (group) (list group '(left) '(right))) groups))
             (columns (apply append (make-list 8 '(1 2))))
             (key (apply append (make-list 8 '((left) (right))))))
        (for-each (lambda (visit)
          (let ((seen []) (nested? #f) (calls 0))
            (visit view columns key
              (lambda (prefix left right)
                (check (eq? left (list-ref lefts (car prefix))) => #t)
                (check (eq? right (list-ref rights (car prefix))) => #t)
                (unless nested?
                  (set! nested? #t)
                  (check-equal? (part-rows visit view '(2 1) '((right) (left))) expected))
                (set! seen (cons (list (car prefix) left right) seen))))
            (check-equal? (reverse seen) expected)
            (check-exception (visit view columns key
              (lambda (_prefix _left _right)
                (set! calls (+ calls 1))
                (when (= calls 3) (error "stop point publication")))) exception?)
            (check-equal? calls 3)
            (check-equal? (part-rows visit view columns key) expected)))
          (list gerbil-ascent-visit-view-parts! gerbil-ascent-visit-admitted-view-parts!))))
    (test-case "nested query plans and public mutations do not affect the captured cut"
      (let* ((axis '(0 1 2))
             (view (gerbil-ascent-rectangle-view
                    (list (make-rectangle '(7) axis axis) (make-rectangle '(9) (map values axis) (map values axis))) 18 12 #t))
             (nested? #f)
             (actual (with-list-builder (emit!)
                       (gerbil-ascent-visit-view-parts! view '(0 1 1) '(7 1 1)
                         (lambda (prefix left right)
                           (unless nested? (set! nested? #t)
                             (check-consumers view '(2 0 2) '(2 9 2)))
                           (emit! (append prefix (list left right))))))))
        (check-equal? actual '((7 1 0) (7 1 1) (7 1 2)))
        (set-car! (car actual) 99)
        (check-consumers view '(0 1 2) '(7 1 2))))))
