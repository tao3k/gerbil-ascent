(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/t/performance/strata-preflight/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "STRATA-PREFLIGHT-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass?
          (case mode
            ((kernel) (and (<= (median bb) (* 0.10 (median ab)))
                           (<= (median bc) (* 0.70 (median ac))) (>= wins 35)))
            ((cold) (and (<= (median bb) (* 0.90 (median ab)))
                         (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))
            (else (and (<= (median bb) (+ (median ab) 4096))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))))
      ;; Fixed before sampling: positive kernel saves 90% allocation / 30% CPU,
      ;; 35 wins; cold solves save 10% allocation. Controls <=4 KiB extra.
      ;; All nonkernel CPU overhead <=5%+20 us.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (unless (member scenario '("positive" "negation" "aggregate" "lattice" "cold" "warm" "small"))
    (error "unknown strata preflight scenario" scenario))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "strata preflight requires symmetric native modules" name))))
   '("core/rule-semantics" "program/planning" "program/evaluate"
     "t/performance/strata-preflight/reference-semantics"
     "t/performance/strata-preflight/reference-planning"
     "t/performance/strata-preflight/reference-evaluate" "t/performance/strata-preflight/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((solve? (member scenario '("cold" "warm" "small")))
         (warm? (string=? scenario "warm"))
         (small? (string=? scenario "small"))
         (width (if small? 1 (if solve? 32 16)))
         (rules (if small? 1 4))
         (program (and solve? (strata-preflight-program width rules)))
         (old-program (and solve? (strata-preflight-program width rules)))
         (kind (cond ((string=? scenario "negation") 'negation)
                     ((string=? scenario "aggregate") 'aggregate) (else 'atom)))
         (plans (and (not solve?) (strata-preflight-plans width rules kind)))
         (kinds (make-vector (+ width 1) 'relation))
         (strict? (not (string=? scenario "positive")))
         (expected (if solve? (make-list (+ width 1) '((7)))
                     (list->vector (cons 0 (make-list width (if strict? 1 0)))))))
    (when (string=? scenario "lattice") (vector-set! kinds 0 'lattice))
    (let (result
          (paired scenario
                  (lambda () (if solve? (strata-preflight-solve #t old-program (not warm?))
                               (strata-preflight-outcome #t plans kinds)))
                  (lambda () (if solve? (strata-preflight-solve #f program (not warm?))
                               (strata-preflight-outcome #f plans kinds)))
                  (lambda (a b) (unless (and (equal? a b) (equal? b expected))
                                  (error "strata preflight independent result differs" scenario)))
                  (if solve? (if small? 16 2) 8)
                  (cond ((string=? scenario "positive") 'kernel)
                        ((string=? scenario "cold") 'cold) (else 'control))))
      (call-with-output-file [path: receipt truncate: #t]
        (lambda (port) (write (list (cons 'baseline '1de7af462fafc1b90fe475fbfd9b4ed821f79eb1)
                                    (cons 'paired-samples 50) result) port) (newline port)))
      (unless (cdr (assq 'passed? result)) (error "strata preflight allocation/CPU gate failed" scenario))))
  (displayln "OK") (force-output))
