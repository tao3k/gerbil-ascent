(import :std/encoding/json :gerbil-ascent/program/objects
        (only-in "rule-source.ss" ascent-read-rule-sources)
        (only-in "dsl-source.ss" ascent-load-dsl-sources)
        "evidence-module.ss" "value-graph.ss"
        (only-in :gerbil-ascent/program/analysis gerbil-ascent-program-schema)
        (only-in :gerbil-ascent/program/evidence-dag ascent-evidence-dag)
        (only-in :gerbil-ascent/program/trajectory ascent-trajectory)
        (only-in :gerbil-ascent/program/planning gerbil-ascent-prepare-program)
        (only-in :gerbil-ascent/program/scheme-checked
                 relational-where relational-compute relational-reducer
                 relational-scalar? relational-operator-literal relational-operator-description relational-operand-variables)
        (only-in :gerbil-ascent/applications/domain-evidence ascent-domain-check ascent-domain-contract)
        (only-in :gerbil-ascent/candidate/reasoning reasoning-source-snapshot)
        (only-in :gerbil-ascent/candidate/evidence-store
                 reasoning-open-evidence-store reasoning-resolve-evidence
                 reasoning-evidence-fact reasoning-evidence-fragment
                 reasoning-evidence-store-stats reasoning-evidence-store-clear!)
        :gerbil-ascent/program/session
        (only-in :std/hash/misc hash-key?)
        (only-in :gerbil-ascent/table/provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/table/storage gerbil-ascent-set-storage-provider)
        (only-in :clan/poo/object .o .ref))
(import (only-in "closed-source.ss" ascent-closed-guard-description)
        :gerbil-ascent/program/execution-control
        :gerbil-ascent/program/aggregators)
(export ascent-engine-dispatch ascent-engine-program-wire ascent-engine-call)
(defstruct api-session (engine sources queries))
(def sessions (make-hash-table-eqv))
(defstruct source-state (queries descriptors generation last-result runs program explain results sources names))
(defstruct native-result (generation value retained kind))
(def next-result 0)
(def source-sessions (make-hash-table-eqv))
(def syntax-library-path #f)
(def next-handle 0)
(def evidence-owners (make-hash-table-eqv))
(def next-evidence-owner 0)
(defstruct module-owner (module results resolver))
(def module-owners (make-hash-table-eqv))
(def next-module-owner 0)

;; Trusted module calls retain arbitrary upstream values, not only Programs.
;; Inference and object contracts remain in the selected exported procedure.
(def (module-owner-lookup request)
  (let (owner (hash-get module-owners (hash-ref request "owner")))
    (unless owner (error "closed or unknown native module owner"))
    owner))

(def (source-reference-value reference (expected #f))
  (let* ((state (hash-get source-sessions (hash-ref reference "owner")))
         (generation (hash-ref reference "generation")))
    (unless (and state (or (not expected) (eq? state expected))
                 (= generation (source-state-generation state)))
      (error "released, stale or foreign native source value"))
    (let* ((entry (native-result-lookup state (hash-ref reference "result")))
           (node (hash-ref reference "node")))
      (unless (hash-key? (native-result-retained entry) node) (error "unknown native source node"))
      (hash-ref (native-result-retained entry) node))))
(def (module-arguments owner arguments)
  (unless (list? arguments) (error "native module arguments must be a list"))
  (let (graphs (make-hash-table))
    (map (lambda (v)
      (ascent-value-input v (lambda (reference)
        (if (equal? (hash-ref reference "type") "source-reference")
          (source-reference-value reference)
          (let* ((entry (hash-get (module-owner-results owner) (hash-ref reference "result")))
                 (node (hash-ref reference "node")))
            (unless (and entry (hash-key? (native-result-retained entry) node))
              (error "released or foreign native module value"))
            (hash-ref (native-result-retained entry) node)))) graphs)) arguments)))

(def (module-invocation owner thunk)
  (let (results (module-owner-results owner))
    (when (>= (hash-length results) 64) (error "native module value limit; release values"))
    (let* ((values (call-with-values thunk list))
           (value (if (= (length values) 1) (car values) (list->vector values)))
           (retained (make-hash-table-eqv))
           (entry (make-native-result 0 value retained 'module-value)))
      (set! next-result (+ next-result 1))
      ;; Retain before projection; transport failure must not discard execution.
      (ascent-accept-publication!)
      (hash-put! results next-result entry)
      (with-catch
       (lambda (_)
         (hash-clear! retained)
         (hash ("valueHandle" next-result) ("valueCount" (length values))
               ("encoding" "native-reference-only")
               ("gap" "native graph projection failed; value remains owned")))
       (lambda ()
         (hash ("valueHandle" next-result) ("valueCount" (length values))
               ("value" (ascent-value-graph value retained))))))))

(def (module-call request)
  (let* ((owner (module-owner-lookup request))
         (decoded (module-arguments owner (hash-ref request "arguments"))))
    (module-invocation owner
      (lambda ()
        (if (hash-key? request "moduleOwner")
          (let (target (hash-get module-owners (hash-ref request "moduleOwner")))
            (unless (and target (module-owner-resolver target)) (error "closed module export scope"))
            ((module-owner-resolver target) (hash-ref request "export") decoded))
        (if (and (module-owner-resolver owner) (not (hash-key? request "module")))
          (if (hash-key? request "component")
            ((module-owner-resolver owner) (hash-ref request "export") decoded (hash-ref request "component"))
            ((module-owner-resolver owner) (hash-ref request "export") decoded))
          (ascent-load-evidence-module (hash-ref request "module" (module-owner-module owner))
                     (hash-ref request "export") decoded)))))))

(def (module-apply request)
  (let* ((owner (module-owner-lookup request))
         (entry (hash-get (module-owner-results owner) (hash-ref request "value")))
         (decoded (module-arguments owner (hash-ref request "arguments"))))
    (unless (and entry (procedure? (native-result-value entry)))
      (error "native value is not an owned procedure"))
    (module-invocation owner (lambda () (apply (native-result-value entry) decoded)))))

(def (module-value request)
  (let* ((owner (module-owner-lookup request)) (results (module-owner-results owner))
         (id (hash-ref request "value")))
    (unless (and (exact-integer? id) (> id 0)) (error "invalid native module value"))
    (case (name (hash-ref request "action"))
      ((release) (hash-remove! results id) (hash ("released" #t)))
      ((reference)
       (let (entry (hash-get results id))
         (unless entry (error "released or foreign native module value"))
         (let (node (+ 1 (hash-length (native-result-retained entry))))
           (when (> node 65536) (error "native value reference bound"))
           (hash-put! (native-result-retained entry) node (native-result-value entry))
           (hash ("type" "reference") ("result" id) ("node" node)))))
      (else (error "unsupported native module value action")))))
;; Inert JSON transport only: admission, proof replay and scope stay in Scheme.
(def (evidence-wire value)
  (cond ((symbol? value) (symbol->string value))
        ((pair? value) (map evidence-wire value))
        (else value)))
(def (evidence-datum value)
  (cond ((string? value) (name value))
        ((pair? value) (map evidence-datum value))
        (else value)))
(def (evidence-dispatch request)
  (let (action (name (hash-ref request "action")))
    (if (eq? action 'open)
      (begin
        (shape request '("operation" "action"))
        (when (>= (hash-length evidence-owners) 64) (error "evidence owner limit"))
        (set! next-evidence-owner (+ next-evidence-owner 1))
        (hash-put! evidence-owners next-evidence-owner (reasoning-open-evidence-store))
        (hash ("owner" next-evidence-owner)))
      (let* ((id (hash-ref request "owner"))
             (store (and (exact-integer? id) (hash-get evidence-owners id))))
        (unless store (error "invalid evidence owner"))
        (case action
          ((close stats)
           (shape request '("operation" "action" "owner"))
           (if (eq? action 'stats) (evidence-wire (reasoning-evidence-store-stats store))
             (begin (reasoning-evidence-store-clear! store)
                    (hash-remove! evidence-owners id) (hash ("closed" #t)))))
          ((resolve fact fragment)
           (shape request (append '("operation" "action" "owner" "source" "candidate")
                          (if (eq? action 'resolve) [] '("handle" "atom"))))
           (let (source (hash-ref request "source"))
             (shape source '("identity" "generation" "relations"))
             (let* ((snapshot (reasoning-source-snapshot (hash-ref source "identity")
                               (hash-ref source "generation")
                               (evidence-datum (hash-ref source "relations"))))
                    (candidate (evidence-datum (hash-ref request "candidate"))))
               (evidence-wire
                 (case action
                   ((resolve) (reasoning-resolve-evidence store snapshot candidate))
                   ((fact) (reasoning-evidence-fact store snapshot candidate
                             (hash-ref request "handle") (evidence-datum (hash-ref request "atom"))))
                   ((fragment) (reasoning-evidence-fragment store snapshot candidate
                                 (hash-ref request "handle") (evidence-datum (hash-ref request "atom")))))))))
          (else (error "unsupported evidence action")))))))
(def (shape object required (optional []))
  (unless (and (hash-table? object)
               (andmap (lambda (k) (hash-key? object k)) required)
               (andmap (lambda (k) (member k (append required optional))) (hash-keys object)))
    (error "invalid scheme request fields")))

;; Caller ceilings only tighten a declaration. Infinity stays native, never JSON.
(def (limit-program program policy)
  (if (not policy) program
    (let ()
      (def (ceiling key slot)
        (let ((limit (hash-ref policy key +inf.0)) (declared (.ref program slot)))
          (unless (or (eqv? limit +inf.0) (and (exact-integer? limit) (> limit 0)))
            (error "fact limit must be a positive exact integer" key))
          (if (< limit declared) limit declared)))
      (shape policy [] '("input" "derived" "output"))
      (.o (:: @ program)
          max-input-facts: (ceiling "input" 'max-input-facts)
          max-derived-facts: (ceiling "derived" 'max-derived-facts)
          max-output-facts: (ceiling "output" 'max-output-facts)))))
(def (program-limits program)
  (def (wire slot)
    (let (limit (.ref program slot)) (if (eqv? limit +inf.0) "unlimited" limit)))
  (hash ("input" (wire 'max-input-facts))
        ("derived" (wire 'max-derived-facts)) ("output" (wire 'max-output-facts))))
(def (name value)
  (unless (and (string? value) (< 0 (string-length value) 129)) (error "invalid scheme name"))
  (string->symbol value))
(def (scalar value)
  (cond ((string? value) (name value))
        ((or (exact-integer? value) (boolean? value)) value)
        (else (error "unsupported scheme scalar"))))
(def (unique xs)
  (let (seen (make-hash-table))
    (for-each (lambda (x) (when (hash-key? seen x) (error "duplicate scheme name")) (hash-put! seen x #t)) xs))
  xs)
(def (column descriptor)
  (shape descriptor '("kind") '("domain"))
  (let* ((kind (hash-ref descriptor "kind"))
         (type (cond ((equal? kind "symbol") symbol?) ((equal? kind "integer") exact-integer?)
                     ((equal? kind "boolean") boolean?) (else (error "unsupported column kind"))))
         (domain (and (hash-key? descriptor "domain") (map scalar (hash-ref descriptor "domain")))))
    (when domain (unless (andmap type domain) (error "invalid typed domain")))
    (lambda (x) (and (type x) (or (not domain) (and (member x domain) #t))))))
(def (rows raw columns (limit +inf.0))
  (unless (and (list? raw) (<= (length raw) limit)) (error "scheme row bound"))
  (map (lambda (row)
    (unless (and (list? row) (= (length row) (length columns))) (error "scheme row arity"))
    (let (values (map scalar row))
      (unless (andmap (lambda (p v) (p v)) columns values) (error "scheme row type")) values)) raw))
(def (term t)
  (unless (and (hash-table? t) (= (hash-length t) 1)) (error "invalid scheme term"))
  (cond ((hash-key? t "var") (gerbil-ascent-variable (name (hash-ref t "var"))))
        ((hash-key? t "const") (gerbil-ascent-literal (scalar (hash-ref t "const"))))
        (else (error "unsupported scheme term"))))
(def (atom a (body? #f))
  (shape a '("relation" "terms") '("not"))
  (let ((relation (name (hash-ref a "relation"))) (terms (map term (hash-ref a "terms"))))
    (if (hash-get a "not")
      (begin (unless (and body? (eq? (hash-ref a "not") #t)) (error "invalid negated atom"))
             (gerbil-ascent-negation relation terms))
      (gerbil-ascent-atom relation terms))))
(def (operator-operand value)
  (unless (and (hash-table? value) (= (hash-length value) 1))
    (error "invalid operator operand"))
  (cond ((hash-key? value "var") (name (hash-ref value "var")))
        ((hash-key? value "const")
         (relational-operator-literal (scalar (hash-ref value "const"))))
        (else (error "unsupported operator operand"))))
(def (body-clause clause)
  (if (and (hash-table? clause) (hash-key? clause "mode"))
    (case (name (hash-ref clause "mode"))
      ((where)
       (shape clause '("mode" "operator" "terms"))
       (relational-where (name (hash-ref clause "operator"))
                         (map operator-operand (hash-ref clause "terms"))))
      ((compute)
       (shape clause '("mode" "operator" "output" "terms"))
       (relational-compute (name (hash-ref clause "output"))
                           (name (hash-ref clause "operator"))
                           (map operator-operand (hash-ref clause "terms"))))
      ((reduce)
       (shape clause '("mode" "operator" "output" "relation" "terms" "inputs"))
       (relational-reducer (name (hash-ref clause "output"))
                           (name (hash-ref clause "operator"))
                           (map name (hash-ref clause "inputs"))
                           (name (hash-ref clause "relation"))
                           (map term (hash-ref clause "terms"))))
      (else (error "unsupported operator mode")))
    (atom clause #t)))
(def (rule-catalog-program catalog)
  (let* ((declarations (hash-ref catalog "relations"))
         (relations
          (map (lambda (relation)
                 (let (columns (map column (hash-ref relation "columns")))
                   (gerbil-ascent-relation (name (hash-ref relation "name"))
                     (length columns) [] gerbil-ascent-hash-index-provider
                     gerbil-ascent-set-storage-provider columns))) declarations))
         (sources (map (lambda (relation) (name (hash-ref relation "name")))
                        (filter (lambda (relation) (hash-ref relation "source")) declarations)))
         (rules (map (lambda (rule)
                       (gerbil-ascent-rule (map atom (hash-ref rule "head"))
                         (map body-clause (hash-ref rule "body")))) (hash-ref catalog "rules")))
         (program (gerbil-ascent-program relations rules +inf.0 +inf.0 +inf.0 sources)))
    program))
(def (validate-rule-catalog catalog)
  (let (program (rule-catalog-program catalog))
    (gerbil-ascent-prepare-program (.ref program 'relations) (.ref program 'rules)
      (gerbil-ascent-program-schema program (.ref program 'relations)) #f)
    catalog))
(def (open-program declaration (policy #f))
  (shape declaration '("relations" "rules" "queries"))
  (unless (< (hash-length sessions) 64) (error "scheme session limit"))
  (let ((relations []) (sources []) (names []))
    (let (declarations (hash-ref declaration "relations"))
      (unless (and (list? declarations) (<= 1 (length declarations) 64)) (error "scheme relation bound"))
      (for-each (lambda (r)
        (shape r '("name" "columns" "source" "rows"))
        (let* ((n (name (hash-ref r "name"))) (raw-columns (hash-ref r "columns")))
          (unless (and (list? raw-columns) (<= (length raw-columns) 16) (boolean? (hash-ref r "source")))
            (error "invalid scheme relation declaration"))
          (let* ((columns (map column raw-columns)) (values (rows (hash-ref r "rows") columns)))
            (unless (or (hash-ref r "source") (null? values)) (error "derived relation has source rows"))
            (set! names (cons n names))
            (set! relations (cons (gerbil-ascent-relation n (length columns) values
               gerbil-ascent-hash-index-provider gerbil-ascent-set-storage-provider columns) relations))
            (when (hash-ref r "source") (set! sources (cons (cons n columns) sources)))))) declarations))
    (unique names)
    (unless (pair? sources) (error "scheme program requires explicit source authority"))
    (let ((queries (unique (map name (hash-ref declaration "queries"))))
          (rules (hash-ref declaration "rules")))
      (unless (and (list? rules) (<= (length rules) 128) (andmap (lambda (n) (memq n names)) queries))
        (error "scheme rule/query bound"))
      (let* ((compiled (map (lambda (r)
                 (shape r '("head" "body"))
                 (gerbil-ascent-rule (map atom (hash-ref r "head"))
                   (map body-clause (hash-ref r "body")))) rules))
             (program (limit-program
               (gerbil-ascent-program (reverse relations) compiled +inf.0 +inf.0 +inf.0 (map car sources)) policy))
             (session (gerbil-ascent-open-session program)))
        (set! next-handle (+ next-handle 1))
        (ascent-accept-publication!)
      (hash-put! sessions next-handle (make-api-session session sources queries))
        (hash ("handle" next-handle) ("factLimits" (program-limits program)))))))
(def (lookup request)
  (let (handle (hash-ref request "handle"))
    (unless (and (exact-integer? handle) (> handle 0) (hash-key? sessions handle)) (error "invalid scheme session handle"))
    (hash-ref sessions handle)))
(def (open-sources texts (policy #f))
  (when (>= (hash-length sessions) 64) (error "scheme session limit"))
  (let-values (((program descriptors exports) (ascent-load-dsl-sources texts)))
    (open-native-program (limit-program program policy) descriptors exports #f)))

(def (open-rule-sources texts (policy #f))
  (when (>= (hash-length sessions) 64) (error "scheme session limit"))
  (let* ((catalog (ascent-read-rule-sources texts))
         (descriptors (hash-ref catalog "relations"))
         (program (limit-program (rule-catalog-program catalog) policy)))
    (open-native-program program descriptors
      (map (cut hash-ref <> "name") descriptors) #f)))

(def (open-native-program program descriptors exports explain (bindings []))
  (when (>= (hash-length sessions) 64) (error "scheme session limit"))
    (let* ((names (map (lambda (r d) (cons (hash-ref d "name") (.ref r 'name)))
                      (.ref program 'relations) descriptors))
           (_ (unique (map (lambda (entry) (name (car entry))) names)))
           (resolve (lambda (label) (let (entry (assoc label names))
                      (unless entry (error "unknown native relation label" label)) (cdr entry))))
           (queries (map resolve exports))
           (sources (map (lambda (d) (cons (resolve (hash-ref d "name")) (hash-ref d "columns")))
                     (filter (lambda (d) (hash-ref d "source")) descriptors)))
           (projection (with-catch
                        (lambda (_) (hash ("status" "unsupported")
                                           ("reason" "native DSL semantics are not a finite wire projection")))
                        (lambda ()
                          (for-each (lambda (relation descriptor)
                            (unless (or (null? (.ref relation 'field-predicates))
                                        (andmap (lambda (c) (member (hash-ref c "kind") '("symbol" "integer" "boolean" "string" "scalar")))
                                                (hash-ref descriptor "columns")))
                              (error "projection requires native scalar predicates")))
                            (.ref program 'relations) descriptors)
                          (hash ("status" "supported")
                                ("program" (ascent-engine-program-wire program (map car sources)
                                  (map (lambda (d) (cons (name (hash-ref d "name")) (hash-ref d "columns")))
                                       descriptors) queries))))))
           (session (gerbil-ascent-open-session program)))
      (set! next-handle (+ next-handle 1))
      (ascent-accept-publication!)
      (hash-put! sessions next-handle (make-api-session session sources queries))
      (hash-put! source-sessions next-handle
        (make-source-state queries descriptors 0 #f 0 program explain (make-hash-table-eqv)
          (map (lambda (r) (cons (.ref r 'name) (map (cut map identity <>) (.ref r 'rows))))
               (.ref program 'relations)) names))
      (hash ("handle" next-handle) ("descriptors" descriptors) ("queries" exports)
            ("projection" projection) ("sourceGeneration" 0)
            ("factLimits" (program-limits program)))))

(def (open-module request)
  (when (>= (hash-length sessions) 64) (error "scheme session limit"))
  (let* ((owner (and (hash-key? request "owner") (module-owner-lookup request)))
         (load (cond (owner
                 (or (module-owner-resolver owner)
                     (lambda (export arguments)
                       (ascent-load-evidence-module (module-owner-module owner) export arguments))))
                ((hash-key? request "components")
                 (let-values (((resolver selected)
                   (ascent-load-evidence-components (hash-ref request "components")
                     (hash-ref request "sources") (hash-ref request "entry") (hash-ref request "trusted")
                     (hash-get request "maxSourceScopes"))))
                   resolver))
                ((hash-key? request "source")
                 (ascent-load-evidence-source (hash-ref request "source")
                   (hash-ref request "trusted" #f) (hash-get request "maxSourceScopes")))
                (else (lambda (export arguments)
                   (ascent-load-evidence-module (hash-ref request "module") export arguments)))))
         (arguments (if owner
                       (module-arguments owner (hash-ref request "arguments"))
                       (map (lambda (v) (ascent-value-input v (lambda (_) (error "no result owner"))))
                            (hash-ref request "arguments"))))
         (value (if (hash-key? request "component")
                    (load (hash-ref request "constructor") arguments (hash-ref request "component"))
                    (load (hash-ref request "constructor") arguments)))
         (module (if (evidence-module? value) value (ascent-evidence-module value)))
         (program (limit-program (evidence-module-program module) (hash-get request "factLimits")))
         (bindings (evidence-module-bindings module))
         (descriptors (ascent-evidence-module-descriptors program bindings)))
    (open-native-program program descriptors (map (lambda (d) (hash-ref d "name")) descriptors)
                         (evidence-module-explain module) bindings)))

(def (source-name state label)
  (unless (string? label) (error "native relation label must be a string"))
  (let (entry (assoc label (source-state-names state)))
    (unless entry (error "unknown native relation label" label))
    (cdr entry)))

(def (source-label state handle)
  (let (entry (find (lambda (entry) (eq? (cdr entry) handle)) (source-state-names state)))
    (if entry (car entry) (symbol->string handle))))

(def (wire-scalar? value)
  (or (interned-symbol? value) (string? value) (exact-integer? value) (boolean? value)))

(def (source-lookup request)
  (let* ((session (lookup request)) (state (hash-get source-sessions (hash-ref request "handle"))))
    (unless state (error "native DSL session required"))
    (values session state)))

(def (source-rows raw columns state)
  (unless (list? raw) (error "native source rows must be a list"))
  (when (> (length raw) (.ref (source-state-program state) 'max-input-facts))
    (error "ASCENT source fact budget exceeded"))
  (let (graphs (make-hash-table))
    (map (lambda (row)
      (unless (and (list? row) (= (length row) (length columns))) (error "scheme row arity"))
      (map (lambda (value descriptor)
        (let* ((kind (string->symbol (hash-ref descriptor "kind")))
               (decoded (if (and (memq kind '(symbol scalar)) (string? value)) (string->symbol value)
                 (ascent-value-input value (lambda (reference)
                   (cond ((equal? (hash-ref reference "type") "source-reference")
                     (source-reference-value reference state))
                     ((equal? (hash-ref reference "type") "module-reference")
                      (let* ((owner (module-owner-lookup reference))
                             (entry (hash-get (module-owner-results owner) (hash-ref reference "result")))
                             (node (hash-ref reference "node")))
                        (unless (and entry (hash-key? (native-result-retained entry) node))
                          (error "released or foreign native module value"))
                        (hash-ref (native-result-retained entry) node)))
                     (else
                     (let* ((entry (native-result-lookup state (hash-ref reference "result")))
                            (id (hash-ref reference "node")))
                       (unless (hash-key? (native-result-retained entry) id) (error "unknown native value reference"))
                       (hash-ref (native-result-retained entry) id))))) graphs))))
          (unless (case kind
                    ((symbol) (symbol? decoded)) ((integer) (exact-integer? decoded))
                    ((boolean) (boolean? decoded)) ((string) (string? decoded))
                    ((scalar) (relational-scalar? decoded)) ((native) #t) (else #f))
            (error "native source field type mismatch"))
          (when (and (eq? kind 'symbol) (> (u8vector-length (string->utf8 (symbol->string decoded))) 4096))
            (error "native symbol value byte bound"))
          decoded)) row columns)) raw)))

(def (source-run request)
  (let-values (((session state) (source-lookup request)))
    (let* ((queries (unique (map (cut source-name state <>) (hash-ref request "queries"))))
           (duration (hash-ref request "timeoutNanoseconds" 1000000000)))
      (unless (and (<= (length queries) 128)
                   (andmap (lambda (n) (memq n (source-state-queries state))) queries)
                   (exact-integer? duration) (<= 0 duration 1000000000))
        (error "native DSL query/deadline contract"))
      (let ((result (gerbil-ascent-session-run-timeout (api-session-engine session) duration))
            (answers (make-hash-table)))
        (for-each (lambda (n)
          (hash-put! answers (source-label state n)
            (map (lambda (row)
                   (map (lambda (v)
                          (cond ((interned-symbol? v) (symbol->string v))
                                ((or (string? v) (exact-integer? v) (boolean? v)) v)
                                (else (hash ("encoding" "native-result-reference"))))) row))
                 ((.ref result 'rows-of) n)))) queries)
        (ascent-accept-publication!)
        (source-state-runs-set! state (+ (source-state-runs state) 1))
        (let (reused (and (.ref result 'finished) (eq? result (source-state-last-result state))))
          (when (.ref result 'finished) (source-state-last-result-set! state result))
          (let (handle (retain-native-result state result))
          (hash ("complete" (.ref result 'finished)) ("relations" answers)
                ("resultHandle" handle)
                ("scalarProjection" (if (andmap (lambda (n)
                  (andmap (lambda (row) (andmap wire-scalar? row))
                    ((.ref result 'rows-of) n))) queries) "supported" "partial"))
                ("nativeResultReused" reused) ("sourceGeneration" (source-state-generation state))
                ("runIndex" (source-state-runs state))
                ("evaluationPath" (symbol->string (.ref result 'evaluation-path)))
                ("reusedRelations" (map symbol->string (.ref result 'reused-relations)))
                ("activeRuleCount" (.ref result 'active-rule-count)))))))))

(def (retain-native-result state value (kind 'result))
  (when (>= (hash-length (source-state-results state)) 64)
    (error "native result owner limit; release results"))
  (set! next-result (+ next-result 1))
  (hash-put! (source-state-results state) next-result
    (make-native-result (source-state-generation state) value (make-hash-table-eqv) kind))
  next-result)

(def (native-result-lookup state id)
  (let (entry (and (exact-integer? id) (hash-get (source-state-results state) id)))
    (unless (and entry (= (native-result-generation entry) (source-state-generation state)))
      (error "stale or unknown native result"))
    entry))

(def (result-dispatch request)
  (let-values (((session state) (source-lookup request)))
    (let* ((id (hash-ref request "result"))
           (action (name (hash-ref request "action"))))
      (unless (and (exact-integer? id) (> id 0)) (error "invalid native result id"))
      (case action
        ((check)
         (let (entry (native-result-lookup state id))
           (unless (eq? (native-result-kind entry) 'result) (error "result handle required"))
           (hash ("sourceGeneration" (native-result-generation entry)))))
        ((release) (hash-remove! (source-state-results state) id) (hash ("released" #t)))
        ((reference)
         (let* ((entry (native-result-lookup state id))
                (n (source-name state (hash-ref request "relation")))
                (row-index (hash-ref request "row")) (column (hash-ref request "column")))
           (unless (and (eq? (native-result-kind entry) 'result) (memq n (source-state-queries state))
                        (exact-integer? row-index) (>= row-index 0) (exact-integer? column) (>= column 0))
             (error "native result cell coordinates"))
           (let* ((rows ((.ref (native-result-value entry) 'rows-of) n))
                  (_ (unless (< row-index (length rows)) (error "native result row outside relation")))
                  (row (list-ref rows row-index))
                  (_ (unless (< column (length row)) (error "native result column outside row")))
                  (node (+ 1 (hash-length (native-result-retained entry)))))
             (when (> node 65536) (error "native value reference bound"))
             (hash-put! (native-result-retained entry) node (list-ref row column))
             (hash ("node" node) ("sourceGeneration" (source-state-generation state))))))
        ((proof-scope)
         (let* ((n (source-name state (hash-ref request "relation"))) (entry (native-result-lookup state id)))
           (unless (and (eq? (native-result-kind entry) 'result)
                        (.ref (native-result-value entry) 'finished)
                        (memq n (source-state-queries state)))
             (error "complete native result required for provenance"))
           (hash ("sourceGeneration" (source-state-generation state)))))
        ((scalar-rows)
         (let* ((n (source-name state (hash-ref request "relation")))
                (entry (native-result-lookup state id))
                (value (native-result-value entry)))
           (unless (and (eq? (native-result-kind entry) 'result) (.ref value 'finished)
                        (memq n (source-state-queries state)))
             (error "complete native result required for provenance"))
           (map (lambda (row)
                  (map (lambda (v)
                         (cond ((interned-symbol? v) (hash ("kind" "symbol") ("value" (symbol->string v))))
                               ((exact-integer? v) (hash ("kind" "integer") ("value" v)))
                               ((number? v) (hash ("kind" "number") ("value" (number->string v))))
                               ((string? v) (hash ("kind" "string") ("value" v)))
                               ((boolean? v) (hash ("kind" "boolean") ("value" v)))
                               (else (hash ("kind" "graph") ("value" (ascent-value-graph v (make-hash-table-eqv))))))) row))
                ((.ref value 'rows-of) n))))
        ((rows)
         (let ((n (source-name state (hash-ref request "relation"))) (entry (native-result-lookup state id)))
           (unless (eq? (native-result-kind entry) 'result) (error "rows requires a result handle"))
           (unless (memq n (source-state-queries state)) (error "unknown native result relation"))
           (let (retained (native-result-retained entry))
             (let (graph (ascent-value-graph ((.ref (native-result-value entry) 'rows-of) n) retained))
               (hash ("resultHandle" id) ("sourceGeneration" (source-state-generation state))
                     ("value" graph))))))
        ((explain)
         (let* ((program (source-state-program state))
                (entry (native-result-lookup state id))
                (query (source-name state (hash-ref request "relation")))
                (explain (source-state-explain state))
                (_ (unless (eq? (native-result-kind entry) 'result) (error "explain requires a result handle")))
                (_ (unless (memq query (source-state-queries state)) (error "unknown explanation relation")))
                (scope (hash ("sourceGeneration" (source-state-generation state))
                             ("sources" (source-state-sources state))
                             ("premise" "nested native values are shared; host immutability is required")))
                (value (if explain
                         (explain program (native-result-value entry) query scope)
                         (hash ("status" "unsupported")
                               ("gap" "native row derivation proof not supplied by this module")
                               ("dependencies" (.ref program 'rules))
                               ("declarations" (.ref program 'relations))
                               ("scope" scope))))
                (retained (make-hash-table-eqv)))
           (let (graph (ascent-value-graph value retained))
             (let (proof (retain-native-result state value 'explanation))
               (native-result-retained-set! (native-result-lookup state proof) retained)
               (hash ("explanationHandle" proof) ("value" graph)
                     ("sourceGeneration" (source-state-generation state)))))))
        (else (error "unsupported native result action"))))))

(def (dispatch request)
  (when (hash-key? request "maxSourceScopes")
    (let (ceiling (hash-ref request "maxSourceScopes"))
      (unless (and (exact-integer? ceiling) (> ceiling 0))
        (error "source scope ceiling must be a positive integer"))))
  (case (name (hash-ref request "operation"))
    ((module-open dsl-open module-source-open)
     (if (memq (name (hash-ref request "operation")) '(dsl-open module-source-open))
       (shape request '("operation" "source" "trusted") '("maxSourceScopes"))
       (shape request '("operation" "module")))
     (let (module (hash-ref request "module" "<native-evidence>"))
       (unless (and (string? module) (or (hash-key? request "source") (string-prefix? ":" module))
                    (<= (string-length module) 4096)) (error "invalid native module"))
       (when (>= (hash-length module-owners) 64) (error "native module owner limit"))
       (set! next-module-owner (+ 1 next-module-owner))
       (let (resolver (and (hash-key? request "source")
                           ((if (eq? (name (hash-ref request "operation")) 'module-source-open)
                                ascent-load-module-source ascent-load-evidence-source) (hash-ref request "source")
                             (hash-ref request "trusted") (hash-get request "maxSourceScopes"))))
         (ascent-accept-publication!)
       (hash-put! module-owners next-module-owner
           (make-module-owner module (make-hash-table-eqv) resolver)))
       (hash ("owner" next-module-owner))))
    ((components-open)
     (shape request '("operation" "components" "sources" "entry" "trusted") '("maxSourceScopes"))
     (when (>= (hash-length module-owners) 64) (error "native module owner limit"))
     (let-values (((resolver selected)
       (ascent-load-evidence-components (hash-ref request "components") (hash-ref request "sources")
         (hash-ref request "entry") (hash-ref request "trusted") (hash-get request "maxSourceScopes"))))
       (set! next-module-owner (+ 1 next-module-owner))
       (ascent-accept-publication!)
       (hash-put! module-owners next-module-owner
         (make-module-owner "<evidence-components>" (make-hash-table-eqv) resolver))
       (hash ("owner" next-module-owner) ("components" selected))))
    ((module-call)
     (shape request '("operation" "owner" "export" "arguments") '("module" "component" "moduleOwner"))
     (when (and (hash-key? request "module") (hash-key? request "component"))
       (error "module and component call entries are mutually exclusive"))
     (when (and (hash-key? request "component")
                (not (equal? (module-owner-module (module-owner-lookup request)) "<evidence-components>")))
       (error "component call requires an Evidence component owner"))
     (module-call request))
    ((module-value)
     (shape request '("operation" "owner" "value" "action")) (module-value request))
    ((module-apply)
     (shape request '("operation" "owner" "value" "arguments")) (module-apply request))
    ((owner-evidence)
     (shape request '("operation" "owner" "constructor" "arguments") '("component" "factLimits"))
     (when (and (hash-key? request "component")
                (not (equal? (module-owner-module (module-owner-lookup request)) "<evidence-components>")))
       (error "component call requires an Evidence component owner"))
     (open-module request))
    ((value-evidence)
     (shape request '("operation" "owner" "value") '("factLimits"))
     (let* ((owner (module-owner-lookup request))
            (entry (hash-get (module-owner-results owner) (hash-ref request "value"))))
       (unless entry (error "released or foreign native module value"))
       (let* ((value (native-result-value entry))
              (module (if (evidence-module? value) value (ascent-evidence-module value)))
              (program (limit-program (evidence-module-program module) (hash-get request "factLimits")))
              (bindings (evidence-module-bindings module))
              (descriptors (ascent-evidence-module-descriptors program bindings)))
         (open-native-program program descriptors (map (lambda (d) (hash-ref d "name")) descriptors)
                              (evidence-module-explain module) bindings))))
    ((module-close)
     (shape request '("operation" "owner"))
     (module-owner-lookup request)
     (hash-remove! module-owners (hash-ref request "owner")) (hash ("closed" #t)))
    ((configure-syntax)
     (shape request '("operation" "path"))
     (let (path (hash-ref request "path"))
       (unless (and (string? path) (<= (string-length path) 4096)
                    (or (not syntax-library-path) (string=? path syntax-library-path)))
         (error "native syntax resources cannot change in a loaded runtime"))
       (set! syntax-library-path path)
       (set-load-path! [path])
       (hash ("configured" #t))))
    ((describe) (shape request '("operation"))
     (hash ("abi" 1) ("operations" '("open" "open-sources" "open-rule-sources" "open-module" "open-evidence" "open-components" "components-open" "owner-evidence" "native-result" "module-open" "dsl-open" "module-call" "module-value" "module-apply" "module-close" "source-replace" "source-run" "replace" "run" "close" "compare" "domain-check" "computational-evidence" "read-rules" "evidence-dag" "trajectory"))
           ("evidenceDSLContract" "trusted-host-scheme.v1")
           ("componentContract" "ascent.evidence-components.v1")
           ("moduleContract" "trusted-native-evidence-module.v1")
           ("resultContract" "native-value-graph.v1")
           ("sourceTextContract" "upstream-ascent-dsl.v1")
           ("ruleTextContract" "inert-relational-subset.v1")
           ("clauseOperators" (hash ("where" '("<" "even?"))
                                    ("compute" '("+" "identity"))
                                    ("reduce" '("count" "sum" "min" "max"))))
           ("factLimitContract" "caller-ceilings.v1")
           ("maxInputBytes" "unlimited") ("maxSourceScopes" "unlimited")
           ("sourceScopes" (ascent-source-scope-count)) ("maxSessions" 64)))
    ((open) (shape request '("operation" "program") '("factLimits"))
     (open-program (hash-ref request "program") (hash-get request "factLimits")))
    ((open-sources) (shape request '("operation" "sources") '("factLimits"))
     (open-sources (hash-ref request "sources") (hash-get request "factLimits")))
    ((open-rule-sources) (shape request '("operation" "sources") '("factLimits"))
     (open-rule-sources (hash-ref request "sources") (hash-get request "factLimits")))
    ((open-module)
     (shape request '("operation" "module" "constructor" "arguments") '("factLimits")) (open-module request))
    ((open-evidence)
     (shape request '("operation" "constructor" "arguments" "source" "trusted") '("factLimits" "maxSourceScopes"))
     (open-module request))
    ((open-components)
     (shape request '("operation" "constructor" "arguments" "components" "sources" "entry" "trusted") '("factLimits" "maxSourceScopes"))
     (open-module request))
    ((native-result)
     (shape request '("operation" "handle" "result" "action") '("relation" "row" "column"))
     (result-dispatch request))
    ((source-status)
     (shape request '("operation" "handle"))
     (let-values (((session state) (source-lookup request)))
       (hash ("sourceGeneration" (source-state-generation state)))))
    ((source-projection)
     (shape request '("operation" "handle"))
     (let-values (((session state) (source-lookup request)))
       (let* ((original (source-state-program state))
              (program (gerbil-ascent-program
                (map (lambda (relation)
                  (let (source (assq (.ref relation 'name) (source-state-sources state)))
                    (if source (.o (:: @ relation) rows: (cdr source)) relation))) (.ref original 'relations))
                (.ref original 'rules) (.ref original 'max-input-facts)
                (.ref original 'max-derived-facts) (.ref original 'max-output-facts) (.ref original 'source-handles))))
         (with-catch (lambda (_) (hash ("status" "unsupported") ("sourceGeneration" (source-state-generation state))))
           (lambda () (hash ("status" "supported") ("sourceGeneration" (source-state-generation state))
             ("program" (ascent-engine-program-wire program (.ref program 'source-handles)
               (map (lambda (descriptor binding) (cons (cdr binding) (hash-ref descriptor "columns")))
                    (source-state-descriptors state) (source-state-names state))
               (source-state-queries state)))))))))
    ((source-run)
     (shape request '("operation" "handle" "queries") '("timeoutNanoseconds"))
     (source-run request))
    ((source-replace)
     (shape request '("operation" "handle" "sources"))
     (let-values (((session state) (source-lookup request)))
       (let ((updates (hash-ref request "sources")))
         (unless (and (list? updates) (<= (length updates) 128)) (error "source update count bound"))
         (let (replacements
               (map (lambda (u)
                 (shape u '("relation" "rows"))
                 (let* ((n (source-name state (hash-ref u "relation"))) (columns (assq n (api-session-sources session))))
                   (unless columns (error "relation is not an update source"))
                   (cons n (source-rows (hash-ref u "rows") (cdr columns) state)))) updates))
           (unique (map car replacements))
           (gerbil-ascent-session-replace-sources! (api-session-engine session) replacements)
           (source-state-sources-set! state
             (map (lambda (source)
                    (let (replacement (assq (car source) replacements))
                      (if replacement (cons (car source) (map (cut map identity <>) (cdr replacement)))
                          source)))
                  (source-state-sources state)))
           (source-state-generation-set! state (+ (source-state-generation state) 1))
           (source-state-last-result-set! state #f)
           (hash-clear! (source-state-results state))
           (hash ("updated" #t) ("sourceGeneration" (source-state-generation state)))))))
    ((read-rules)
     (shape request '("operation" "sources"))
     (validate-rule-catalog (ascent-read-rule-sources (hash-ref request "sources"))))
    ((trajectory)
     (shape request '("operation" "action") '("task" "sourceIdentity" "trajectory" "event" "includeEvents" "reason"))
     (ascent-trajectory request))
    ((evidence-dag)
     (shape request '("operation" "action") '("program" "contract" "rule" "trusted" "sources" "certificates" "requests" "sourceIdentity" "retain" "facts" "queries"))
     (ascent-evidence-dag request))
    ((computational-evidence) (evidence-dispatch request))
    ((domain-check)
     (shape request '("operation" "kind" "observations"))
     (hash ("checkerVersion" "domain-evidence-v1")
           ("contract" (ascent-domain-contract (hash-ref request "kind")))
           ("checks" (ascent-domain-check (hash-ref request "kind") (hash-ref request "observations")))))
    ((compare)
     ;; Extensional row agreement only. Caller-supplied expected rows do not
     ;; certify natural-language intent or knowledge-graph completeness.
     (shape request '("operation" "actual" "expected"))
     (let ((actual (hash-ref request "actual")) (expected (hash-ref request "expected")))
       (def (valid rows)
         (and (list? rows) (<= (length rows) 32768)
              (andmap (lambda (r) (and (list? r) (<= (length r) 16)
                (andmap (lambda (v) (or (string? v) (exact-integer? v) (boolean? v))) r))) rows)))
       (unless (and (valid actual) (valid expected)) (error "invalid comparison rows"))
       (hash ("equal" (and (andmap (lambda (r) (and (member r expected) #t)) actual)
                            (andmap (lambda (r) (and (member r actual) #t)) expected))))))
    ((close) (shape request '("operation" "handle")) (lookup request)
     (hash-remove! source-sessions (hash-ref request "handle"))
     (hash-remove! sessions (hash-ref request "handle")) (hash ("closed" #t)))
    ((replace)
     (shape request '("operation" "handle" "sources"))
     (when (hash-key? source-sessions (hash-ref request "handle"))
       (error "native DSL session requires source-replace"))
     (let* ((session (lookup request)) (updates (hash-ref request "sources"))
            (replacements (map (lambda (u)
              (shape u '("relation" "rows"))
              (let* ((n (name (hash-ref u "relation"))) (columns (assq n (api-session-sources session))))
                (unless columns (error "relation is not an update source"))
                (cons n (rows (hash-ref u "rows") (cdr columns))))) updates)))
       (unique (map car replacements))
       (gerbil-ascent-session-replace-sources! (api-session-engine session) replacements)
       (hash ("updated" #t))))
    ((run)
     (shape request '("operation" "handle") '("timeoutNanoseconds"))
     (when (hash-key? source-sessions (hash-ref request "handle"))
       (error "native DSL session requires source-run"))
     (let* ((session (lookup request)) (duration (hash-ref request "timeoutNanoseconds" 1000000000)))
       (unless (and (exact-integer? duration) (<= 0 duration 1000000000)) (error "scheme execution deadline bound"))
       (let* ((result (gerbil-ascent-session-run-timeout (api-session-engine session) duration))
              (answers (make-hash-table)))
         (for-each (lambda (n)
           (hash-put! answers (symbol->string n)
             (map (lambda (row) (map (lambda (v) (if (symbol? v) (symbol->string v) v)) row))
                  ((.ref result 'rows-of) n)))) (api-session-queries session))
         (hash ("complete" (.ref result 'finished)) ("relations" answers)))))
    (else (error "unsupported scheme operation"))))
(def (ascent-engine-call request) (dispatch request))

(def (ascent-engine-dispatch text)
  (call-with-input-string text (lambda (port)
    (let (request (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t))) (read-json port)))
      (let loop ((c (read-char port)))
        (unless (eof-object? c) (unless (char-whitespace? c) (error "trailing scheme input")) (loop (read-char port))))
      (json->string (dispatch request))))))

;;; Serialize the supported finite relational subset, not opaque host callbacks.
;;; Column descriptors are explicit caller declarations; this is not a proof
;;; that arbitrary scheme field predicates equal the wire predicates.
(def (ascent-engine-program-wire program sources descriptors queries)
  (def complex [])
  (def next-complex 0)
  (def (cell v)
    (cond ((symbol? v)
           (unless (interned-symbol? v) (error "uninterned symbol requires native authority"))
           (hash ("type" "symbol") ("value" (symbol->string v))))
          ((or (boolean? v) (exact-integer? v)) v)
          ((number? v)
           (unless (and (real? v) (= v v) (< -inf.0 v +inf.0))
             (error "number requires native execution"))
           (hash ("type" "number") ("value" (number->string v))))
          ((string? v) (hash ("type" "string") ("value" v)))
          (else
           (let (index next-complex)
             (set! next-complex (+ index 1))
             (set! complex (cons v complex))
             (hash ("type" "pool") ("value" index))))))
  (def (wire-term t)
    (case (.ref t 'kind)
      ((variable) (hash ("var" (symbol->string (.ref t 'value)))))
      ((literal) (hash ("const" (cell (.ref t 'value)))))
      (else (error "unsupported native projection term"))))
  (def (wire-expression value)
    (cond ((symbol? value) (hash ("var" (symbol->string value))))
          ((and (list? value) (= (length value) 2) (eq? (car value) 'quote))
           (hash ("const" (cell (cadr value)))))
          ((list? value)
           (hash ("operator" (symbol->string (car value)))
                 ("arguments" (map wire-expression (cdr value)))))
          (else (hash ("const" (cell value))))))
  (def (operand value)
    (case (vector-ref value 0)
      ((variable) (hash ("var" (symbol->string (vector-ref value 1)))))
      ((literal) (hash ("const" (cell (vector-ref value 1)))))
      (else (error "invalid sealed operator operand"))))
  (def (wire-clause a)
    (case (.ref a 'ascent-clause-kind)
      ((atom negation)
       (hash ("relation" (symbol->string (.ref a 'relation)))
             ("terms" (map wire-term (.ref a 'terms))) ("not" (eq? (.ref a 'ascent-clause-kind) 'negation))))
      ((guard binding)
       (let* ((guard? (eq? (.ref a 'ascent-clause-kind) 'guard))
              (procedure (.ref a (if guard? 'predicate 'compute)))
              (closed (and guard? (ascent-closed-guard-description procedure)))
              (sealed (relational-operator-description procedure)))
         (cond
           (closed
            (unless (equal? (car closed) (.ref a 'variables)) (error "closed guard input bindings changed"))
            (hash ("mode" "guard-expression") ("expression" (wire-expression (cadr closed)))))
           ((and sealed (memq (vector-ref sealed 0) '(where compute)))
            (let (operands (vector-ref sealed 2))
              (unless (equal? (.ref a 'variables) (relational-operand-variables operands))
                (error "sealed operator input bindings changed"))
              (let (output (hash ("mode" (if guard? "where" "compute"))
                                ("operator" (symbol->string (vector-ref sealed 1)))
                                ("terms" (map operand operands))))
                (unless guard? (hash-put! output "output" (symbol->string (.ref a 'variable))))
                output)))
           (else (error "opaque callback requires native execution")))))
      ((aggregate)
       (let* ((procedure (.ref a 'aggregate))
              (sealed (relational-operator-description procedure))
              (operator (cond
                              ((and sealed (eq? (vector-ref sealed 0) 'reducer)
                                    (equal? (.ref a 'variables) (vector-ref sealed 2)))
                               (symbol->string (vector-ref sealed 1)))
                              ((eq? procedure gerbil-ascent-count) "count")
                              ((eq? procedure gerbil-ascent-sum) "sum")
                              ((eq? procedure gerbil-ascent-min) "min")
                              ((eq? procedure gerbil-ascent-max) "max")
                              ((eq? procedure gerbil-ascent-mean) "mean")
                              (else (error "opaque aggregate requires native execution")))))
         (unless (and (symbol? (.ref a 'variable)) (not (.ref a 'output-pattern)))
           (error "aggregate pattern requires native execution"))
         (hash ("mode" "reduce") ("operator" operator)
               ("output" (symbol->string (.ref a 'variable)))
               ("inputs" (map symbol->string (.ref a 'variables)))
               ("relation" (symbol->string (.ref a 'relation)))
               ("terms" (map wire-term (.ref a 'terms))))))
      (else (error "native callback requires native execution"))))
  (let (output (hash ("relations" (map (lambda (r)
      (let* ((n (.ref r 'name)) (cols (assq n descriptors)))
        (unless (and cols (= (length (cdr cols)) (.ref r 'arity))) (error "missing native column descriptors"))
        (let (output
          (hash ("name" (symbol->string n))
                ("columns" (map (lambda (c) (if (equal? (hash-ref c "kind") "native") (hash ("kind" "value")) c)) (cdr cols)))
                ("source" (and (memq n sources) #t))
                ("initialOccurrences" #t)
                ("rows" (map (lambda (r) (map cell r)) (.ref r 'rows)))))
          (when (eq? (.ref r 'storage-kind) 'lattice)
            (let* ((join (.ref r 'join)) (sealed (relational-operator-description join)))
              (hash-put! output "lattice" (cond
                  ((and sealed (eq? (vector-ref sealed 0) 'lattice)) (symbol->string (vector-ref sealed 1)))
                  ((eq? join min) "min") ((eq? join max) "max")
                  (else (error "opaque lattice join requires native execution"))))))
          output))) (.ref program 'relations)))
        ("rules" (map (lambda (r) (hash ("head" (map wire-clause (.ref r 'heads)))
                                      ("body" (map wire-clause (.ref r 'body))))) (.ref program 'rules)))
        ("queries" (map symbol->string queries))))
    (unless (null? complex)
      (let (graph (ascent-value-graph (list->vector (reverse complex)) (make-hash-table-eqv) #t))
        (when (find (lambda (n) (or (equal? (hash-ref n "type") "opaque")
                                   (equal? (hash-ref n "type") "hash-table")
                                   (and (equal? (hash-ref n "type") "symbol") (not (hash-ref n "interned")))))
                    (hash-ref graph "nodes"))
          (error "identity-bearing value requires native execution"))
        (hash-put! output "values" graph)))
    output))
