(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/program/admission gerbil-ascent-prepare-storage-batch)
        (only-in :gerbil-ascent/t/performance/storage-batch/reference old-prepare-storage-batch)
        :gerbil-ascent/t/performance/storage-batch/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "STORAGE-BATCH-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass? (if (eq? mode 'batch)
                  (and (<= (median bb) (- (median ab) 3800))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020)))
                  (and (<= (median bb) (+ (median ab) 512))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020)))))
      ;; Fixed before sampling: 256 accepted rows save >=3800 bytes, with
      ;; <=5%+20 us CPU regression. Controls <=512 bytes and <=5%+20 us.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "storage batch benchmark requires symmetric native modules" name))))
   '("program/admission" "program/evaluate" "t/performance/storage-batch/reference"
     "t/performance/storage-batch/reference-evaluate" "t/performance/storage-batch/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((size (if (member scenario '("single" "empty" "engine-small")) 1 256))
         (width (if (string=? scenario "wide") 8 1))
         (rows (if (string=? scenario "empty") []
                 (map (lambda (n) (map (lambda (c) (+ n c)) (iota width))) (iota size))))
         (expanded (if (string=? scenario "duplicates") (append rows rows) rows))
         (present (make-hash-table))
         (mode (if (= size 256) 'batch 'control))
         (result
          (if (member scenario '("engine" "engine-small"))
            (let (program (storage-batch-program width (lambda (_) expanded)))
              (paired scenario
                      (lambda () (storage-batch-engine-run #t program '(0)))
                      (lambda () (storage-batch-engine-run #f program '(0)))
                      (lambda (a b)
                        (unless (and (equal? (storage-batch-rows a) rows)
                                     (equal? (storage-batch-rows b) (storage-batch-rows a)))
                          (error "complete storage batch engine parity"))) 10 mode))
            (let ()
              (def (run prepare)
                (let-values (((accepted count) (prepare expanded width #f present 0 8192)))
                  (cons count accepted)))
              (paired scenario (lambda () (run old-prepare-storage-batch))
                      (lambda () (run gerbil-ascent-prepare-storage-batch))
                      (lambda (a b)
                        (unless (and (equal? a (cons (length rows) rows)) (equal? a b)
                                     (zero? (hash-length present)))
                          (error "storage preflight parity"))) 64 mode)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline 'fcb9ed1117cf597b7acdcc2c9b5895cd1bffb1c3)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "storage batch allocation/CPU gate failed" scenario)))
  (displayln "OK") (force-output))
