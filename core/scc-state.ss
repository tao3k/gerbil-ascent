;;; Generated by SccState.lean; discovery index zero remains active.
(export gerbil-ascent-scc-state)
(defrule (gerbil-ascent-scc-state index (known) unseen completed on-stack)
  (let (known index)
    (if (not known) unseen (if (eq? known #t) completed on-stack))))
