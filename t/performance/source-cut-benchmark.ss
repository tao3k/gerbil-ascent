(import :gerbil/runtime/gambit
        (only-in :std/list/list delete-duplicates/hash)
        :gerbil-ascent/program/source-cut)
(export main)

;; Transaction kernel preserved from actor-session.ss at eb4378d244a9464.
;; Its enclosing schema, pending, and input-limit become explicit arguments.
;; Actor creation, evaluation and publication are outside both timing lanes.
(def (reference-update pending positions arities replacements append? input-limit)
  (def (copy-rows name rows)
    (let (slot (hash-get positions name))
      (unless slot (error "unknown ASCENT relation" name))
      (let (width (vector-ref arities (- slot 1)))
        (unless (and (list? rows) (andmap (lambda (row) (and (list? row) (= (length row) width))) rows))
          (error "invalid ASCENT actor Session source rows" name rows))
        (map (lambda (row) (map (lambda (value) value) row)) rows))))
  (let* ((owned (map (lambda (replacement)
                      (cons (car replacement) (copy-rows (car replacement) (cdr replacement)))) replacements))
         (names (map car owned)))
    (unless (= (length names) (length (delete-duplicates/hash names)))
      (error "duplicate ASCENT actor Session replacement"))
    (let (next (map (lambda (entry)
                     (let (replacement (assq (car entry) owned))
                       (if replacement
                         (cons (car entry) (if append? (append (cdr entry) (cdr replacement)) (cdr replacement))) entry))) pending))
      (when (> (apply + (map (lambda (entry) (length (cdr entry))) next)) input-limit)
        (error "ASCENT actor Session input fact budget exceeded"))
      next)))

(def (median values) (list-ref (list-sort < values) (quotient (length values) 2)))
(def (cpu call repeats)
  (let (before (##process-statistics))
    (let loop ((n repeats) (value #f))
      (if (zero? n)
        (let (after (##process-statistics))
          (values value (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                              (+ (f64vector-ref before 0) (f64vector-ref before 1))) repeats)))
        (loop (- n 1) (call))))))
(def (allocation call repeats)
  (##gc)
  (let (before (f64vector-ref (##process-statistics) 16))
    (let loop ((n repeats) (value #f))
      (if (zero? n)
        (begin (##gc)
          (values value (/ (- (f64vector-ref (##process-statistics) 16) before) repeats)))
        (loop (- n 1) (call))))))
(def (main scenario receipt)
  (unless (member scenario '("untouched" "wide-batch" "small")) (error "invalid source-cut scenario" scenario))
  (let* ((small? (string=? scenario "small"))
         (count (if small? 1 128))
         (names (map (lambda (n) (string->symbol (string-append "r" (number->string n)))) (iota count)))
         (positions (make-hash-table-eq)) (arities (make-vector count 1))
         (sources (map (lambda (name) (cons name (map list (iota (if small? 1 512))))) names))
         (updates (map (lambda (name) (cons name '((999))))
                       (if (string=? scenario "wide-batch") names (list (car names)))))
         (limit 100000) (repeats 100))
    (for-each (lambda (name position) (hash-put! positions name (+ position 1))) names (iota count))
    (let* ((cut (gerbil-ascent-make-source-cut positions arities sources))
           (old (lambda () (reference-update sources positions arities updates #f limit)))
           (new (lambda () (gerbil-ascent-source-cut-update cut positions arities updates #f limit)))
           (parity (lambda (a b)
                     (unless (equal? (map cdr a)
                                     (map (lambda (n) (gerbil-ascent-source-cut-rows b n)) (iota count)))
                       (error "source-cut ordered rows differ"))))
           (ac []) (bc []) (ab []) (bb []) (wins 0))
      (parity (old) (new))
      ;; Fixed before sampling: large cuts save >=50% CPU, >=15% allocation,
      ;; and win >=35/50 pairs. Small control <=2 KiB and <=5% + 10 us.
      (for-each
       (lambda (lane)
         (for-each
          (lambda (sample)
            (let-values (((a x b y)
                          (if (even? sample)
                            (let-values (((a x) (lane old repeats)) ((b y) (lane new repeats))) (values a x b y))
                            (let-values (((b y) (lane new repeats)) ((a x) (lane old repeats))) (values a x b y)))))
              (parity a b)
              (if (eq? lane cpu)
                (begin (set! ac (cons x ac)) (set! bc (cons y bc)) (when (< y x) (set! wins (+ wins 1))))
                (begin (when (or (< x 0) (< y 0)) (error "invalid VM allocation delta"))
                       (set! ab (cons x ab)) (set! bb (cons y bb)))))
            (when (zero? (modulo (+ sample 1) 10))
              (displayln "SOURCE-CUT-PAIRS " scenario " " (if (eq? lane cpu) 'cpu 'allocation) " " (+ sample 1) "/50")
              (force-output))) (iota 50))) (list cpu allocation))
      (let* ((passed? (if small?
                       (and (<= (median bb) (+ (median ab) 2048))
                            (<= (median bc) (+ (* 1.05 (median ac)) 0.000010)))
                       (and (<= (median bc) (* 0.5 (median ac))) (>= wins 35)
                            (<= (median bb) (* 0.85 (median ab))))))
             (result (list scenario (cons 'baseline 'eb4378d244a94641207b6bafdbb576378170dd8f)
                           (cons 'paired-samples-per-lane 50) (cons 'passed? passed?) (cons 'cpu-wins wins)
                           (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
                           (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
                           (cons 'old-cpu ac) (cons 'new-cpu bc) (cons 'old-allocation ab) (cons 'new-allocation bb))))
        (call-with-output-file [path: receipt truncate: #t] (lambda (out) (write result out) (newline out)))
        (displayln "RESULT " scenario " " passed? " CPU-us " (* 1000000 (median ac)) " -> " (* 1000000 (median bc))
                   " bytes " (median ab) " -> " (median bb) " wins " wins) (force-output)
        (unless passed? (error "source-cut performance gate failed" scenario))
        (displayln "OK") (force-output)))))
