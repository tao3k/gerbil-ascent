(import (only-in :gerbil/runtime/hash make-hash-table-eq)
        (only-in :std/hash/misc hash-key?))
(export ascent-value-graph ascent-value-input)

;; Encoding is independent of execution. Every node retains its actual native
;; value, including opaque values and cycles; references belong to one result.
(def (ascent-value-graph root retained (owned? #f))
  (let ((seen (make-hash-table-eq)) (nodes []) (serial (hash-length retained)))
    (def (walk value)
      (cond
       ((eq? value #!void) (hash ("type" "void")))
       ((null? value) (hash ("type" "null")))
       ((boolean? value) (hash ("type" "boolean") ("value" value)))
       ((number? value)
        (when (and owned? (not (and (real? value) (= value value) (< -inf.0 value +inf.0))))
          (error "number requires native execution"))
        (hash ("type" "number") ("value" (number->string value))))
       ((char? value) (hash ("type" "character") ("value" (char->integer value))))
       (else
        (let (old (hash-get seen value))
          (if old (hash ("ref" old))
            (begin
              (set! serial (+ serial 1))
              (when (> serial 65536) (error "native graph transport bound; native result remains retained"))
              (let (id serial)
                (hash-put! seen value id)
                (hash-put! retained id value)
                (let (node
                       (cond
                        ((symbol? value) (hash ("id" id) ("type" "symbol")
                                              ("value" (symbol->string value))
                                              ("interned" (interned-symbol? value))))
                        ((string? value) (hash ("id" id) ("type" "string") ("value" value)))
                        ((pair? value) (hash ("id" id) ("type" "pair")
                                            ("car" (walk (car value))) ("cdr" (walk (cdr value)))))
                        ((vector? value) (hash ("id" id) ("type" "vector")
                                              ("items" (map walk (vector->list value)))))
                        ((u8vector? value) (hash ("id" id) ("type" "u8vector")
                                                ("items" (u8vector->list value))))
                        ((hash-table? value)
                         (let (entries [])
                           (hash-for-each (lambda (key item)
                             (set! entries (cons (list (walk key) (walk item)) entries))) value)
                           (hash ("id" id) ("type" "hash-table") ("entries" (reverse entries)))))
                        (else (hash ("id" id) ("type" "opaque")
                                    ("encoding" "native-reference-only")))))
                  (set! nodes (cons node nodes)))
                (hash ("ref" id)))))))))
    (let (encoded (walk root))
      (hash ("format" "native-value-graph.v1") ("root" encoded) ("nodes" (reverse nodes))))))

;; Native predicates and contracts validate decoded inputs, not Python.
;; Compound references are resolved by the owning session, never globally.
(def (ascent-value-input value resolve (graphs #f))
  (if (and (hash-table? value) (hash-key? value "type"))
    (let ((kind (hash-ref value "type")) (item (hash-ref value "value" #f)))
      (cond
       ((equal? kind "string") (unless (string? item) (error "invalid string")) item)
       ((equal? kind "symbol") (unless (string? item) (error "invalid symbol")) (string->symbol item))
       ((equal? kind "number") (or (and (string? item) (string->number item)) (error "invalid number")))
       ((equal? kind "character") (unless (and (exact-integer? item) (<= 0 item #x10ffff)) (error "invalid character")) (integer->char item))
       ((equal? kind "vector") (unless (list? item) (error "invalid vector"))
        (list->vector (map (lambda (v) (ascent-value-input v resolve graphs)) item)))
       ((equal? kind "u8vector") (unless (and (list? item) (andmap (lambda (v) (and (exact-integer? v) (<= 0 v 255))) item)) (error "invalid bytes")) (list->u8vector item))
       ((equal? kind "pair")
        (cons (ascent-value-input (hash-ref value "car") resolve graphs)
              (ascent-value-input (hash-ref value "cdr") resolve graphs)))
       ((or (equal? kind "reference") (equal? kind "source-reference") (equal? kind "module-reference")) (resolve value))
       ((equal? kind "graph")
        (let* ((namespace (hash-ref value "namespace" #f))
               (cache (and graphs namespace (not (equal? namespace '(0 0)))
                         (or (hash-get graphs namespace)
                             (let (cache (vector (make-hash-table-eqv) (make-hash-table-eqv)))
                               (hash-put! graphs namespace cache) cache)))))
          (ascent-input-graph item cache)))
       (else (error "unsupported native input encoding"))))
    (if (list? value) (map (lambda (v) (ascent-value-input v resolve graphs)) value) value)))

;; Owned structural values cross as typed graphs, with an allocation pass before
;; wiring edges. Arbitrary objects can only cross by an owner-checked reference.
(def (ascent-input-graph graph (cache #f))
  (unless (equal? (hash-ref graph "format") "native-value-graph.v1")
    (error "invalid owned graph format"))
  (let ((objects (if cache (vector-ref cache 0) (make-hash-table-eqv)))
        (definitions (if cache (vector-ref cache 1) (make-hash-table-eqv)))
        (seen (make-hash-table-eqv)) (nodes (hash-ref graph "nodes")))
    (unless (and (list? nodes) (<= (length nodes) 65536)) (error "owned graph node bound"))
    (def (item value)
      (if (hash-key? value "ref")
        (hash-ref objects (hash-ref value "ref"))
        (let ((kind (hash-ref value "type")) (v (hash-ref value "value" #f)))
          (cond
           ((equal? kind "void") (void))
           ((equal? kind "null") [])
           ((equal? kind "boolean") (unless (boolean? v) (error "invalid graph boolean")) v)
           ((equal? kind "number") (or (and (string? v) (string->number v)) (error "invalid graph number")))
           ((equal? kind "character") (integer->char v))
           (else (error "invalid graph scalar"))))))
    (for-each (lambda (node)
      (let ((id (hash-ref node "id")) (kind (hash-ref node "type")))
        (unless (and (exact-integer? id) (> id 0) (not (hash-key? seen id)))
          (error "duplicate or invalid owned graph node"))
        (hash-put! seen id #t)
        (when (and (hash-key? definitions id) (not (equal? (hash-ref definitions id) node)))
          (error "conflicting owned graph identity"))
        (hash-put! definitions id node)
        (unless (hash-key? objects id)
        (hash-put! objects id
          (cond
           ((equal? kind "pair") (cons #f #f))
           ((equal? kind "vector") (make-vector (length (hash-ref node "items"))))
           ((equal? kind "string") (string-copy (hash-ref node "value")))
           ((equal? kind "symbol")
            (unless (hash-ref node "interned") (error "uninterned symbol requires native reference"))
            (string->symbol (hash-ref node "value")))
           ((equal? kind "u8vector")
            (let (bytes (hash-ref node "items"))
              (unless (andmap (lambda (v) (and (exact-integer? v) (<= 0 v 255))) bytes)
                (error "invalid owned bytes"))
              (list->u8vector bytes)))
           (else (error "opaque value requires native reference"))))))) nodes)
    (for-each (lambda (node)
      (let ((object (hash-ref objects (hash-ref node "id"))) (kind (hash-ref node "type")))
        (cond
         ((equal? kind "pair")
          (set-car! object (item (hash-ref node "car")))
          (set-cdr! object (item (hash-ref node "cdr"))))
         ((equal? kind "vector")
          (let loop ((values (hash-ref node "items")) (index 0))
            (unless (null? values)
              (vector-set! object index (item (car values)))
              (loop (cdr values) (+ index 1)))))))) nodes)
    (item (hash-ref graph "root"))))
