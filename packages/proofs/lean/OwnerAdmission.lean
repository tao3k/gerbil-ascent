ntries)))\n          (error \"invalid typed table entries\"))\n        (let ((out (make-hash-table)))\n          (let loop ((i 0))\n            (if (= i (vector-length entries)) out\n              (begin\n                (hash-put! out (vector-ref entries i) (vector-ref entries (+ i 1)))\n                (loop (+ i 2)))))))))\n  (define checkpoint (c-lambda (int64 int64 int64) int \"___return(ascent_check_fn ? ascent_check_fn(___arg1, ___arg2, ___arg3) : 5);\"))\n  (c-define (invoke request) (int64) int64 \"ascent_hybrid_call\" \"extern\"\n    (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call request\n      gerbil-ascent/interface/hybrid#invoke)))\n"

def ownerSourceSchemeSource : String :=
  ";;; -*- Gerbil -*-\n;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors\n;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later\n(import :gerbil/expander\n        (only-in :gerbil-ascent/program/scheme-checked relational-scalar? relational-operator-description)\n        \"../rules/declaration.ss\"\n        (only-in \"closed-evidence.ss\" ascent-closed-evidence-scope)\n        (only-in :gerbil/runtime/init gerbil-load-expander!)\n        (only-in :std/hash/misc hash-key?)\n        (only-in :gerbil/runtime/gambit current-readtable\n                 readtable-eval-allowed?-set readtable-sharing-allowed?-set)\n        (only-in :clan/poo/object .ref))\n(export ascent-load-rule-module ascent-load-evidence-source ascent-load-module-source ascent-load-evidence-components ascent-rule-module\n        rule-module? rule-module-program rule-module-explain rule-module-bindings\n        ascent-rule-module-descriptors ascent-source-scope-count ascent-prepare-source-context!)\n\n(def (ascent-rule-module-descriptors program (bindings []))\n  (def (kind predicate)\n    (cond ((eq? predicate symbol?) \"symbol\")\n          ((eq? predicate exact-integer?) \"integer\")\n          ((eq? predicate boolean?) \"boolean\")\n          ((eq? predicate string?) \"string\")\n          ((eq? predicate relational-scalar?) \"scalar\")\n          (else \"native\")))\n  (def (column predicate)\n    (let (description (relational-operator-description predicate))\n      (if (and description (eq? (vector-ref description 0) 'domain))\n        (hash (\"kind\" \"scalar\")\n              (\"domain\" (map (lambda (v)\n                    (cond ((symbol? v) (hash (\"type\" \"symbol\") (\"value\" (symbol->string v))))\n                          ((char? v) (hash (\"type\" \"graph\") (\"value\"\n                              (hash (\"root\" (hash (\"type\" \"character\") (\"value\" (char->integer v)))) (\"nodes\" [])))))\n                          (else v))) (vector-ref description 1))))\n        (hash (\"kind\" (kind predicate))))))\n  (let (sources (.ref program 'source-handles))\n    (unless (andmap (lambda (b) (memq (cdr b) (map (cut .ref <> 'name) (.ref program 'relations)))) bindings)\n      (error \"Evidence binding does not name a native relation\"))\n    (map (lambda (relation)\n           (let* ((n (.ref relation 'name))\n                  (binding (find (lambda (b) (eq? (cdr b) n)) bindings)))\n             (hash (\"name\" (symbol->string (if binding (car binding) n)))\n                   (\"columns\" (let (predicates (.ref relation 'field-predicates))\n                     (if (pair? predicates)\n                       (map column predicates)\n                       (make-list (.ref relation 'arity) (hash (\"kind\" \"native\"))))))\n                   (\"source\" (and (memq n sources) #t)))))\n         (.ref program 'relations))))\n\n;; Modules are trusted host code, built by build.ss, not inert rule documents.\n;; The constructor runs with the module's native lexical/macro environment.\n(def (ascent-load-rule-module module constructor arguments)\n  (unless (and (string? module) (string-prefix? \":\" module)\n               (<= (string-length module) 4096)\n               (string? constructor) (< 0 (string-length constructor) 129)\n               (list? arguments))\n    (error \"invalid native Evidence module entry\"))\n  ;; Match Gerbil's gxtest/gxprof: load/evaluate the module using its official\n  ;; importer, resolve only a public phase-zero export, then read its\n  ;; current runtime binding. No synthetic imports or cached exported values.\n  (gerbil-load-expander!)\n  (let* ((context (import-module (string->symbol module) #f #t))\n         (name (string->symbol constructor))\n         (export (find (lambda (out)\n                         (and (= (module-export-phi out) 0)\n                              (eq? (module-export-name out) name)))\n                       (module-context-export context))))\n    (unless export (error \"module does not export symbol\" module name))\n    (let (binding (core-resolve-module-export export))\n      (let (builder (eval (binding-id binding)))\n        (unless (procedure? builder) (error \"Evidence constructor is not callable\"))\n        (apply builder arguments)))))\n\n\n(def source-module-loads 0)\n(def source-core-context #f)\n(def (make-source-context)\n  (gerbil-load-expander!)\n  (unless source-core-context\n    (let (context (make-top-context))\n      (parameterize ((current-expander-context context))\n        (eval-syntax '(import :gerbil/core))\n        (eval-syntax '(import :gerbil-ascent/rules/interface\n                              :gerbil-ascent/rules/module\n                              (only-in :clan/poo/object .ref))))\n      (set! source-core-context context)))\n  ;; Each declaration has a fresh module namespace and private gensym aliases.\n  ;; Reuse the import context; it does not own the user's lexical definitions.\n  source-core-context)\n(def (ascent-prepare-source-context!)\n  ;; Fixed library metadata belongs to owner readiness, not the first caller's\n  ;; declaration. This creates no user scope and retains no caller definitions.\n  (make-source-context)\n  (void))\n(def (ascent-source-scope-count) source-module-loads)\n;; Expansion can retain global bindings. Optional caller ceilings cover all\n;; runtime admissions, including failed expansions; closing does not reclaim them.\n(def (check-source-scopes count ceiling)\n  (unless (or (not ceiling) (and (exact-integer? ceiling) (> ceiling 0)))\n    (error \"source scope ceiling must be a positive integer\"))\n  (when (and ceiling (> (+ source-module-loads count) ceiling))\n    (error \"source module runtime load limit\")))\n(def (ascent-load-evidence-source source trusted (ceiling #f))\n  (load-evidence-scope source trusted #f (gensym 'ascent-source) [] #t ceiling))\n(def (ascent-load-module-source source trusted (ceiling #f))\n  (load-evidence-scope source trusted #f (gensym 'ascent-module) [] [] ceiling #t))\n\n(def (load-evidence-scope source trusted context namespace imports exports ceiling (module-source? #f))\n  (unless (and (eq? trusted #t) (string? source)\n               (<= (u8vector-length (string->utf8 source)) 262144))\n    (error \"explicit trusted host Scheme authorization and Evidence DSL required\"))\n  (check-source-scopes 1 ceiling)\n  (let* ((forms\n          (parameterize ((current-readtable\n                          (readtable-sharing-allowed?-set\n                            (readtable-eval-allowed?-set (current-readtable) #f) #f)))\n            (call-with-input-string source\n              (lambda (port)\n                (let loop ((forms []) (nodes 0))\n                  (let (form (read port))\n                    (if (eof-object? form) (reverse forms)\n                      (let ()\n                        (unless (and (< (length forms) 256) (list? form) (pair? form)\n                                     (not (memq (car form) (if module-source? '(module) '(import export module)))))\n                          (error \"Evidence definitions required; module/import/build scaffolding belongs to the Library\"))\n                        (def (visit value depth)\n                          (set! nodes (+ nodes 1))\n                          (unless (and (<= nodes 65536) (<= depth 128))\n                            (error \"native module source structure bound\"))\n                          (when (pair? value)\n                            (visit (car value) (+ depth 1)) (visit (cdr value) depth)))\n                        (visit form 0)\n                        (loop (cons form forms) nodes)))))))))\n         (aliases (make-hash-table-eq)))\n    (unless (pair? forms) (error \"Evidence DSL definitions required\"))\n    (set! source-module-loads (+ source-module-loads 1))\n    (or (and (null? imports) (ascent-closed-evidence-scope forms exports))\n        (let ()\n    (gerbil-load-expander!)\n    (unless context (set! context (make-sourc