(import (only-in :std/test check test-case test-suite)
        (only-in :std/list/list append-map)
        (only-in :gerbil/runtime/gambit call-with-output-string display-exception)
        (only-in :std/sync/completion make-completion completion-wait! completion-post!)
        (only-in :gerbil-ascent/core/execution-control current-ascent-execution-control)
        (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/core/dependency-graph
                 gerbil-ascent-graph-components/borrowed gerbil-ascent-graph-components/packed)
        (only-in :gerbil-ascent/program/func gerbil-ascent-program gerbil-ascent-relation
                 gerbil-ascent-variable gerbil-ascent-rule gerbil-ascent-atom)
        (only-in :gerbil-ascent/program/session gerbil-ascent-session-run
                 gerbil-ascent-session-append-source! gerbil-ascent-session-replace-source!)
        (only-in :gerbil-ascent/program/actor-session gerbil-ascent-open-condensed-actor-session
                 gerbil-ascent-session-cancel! gerbil-ascent-session-state gerbil-ascent-session-edit-edge!
                 gerbil-ascent-session-last-completed gerbil-ascent-session-close!
                 gerbil-ascent-session-open-integer-pages gerbil-ascent-session-pull-integer-page!)
        (only-in :gerbil-ascent/program/condensed-closure condensed-witness-vertices))
(export ascent-condensed-session-test)

(def (program edges input-budget derived-budget output-budget)
  (let ((x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)) (z (gerbil-ascent-variable 'z)))
    (gerbil-ascent-program
      (list (gerbil-ascent-relation 'edge 2 edges) (gerbil-ascent-relation 'reach 2 []))
      (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list x y)))
              (list (gerbil-ascent-atom 'edge (list x y))))
            (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list x z)))
              (list (gerbil-ascent-atom 'reach (list x y)) (gerbil-ascent-atom 'edge (list y z)))))
      input-budget derived-budget output-budget)))

(def (cycle width offset)
  (map (lambda (v) (list (+ offset v) (+ offset (modulo (+ v 1) width)))) (iota width)))

(def (interleaved-cliques first-bridge? second-bridge?)
  (let ((vertices (iota 20)) (edges []))
    (for-each
      (lambda (left)
        (for-each
          (lambda (right)
            (when (or (and (not (= left right)) (= (modulo left 2) (modulo right 2)))
                      (and first-bridge? (= left 18) (= right 1))
                      (and second-bridge? (= left 16) (= right 3)))
              (set! edges (cons (list left right) edges))))
          vertices))
      vertices)
    (reverse! edges)))

(def (closure-oracle width edges)
  (let ((matrix (make-vector width 0)) (vertices (iota width)))
    (for-each (lambda (row)
                (vector-set! matrix (car row)
                  (bitwise-ior (vector-ref matrix (car row)) (arithmetic-shift 1 (cadr row)))))
              edges)
    (for-each (lambda (k)
                (for-each (lambda (v)
                            (when (bit-set? k (vector-ref matrix v))
                              (vector-set! matrix v (bitwise-ior (vector-ref matrix v) (vector-ref matrix k)))))
                          vertices))
              vertices)
    (let (rows [])
      (for-each (lambda (v)
                  (for-each (lambda (w)
                              (when (bit-set? w (vector-ref matrix v)) (set! rows (cons (list v w) rows))))
                            vertices))
                vertices)
      (reverse! rows))))

(def (rows result) ((.ref result 'rows-of) 'reach))
(def (witness result from to budget) ((.ref result 'closure-witness) from to budget))
(def (replay result proof) ((.ref result 'verify-closure-witness) proof))

(def (selected-rows result columns key)
  (let (selected [])
    ((.ref result 'visit-rows) 'reach columns key
      (lambda (row) (set! selected (cons row selected))))
    (reverse! selected)))

(def (check-right-column result oracle labels)
  (for-each
    (lambda (target)
      (check (selected-rows result '(1) (list target))
        => (filter (lambda (row) (equal? (cadr row) target)) oracle)))
    labels))

(def (check-result result expected update)
  (check (.ref result 'finished) => #t)
  (check (.ref result 'evaluation-path) => 'condensed-closure)
  (check (.ref result 'closure-update) => update)
  (check (rows result) => expected))

(def (edit-edge session result operation left right)
  (gerbil-ascent-session-edit-edge! session result 'edge operation left right))

(def (refused? thunk)
  (with-catch (lambda (_) #t) (lambda () (thunk) #f)))

(def (active-run session)
  (let loop ((remaining 10000))
    (cond ((eq? (cadr (gerbil-ascent-session-state session)) 'running) (void))
          ((zero? remaining) (error "condensed Session did not start"))
          (else (thread-yield!) (loop (- remaining 1))))))

(def ascent-condensed-session-test
  (test-suite "Versioned condensed binary closure in an Actor Session"
    (test-case "paged SCC output interleaves component members in public order"
      (let* ((edges (interleaved-cliques #t #f))
             (session (gerbil-ascent-open-condensed-actor-session (program edges 512 512 1024)))
             (expected (closure-oracle 20 edges))
             (buffer (make-s64vector 14)))
        (try
          (let* ((result (gerbil-ascent-session-run session))
                 (proof (witness result 0 1 512))
                 (cursor (gerbil-ascent-session-open-integer-pages session 'reach 7 (length expected))))
            (check (replay result proof) => #t)
            (let pull ((rest expected))
              (let (n (gerbil-ascent-session-pull-integer-page! session cursor buffer))
                (check n => (min 7 (length rest)))
                (unless (zero? n)
                  (let compare ((i 0) (rest rest))
                    (if (= i n) (pull rest)
                      (begin
                        (check (list (s64vector-ref buffer (* 2 i))
                                     (s64vector-ref buffer (+ 1 (* 2 i)))) => (car rest))
                        (compare (+ i 1) (cdr rest))))))))
            (let ((next (edit-edge session result 'delete 18 1))
                  (last (s64vector-copy buffer)))
              (check (rows next) => (closure-oracle 20 (interleaved-cliques #f #f)))
              (check (replay next proof) => #f)
              (check (replay result proof) => #t)
              (check (refused? (lambda () (gerbil-ascent-session-pull-integer-page! session cursor buffer))) => #t)
              (check (equal? buffer last) => #t)))
          (finally (gerbil-ascent-session-close! session)))))

    (test-case "borrowed SCCs match independent reachability and quotient order"
      (for-each
       (lambda (mask)
         (let ((adjacent (make-vector 3 [])) (edges []))
           (for-each
            (lambda (bit)
              (when (bit-set? bit mask)
                (let ((a (quotient bit 3)) (b (modulo bit 3)))
                  (set! edges (cons (list a b) edges))
                  (vector-set! adjacent a (cons b (vector-ref adjacent a))))))
            (iota 9))
           (let* ((saved (vector-copy adjacent))
                  (groups (gerbil-ascent-graph-components/borrowed adjacent void))
                  (packed (vector-map list->u16vector adjacent))
                  (owner (make-vector 3 #f))
                  (reached (closure-oracle 3 edges)))
             (check (gerbil-ascent-graph-components/packed packed void) => groups)
             (for-each
              (lambda (subset)
                (check (gerbil-ascent-graph-components/packed packed void subset)
                       => (gerbil-ascent-graph-components/borrowed adjacent void subset)))
              '(() (0) (1) (2) (0 1) (0 2) (1 2) (0 1 2)))
             (for-each
              (lambda (group rank)
                (for-each (lambda (v)
                            (check (vector-ref owner v) => #f)
                            (vector-set! owner v rank))
                          group))
              groups (iota (length groups)))
             (for-each (lambda (v) (check (eq? (vector-ref saved v) (vector-ref adjacent v)) => #t))
                       (iota 3))
             (for-each
              (lambda (a)
                (for-each
                 (lambda (b)
                   (let ((x (vector-ref owner a)) (y (vector-ref owner b)))
                     (check (and (fixnum? x) (fixnum? y)) => #t)
                     (check (= x y)
                            => (or (= a b) (and (member (list a b) reached)
                                                (member (list b a) reached) #t)))
                     (when (member (list a b) edges)
                       (check (<= x y) => #t))))
                 (iota 3)))
              (iota 3)))))
       (iota 512)))
    (test-case "every borrowed traversal checkpoint can refuse without editing adjacency"
      (let* ((adjacent (vector (list 1 1 2) (list 2) (list 0 3) (list 3)))
             (saved (vector-copy adjacent))
             (steps 0)
             (groups (gerbil-ascent-graph-components/borrowed adjacent
                       (lambda () (set! steps (+ steps 1))))))
        (check (map (lambda (group) (list-sort < group)) groups) => '((0 1 2) (3)))
        (for-each
         (lambda (stop)
           (let ((at 0) (cause (list 'stop)))
             (check (eq? cause
                      (with-catch values
                        (lambda ()
                          (gerbil-ascent-graph-components/borrowed adjacent
                            (lambda ()
                              (set! at (+ at 1))
                              (when (= at stop) (raise cause))))))) => #t)
             (for-each
              (lambda (v) (check (eq? (vector-ref saved v) (vector-ref adjacent v)) => #t))
              (iota 4))))
         (iota steps 1))))
    (test-case "Reuse and delta append keep the exact rows and isolate older versions"
      (let* ((edges (append (cycle 20 0) (cycle 20 20)))
             (joined (append edges '((19 20))))
             (merged (append joined '((39 0))))
             (session (gerbil-ascent-open-condensed-actor-session (program edges 64 1600 1700))))
        (try
          (let* ((first (gerbil-ascent-session-run session))
                 (first-proof (witness first 0 0 40)))
            (check-result first (closure-oracle 40 edges) 'rebuilt)
            (check (replay first first-proof) => #t)
            (check (witness first 0 39 200) => #f)
            (check (selected-rows first '(0 1) '(19 20)) => [])
            (let (again (gerbil-ascent-session-run session))
              (check-result again (closure-oracle 40 edges) 'reused)
              (check (replay again first-proof) => #f))
            (gerbil-ascent-session-append-source! session 'edge '(19 20))
            (let* ((second (gerbil-ascent-session-run session))
                   (proof (witness second 19 20 32))
                   (selected []))
              (check-result second (closure-oracle 40 joined) 'appended)
              (check (condensed-witness-vertices proof) => '(19 20))
              (check (witness second 19 20 0) => #f)
              (check (replay second proof) => #t)
              (let (vertices (condensed-witness-vertices proof))
                (set-car! vertices -1)
                (check (replay second proof) => #t))
              (check (replay first proof) => #f)
              (check (selected-rows second '(0 1) '(19 20)) => '((19 20)))
              (check (selected-rows second '(1 0) '(20 19)) => '((19 20)))
              (check (selected-rows second '(0 1) '(19 20.0)) => [])
              (check (selected-rows second '(0 1) '(19 40)) => [])
              (check (selected-rows second '(0 1 0) '(19 20 18)) => [])
              ((.ref second 'visit-rows) 'reach '(0 1 0) '(19 20 19)
                (lambda (a b) (set! selected (cons (list a b) selected))) fields?: #t)
              (check selected => '((19 20)))
              (let ((key (list 19 20)) (delivered []))
                ((.ref second 'visit-rows) 'reach '(0 1) key
                  (lambda (left right)
                    (set! delivered (cons (list left right) delivered))
                    (when (= right 20) (set-car! (cdr key) 22)))
                  fields?: #t)
                (check (reverse! delivered) => '((19 20) (19 22))))
              (let ((columns (list 0 1)) (delivered []))
                ((.ref second 'visit-rows) 'reach columns '(19 19)
                  (lambda (row)
                    (set! delivered (cons row delivered))
                    (when (= (cadr row) 19) (set-car! (cdr columns) 0))))
                (check (reverse! delivered) =>
                  (map (lambda (i) (list 19 (+ 19 i))) (iota 21))))
              (let (copy (rows second))
                (set-car! (car copy) -1)
                (set-cdr! copy []))
              (check (rows second) => (closure-oracle 40 joined)))
            (gerbil-ascent-session-append-source! session 'edge '(39 0))
            (let* ((third (gerbil-ascent-session-run session))
                   (bridge (witness third 39 0 32)))
              (check-result third (closure-oracle 40 merged) 'rebuilt)
              (check (replay third bridge) => #t)
              (gerbil-ascent-session-replace-source! session 'edge joined)
              (let (split (gerbil-ascent-session-run session))
                (check-result split (closure-oracle 40 joined) 'rebuilt)
                (check (witness split 39 0 100) => #f)
                (check (selected-rows split '(1 0) '(0 39)) => [])
                (check (selected-rows third '(1 0) '(0 39)) => '((39 0)))
                (check (replay split bridge) => #f)
                (check (replay third bridge) => #t)
                (check (rows third) => (closure-oracle 40 merged)))))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Packed cross edits retain alternate paths and independently ordered versions"
      (let* ((both (interleaved-cliques #t #t))
             (one (interleaved-cliques #t #f))
             (neither (interleaved-cliques #f #f))
             (session (gerbil-ascent-open-condensed-actor-session (program both 190 400 600))))
        (try
          (let* ((original (gerbil-ascent-session-run session))
                 (old-proof (witness original 18 1 200)))
            (check (replay original old-proof) => #t)
            (gerbil-ascent-session-replace-source! session 'edge one)
            (let (remaining (gerbil-ascent-session-run session))
              (check (selected-rows remaining '(0 1) '(16 3)) => '((16 3)))
              (check (selected-rows remaining '(0) '(18))
                => (map (lambda (right) (list 18 right)) (iota 20)))
              (let ((key (list 18)) (delivered []))
                ((.ref remaining 'visit-rows) 'reach '(0) key
                  (lambda (left right)
                    (set! delivered (cons (list left right) delivered))
                    (set-car! key 16))
                  fields?: #t)
                (check delivered => '((18 0))))
              (check-right-column remaining (closure-oracle 20 one) (cons -1 (iota 20)))
              (let ((key (list 1)) (delivered []))
                ((.ref remaining 'visit-rows) 'reach '(1) key
                  (lambda (left right)
                    (set! delivered (cons (list left right) delivered))
                    (set-car! key 2))
                  fields?: #t)
                (check (reverse! delivered)
                  => (cons '(0 1) (map (lambda (i) (list (* 2 i) 2)) (iota 10)))))
              (check-result remaining (closure-oracle 20 one) 'removed))
            (gerbil-ascent-session-replace-source! session 'edge neither)
            (let (separated (gerbil-ascent-session-run session))
              (check (selected-rows separated '(0 1) '(18 1)) => [])
              (check (selected-rows separated '(0) '(18))
                => (map (lambda (i) (list 18 (* 2 i))) (iota 10)))
              (check (replay separated old-proof) => #f)
              (check-right-column separated (closure-oracle 20 neither) '(0 1 2 19))
              (check-result separated (closure-oracle 20 neither) 'removed))
            (gerbil-ascent-session-replace-source! session 'edge one)
            (let* ((restored (gerbil-ascent-session-run session))
                   (new-proof (witness restored 18 1 200)))
              (check (witness restored 18 1 1) => #f)
              (check (condensed-witness-vertices new-proof) => (condensed-witness-vertices old-proof))
              (check (replay restored new-proof) => #t)
              (check (replay restored old-proof) => #f)
              (check-right-column restored (closure-oracle 20 one) '(0 1 2 19))
              (check-result restored (closure-oracle 20 one) 'inserted))
            (check (replay original old-proof) => #t)
            (check-result original (closure-oracle 20 both) 'rebuilt))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Direct masks preserve singleton loops and combine redundant cross edges"
      (let* ((edges (append (cycle 32 0) '((0 32) (31 32) (32 32) (32 33))))
             (session (gerbil-ascent-open-condensed-actor-session (program edges 40 1200 1240))))
        (try
          (let (result (gerbil-ascent-session-run session))
            (check-result result (closure-oracle 34 edges) 'rebuilt)
            (check (selected-rows result '(0 1) '(32 32)) => '((32 32)))
            (check (selected-rows result '(0 1) '(33 33)) => [])
            (check-right-column result (closure-oracle 34 edges) '(0 32 33 33.0 34))
            (check (replay result (witness result 30 33 8)) => #t))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Packed intra-component edits split and merge without changing old witnesses"
      (let* ((linked (filter (lambda (row)
                              (or (not (memv 19 row))
                                  (equal? row '(17 19)) (equal? row '(19 17))))
                            (interleaved-cliques #f #f)))
             (split (filter (lambda (row) (not (equal? row '(19 17)))) linked))
             (session (gerbil-ascent-open-condensed-actor-session (program linked 190 400 600))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (proof (witness prior 19 1 200)))
            (check (replay prior proof) => #t)
            (gerbil-ascent-session-replace-source! session 'edge split)
            (let (next (gerbil-ascent-session-run session))
              (check-result next (closure-oracle 20 split) 'rebuilt)
              (check (selected-rows next '(0 1) '(19 1)) => [])
              (check (replay next proof) => #f)
              (check (replay prior proof) => #t)
              (gerbil-ascent-session-replace-source! session 'edge linked)
              (let* ((restored (gerbil-ascent-session-run session))
                     (fresh (witness restored 19 1 200)))
                (check-result restored (closure-oracle 20 linked) 'rebuilt)
                (check (replay restored proof) => #f)
                (check (replay restored fresh) => #t)
                (check (condensed-witness-vertices fresh) => (condensed-witness-vertices proof)))))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Versioned edits match the full oracle across an interleaved quotient"
      (let* ((base (append (cycle 12 0) (cycle 12 12) (cycle 12 24)
                           (cycle 12 36) (cycle 12 48)
                           '((1 12) (2 24) (13 36) (25 37) (27 48))))
             (session (gerbil-ascent-open-condensed-actor-session (program base 80 3600 3680))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (bridge '(47 12))
                 (joined (append base (list bridge)))
                 (merged (edit-edge session prior 'insert 47 12))
                 (proof (witness merged 47 12 8)))
            (check-result prior (closure-oracle 60 base) 'rebuilt)
            (check-result merged (closure-oracle 60 joined) 'merged-local)
            (check (replay merged proof) => #t)
            (check (refused? (lambda () (edit-edge session prior 'insert 14 39))) => #t)
            (check (refused? (lambda () (edit-edge session merged 'insert 47 12))) => #t)
            (check (refused? (lambda () (edit-edge session merged 'delete 47 13))) => #t)
            (check (refused? (lambda () (edit-edge session merged 'insert 60 12))) => #t)
            (check (eq? (gerbil-ascent-session-last-completed session) merged) => #t)
            (let* ((split (edit-edge session merged 'delete 47 12))
                   (without-first (cdr base))
                   (removed (edit-edge session split 'delete 0 1))
                   (ordered (append without-first '((0 1))))
                   (restored (edit-edge session removed 'insert 0 1)))
              (check-result split (closure-oracle 60 base) 'split-local)
              (check-right-column split (closure-oracle 60 base) '(12 37 48))
              (check-right-column merged (closure-oracle 60 joined) '(12 37 48))
              (check-result removed (closure-oracle 60 without-first) 'split-local)
              (check-result restored (closure-oracle 60 ordered) 'merged-local)
              (check (replay split proof) => #f)
              (check (replay merged proof) => #t)
              (check ((.ref prior 'rows-of) 'edge) => base)
              (check ((.ref merged 'rows-of) 'edge) => joined)
              (check ((.ref split 'rows-of) 'edge) => base)
              (check ((.ref removed 'rows-of) 'edge) => without-first)
              (check ((.ref restored 'rows-of) 'edge) => ordered)
              (set-car! (car ((.ref restored 'rows-of) 'edge)) -1)
              (check ((.ref restored 'rows-of) 'edge) => ordered)
              (check
               ((.ref restored 'with-ordered-binary-fields) 'edge
                 (lambda (count _ copy!)
                   (let (buffer (make-s64vector (+ 1 (* 2 count)) -1))
                     (check (refused? (lambda () (copy! buffer 2))) => #t)
                     (check (s64vector-ref buffer 1) => -1)
                     (copy! buffer 1)
                     (check (s64vector->list buffer) => (cons -1 (apply append ordered)))
                     #t))
                 #t)
               => #t)
              (check (selected-rows restored '(0 1) '(47 12)) => [])))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Cold split preserves interleaved quotient rows and held witnesses"
      (let* ((split-edges (interleaved-cliques #t #t))
             (intact (append split-edges '((19 0))))
             (expected (closure-oracle 20 split-edges))
             (session (gerbil-ascent-open-condensed-actor-session (program intact 192 400 600))))
        (try
          (let* ((original (gerbil-ascent-session-run session))
                 (old-proof (witness original 19 0 200))
                 (split (edit-edge session original 'delete 19 0))
                 (new-proof (witness split 18 1 200)))
            (check-result split expected 'split-local)
            (check-right-column split expected (iota 20))
            (check (replay original old-proof) => #t)
            (check (replay split old-proof) => #f)
            (check (replay split new-proof) => #t))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Cold split handles capture overflow and singleton self bits"
      (let* ((vertices (iota 40))
             (acyclic (append
                        (append-map (lambda (left)
                                      (map (lambda (right) (list left right))
                                        (filter (lambda (right) (< left right)) vertices)))
                          vertices)
                        '((0 0) (39 39))))
             (intact (append acyclic '((39 0))))
             (expected (closure-oracle 40 acyclic))
             (session (gerbil-ascent-open-condensed-actor-session (program intact 800 1600 2400))))
        (try
          (let* ((original (gerbil-ascent-session-run session))
                 (split (edit-edge session original 'delete 39 0)))
            (check-result split expected 'split-local)
            (check (selected-rows split '(0 1) '(0 0)) => '((0 0)))
            (check (selected-rows split '(0 1) '(1 1)) => [])
            (check-right-column split expected vertices))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "A merging insertion can be undone only against its current version"
      (let* ((base (append (cycle 16 0) (cycle 16 16) '((15 16))))
             (expected (closure-oracle 32 base))
             (session (gerbil-ascent-open-condensed-actor-session (program base 40 1100 1200))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (before (witness prior 15 16 8))
                 (joined (edit-edge session prior 'insert 31 0))
                 (bridge (witness joined 31 0 8))
                 (charged 0))
            (check
             (refused?
              (lambda ()
                (parameterize ((current-ascent-execution-control
                                (lambda (work _)
                                  (set! charged (+ charged work))
                                  (when (> charged 20) (error "work refused")))))
                  (edit-edge session joined 'delete 31 0))))
             => #t)
            (check (> charged 20) => #t)
            (check (eq? joined (gerbil-ascent-session-last-completed session)) => #t)
            (let* ((split (edit-edge session joined 'delete 31 0))
                   (after (witness split 15 16 8))
                   (rejoined (edit-edge session split 'insert 31 0))
                   (redundant (edit-edge session rejoined 'insert 30 0))
                   (still-joined (edit-edge session redundant 'delete 31 0))
                   (last-split (edit-edge session still-joined 'delete 30 0)))
              (check-result split expected 'split-local)
              (check (condensed-witness-vertices after) => (condensed-witness-vertices before))
              (check (replay split after) => #t)
              (check (replay split before) => #f)
              (check (replay split bridge) => #f)
              (check (replay prior before) => #t)
              (check (replay joined bridge) => #t)
              (check (witness split 31 0 128) => #f)
              (check-right-column split expected '(0 16 31))
              (check-result still-joined (closure-oracle 32 (append base '((30 0)))) 'removed)
              (check (replay still-joined (witness still-joined 31 0 128)) => #t)
              (check-result last-split expected 'split-local)))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Packed successors preserve witness order and the exact probe budget"
      (let* ((base 100000)
             (edges (append (cycle 32 base)
                      '((100000 100008) (100000 100016) (100008 100024) (100016 100024))))
             (session (gerbil-ascent-open-condensed-actor-session (program edges 40 1024 1064))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (first (witness prior 100000 100024 6))
                 (removed (edit-edge session prior 'delete 100000 100008))
                 (second (witness removed 100000 100024 5))
                 (restored (edit-edge session removed 'insert 100000 100008)))
            (check (witness prior 100000 100024 5) => #f)
            (check (condensed-witness-vertices first) => '(100000 100008 100024))
            (check (witness removed 100000 100024 4) => #f)
            (check (condensed-witness-vertices second) => '(100000 100016 100024))
            (check (condensed-witness-vertices (witness restored 100000 100024 6))
                   => '(100000 100008 100024))
            (check (replay prior first) => #t)
            (check (replay removed first) => #f)
            (check (replay restored second) => #f))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "An edited cut can reuse an index below the cold admission threshold"
      (let* ((edges (cycle 32 0))
             (session (gerbil-ascent-open-condensed-actor-session (program edges 32 1024 1056))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (split (edit-edge session prior 'delete 31 0))
                 (without-return (filter (lambda (row) (not (equal? row '(31 0)))) edges))
                 (self (edit-edge session split 'insert 31 31))
                 (without-self (edit-edge session self 'delete 31 31))
                 (still-split (gerbil-ascent-session-run session))
                 (restored (edit-edge session still-split 'insert 31 0)))
            (check-result split (closure-oracle 32 without-return) 'split-local)
            (check-result self (closure-oracle 32 (append without-return '((31 31)))) 'inserted)
            (check-result without-self (rows split) 'removed)
            (check-result still-split (rows split) 'reused)
            (check-result restored (closure-oracle 32 edges) 'merged-local))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Versioned edge edits keep the cut on each fact limit"
      (let* ((base (append (cycle 16 0) (cycle 16 16) '((15 16))))
             (expected (closure-oracle 32 base)))
        (for-each
         (lambda (limits)
           (let (session (gerbil-ascent-open-condensed-actor-session
                           (apply program base limits)))
             (try
               (let* ((prior (gerbil-ascent-session-run session))
                      (proof (witness prior 15 16 8)))
                 (check (refused? (lambda () (edit-edge session prior 'insert 31 0))) => #t)
                 (check (eq? prior (gerbil-ascent-session-last-completed session)) => #t)
                 (check-result prior expected 'rebuilt)
                 (check (replay prior proof) => #t))
               (finally (gerbil-ascent-session-close! session)))))
         '((33 1024 1060) (40 768 1060) (40 1024 801)))))
    (test-case "Versioned edge edits keep the published cut on work refusal and cancellation"
      (let* ((base (append (cycle 16 0) (cycle 16 16) '((15 16) (31 0))))
             (session (gerbil-ascent-open-condensed-actor-session (program base 40 1100 1200))))
        (try
          (let* ((prior (gerbil-ascent-session-run session))
                 (proof (witness prior 31 0 8))
                 (started (make-completion 'edge-edit-started))
                 (proceed (make-completion 'edge-edit-proceed)))
            (check
             (refused?
              (lambda ()
                (parameterize ((current-ascent-execution-control
                                (lambda (work _) (when (> work 0) (error "work refused")))))
                  (edit-edge session prior 'delete 31 0))))
             => #t)
            (check (eq? prior (gerbil-ascent-session-last-completed session)) => #t)
            (let (caller
                  (spawn
                   (lambda ()
                     (let (first? #t)
                       (refused?
                        (lambda ()
                          (parameterize ((current-ascent-execution-control
                                          (lambda (work _)
                                            (when (and first? (> work 0))
                                              (set! first? #f)
                                              (completion-post! started #t)
                                              (completion-wait! proceed)))))
                            (edit-edge session prior 'delete 31 0))))))))
              (completion-wait! started)
              (check (gerbil-ascent-session-cancel! session) => 'draining)
              (completion-post! proceed #t)
              (check (thread-join! caller) => #t))
            (check (eq? prior (gerbil-ascent-session-last-completed session)) => #t)
            (check (replay prior proof) => #t)
            (let (next (edit-edge session prior 'delete 31 0))
              (check (replay next proof) => #f)
              (check (witness next 31 0 32) => #f)))
          (finally (gerbil-ascent-session-close! session)))))
    (test-case "Derived and output exhaustion preserve the last committed index and witness"
      (let* ((edges (append (cycle 20 0) (cycle 20 20)))
             (expected (closure-oracle 40 edges)))
        (for-each
          (lambda (limits)
            (let (session (gerbil-ascent-open-condensed-actor-session
                            (program edges 64 (car limits) (cadr limits))))
              (try
                (let* ((first (gerbil-ascent-session-run session))
                       (proof (witness first 0 0 40)))
                  (check-result first expected 'rebuilt)
                  (gerbil-ascent-session-append-source! session 'edge '(19 20))
                  (let (failure
                         (with-catch
                           (lambda (e) (call-with-output-string
                                         (lambda (port) (display-exception e port))))
                           (lambda () (gerbil-ascent-session-run session) "returned")))
                    (check (or (and (string-contains failure (caddr limits)) #t) failure) => #t))
                  (check (eq? (gerbil-ascent-session-last-completed session) first) => #t)
                  (check (replay first proof) => #t)
                  (check-result (gerbil-ascent-session-run session) expected 'reused))
                (finally (gerbil-ascent-session-close! session)))))
          '((800 1700 "ASCENT derived fact budget exceeded")
            (1600 840 "ASCENT output fact budget exceeded")))))
    (test-case "Split-merge repair under either fact limit keeps the published version"
      (let ((split (append (cycle 20 0) (cycle 20 20) '((19 20)))))
        (for-each
         (lambda (limits)
           (let (session (gerbil-ascent-open-condensed-actor-session
                           (program split 64 (car limits) (cadr limits))))
             (try
               (let* ((first (gerbil-ascent-session-run session))
                      (proof (witness first 19 39 80)))
                 (check (replay first proof) => #t)
                 (gerbil-ascent-session-append-source! session 'edge '(39 0))
                 (let (failure
                       (with-catch
                         (lambda (cause)
                           (call-with-output-string (lambda (port) (display-exception cause port))))
                         (lambda () (gerbil-ascent-session-run session) "returned")))
                   (check (and (string-contains failure (caddr limits)) #t) => #t))
                 (check (eq? first (gerbil-ascent-session-last-completed session)) => #t)
                 (check (replay first proof) => #t)
                 (check (selected-rows first '(0 1) '(39 0)) => []))
               (finally (gerbil-ascent-session-close! session)))))
         '((1300 1700 "ASCENT derived fact budget exceeded")
           (1600 1260 "ASCENT output fact budget exceeded")))))
    (test-case "Cancel stops large tentative graph and keeps the prior completed version"
      (let* ((size 180)
             (before (cycle 36 0))
             (large (let (rows [])
                      (for-each (lambda (i)
                                  (for-each (lambda (j)
                                              (unless (= i j) (set! rows (cons (list i j) rows))))
                                            (iota size)))
                                (iota size))
                      rows))
             (session (gerbil-ascent-open-condensed-actor-session (program before 40000 40000 80000))))
        (try
          (let (first (gerbil-ascent-session-run session))
            (check-result first (closure-oracle 36 before) 'rebuilt)
            (gerbil-ascent-session-replace-source! session 'edge large)
            (let (runner (spawn (lambda ()
                                  (with-catch (lambda (_) 'rejected)
                                    (lambda () (gerbil-ascent-session-run session) 'returned)))))
              (active-run session)
              (check (gerbil-ascent-session-cancel! session) => 'draining)
              (check (thread-join! runner) => 'rejected)
              (check (eq? (gerbil-ascent-session-last-completed session) first) => #t)
              (check-result (gerbil-ascent-session-run session) (closure-oracle 36 before) 'reused)))
          (finally (gerbil-ascent-session-close! session)))))))
