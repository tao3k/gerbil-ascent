(import (only-in :asp-gerbil-scheme/benchmark-api
                 benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/table/trrel-uf
        (rename-in :gerbil-ascent/t/performance/uf-commit/reference
          (gerbil-ascent-trrel-uf-state old-state)
          (gerbil-ascent-trrel-uf-extension old-extend)
          (gerbil-ascent-trrel-uf-observation old-observe)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/uf-commit/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid UF commit fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown UF commit scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "UF commit module mismatch" name)))
    '("table/trrel-uf" "t/performance/uf-commit/reference"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (n (get 'width)) (active (get 'activeWidth)) (shape (get 'shape))
         (edges (append (map (lambda (i) (list i (+ i 1))) (iota (- active 1)))
                        (map (lambda (i) (list i i)) (iota (- n active) active))))
         (closing (case shape ((cycle lifecycle islands) (list (- active 1) 0))
                    ((partial) (list (- n 1) (- n 2)))
                    ((dag) (list 0 (- n 1))) (else '(0 1))))
         (expected (apply append (map (lambda (a)
           (map (lambda (b) (list a b))
                (filter (lambda (b) (or (= a b) (and (< a active) (< b active)
                     (or (memq shape '(cycle lifecycle islands)) (<= a b)
                         (and (eq? shape 'partial) (>= a (- n 2)) (>= b (- n 2))))))) (iota n)))) (iota n))))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (def (prepare state extend)
      (let ((s (state)) (trace []))
        (unless (eq? shape 'lifecycle)
          (for-each (lambda (edge) (set! trace (cons (extend s [] [] edge (* n n)) trace))) edges))
        (cons s (reverse trace))))
    (def (execute prepared extend observe)
      (let ((s (car prepared)) (trace (cdr prepared)))
        (when (eq? shape 'lifecycle)
          (for-each (lambda (edge) (set! trace (cons (extend s [] [] edge (* n n)) trace))) edges)
          (set! trace (reverse trace)))
        (let (added (extend s [] [] closing (* n n)))
          (list (append trace (list added)) (observe s) (extend s [] [] closing 0)))))
    (def (measure prepared extend observe)
      (##gc)
      (let* ((before (##process-statistics)) (result (execute prepared extend observe))
             (after (##process-statistics))
             (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9)))
             (cpu (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                     (+ (f64vector-ref before 0) (f64vector-ref before 1)))))
        (unless (>= bytes 0) (error "invalid cumulative allocation delta"))
        (values result bytes cpu)))
    (def (check a b)
      (unless (and (equal? a b) (null? (caddr b))) (error "ordered frontier or physical counts differ" scenario))
      (let (rows (make-hash-table))
        (for-each (lambda (frontier)
          (for-each (lambda (row)
            (when (hash-get rows row) (error "duplicate frontier row" row))
            (hash-put! rows row #t)) frontier)) (car b))
        (unless (= (hash-length rows) (length expected)) (error "closure cardinality differs" scenario))
        (for-each (lambda (row) (unless (hash-get rows row) (error "independent closure truth differs" row))) expected)))
    (def (sample)
      (let ((old (prepare old-state old-extend))
            (new (prepare gerbil-ascent-trrel-uf-state gerbil-ascent-trrel-uf-extension)))
        (let-values (((a x u b y v)
          (if (even? count)
            (let-values (((a x u) (measure old old-extend old-observe))
                         ((b y v) (measure new gerbil-ascent-trrel-uf-extension gerbil-ascent-trrel-uf-observation)))
              (values a x u b y v))
            (let-values (((b y v) (measure new gerbil-ascent-trrel-uf-extension gerbil-ascent-trrel-uf-observation))
                         ((a x u) (measure old old-extend old-observe)))
              (values a x u b y v)))))
          (check a b)
          (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
          (when (< v u) (set! wins (+ wins 1)))))
      (set! count (+ count 1))
      (displayln "UF-PAIRS " scenario " " count "/50") (force-output)
      count)
    (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= y (+ (* x (get 'allocationRatio)) (get 'allocationOverheadBytes)))
                         (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path (lambda (port)
          (write (list (cons 'scenario scenario) (cons 'baseline (benchmark-fixture-ref contract 'baseline))
            (cons 'passed? pass?) (cons 'asp-receipt api-receipt) (cons 'cpu-wins wins)
            (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
            (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                   " bytes " x " -> " y " wins " wins)
        (force-output) (unless pass? (error "UF commit performance gate failed" scenario))))))
