PROGRESS recursive-chain-256 800/1000
PROGRESS recursive-chain-256 900/1000
PROGRESS recursive-chain-256 1000/1000
RESULT recursive-chain-256 old-p50-ns=868000 new-p50-ns=348000 paired-wins=954/1000
CASE recursive-chain-1024 samples=1000 repetitions=1
[test-lane] RUNNING exclusive (15s)
