@@ -0,0 +1,112 @@
+;;; -*- Gerbil -*-
+;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
+;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
+;;; Inert model-response projection; no evaluation, oracle or repair.
+(import :std/encoding/json (only-in :std/list/list take))
+(export read-prediction read-prediction-text project-prediction prediction-main)
+;;; Bounded inert data reader. Model text is never Scheme code admission.
+(def (numeric-data? value (depth 0))
+  (and (<= depth 64) (or (exact-integer? value) (null? value)
+                        (and (list? value) (andmap (lambda (item) (numeric-data? item (+ depth 1))) value)))))
+(def (prediction-value datum)
+  (cond
+   ((numeric-data? datum) (vector #t datum))
+   ((and (list? datum) (= (length datum) 2) (eq? (car datum) 'quote) (numeric-data? (cadr datum)))
+    (vector #t (cadr datum)))
+   ((and (list? datum) (= (length datum) 3) (equal? (take datum 2) '(check-equal? result)))
+    (let (value (caddr datum))
+      (cond ((exact-integer? value) (vector #t value))
+            ((and (list? value) (= (length value) 2) (eq? (car value) 'quote) (numeric-data? (cadr value)))
+             (vector #t (cadr value))) (else (vector #f #f)))))
+   (else (vector #f #f))))
+(def (read-prediction-text text)
+  (with-catch (lambda (_error) (vector #f #f))
+    (lambda ()
+      (let ()
+        (unless (and (string? text) (<= (u8vector-length (string->utf8 text)) 8192)
+                     (<= (length (filter (lambda (char) (char=? char #\')) (string->list text))) 64)
+                     (andmap (lambda (char) (or (char-whitespace? char) (char-numeric? char) (char-alphabetic? char)
+                                               (memv char '(#\( #\) #\' #\+ #\- #\? #\_)))) (string->list text)))
+          (error "bounded inert model datum required"))
+        (let (depth 0)
+          (for-each (lambda (char)
+            (cond ((char=? char #\() (set! depth (+ depth 1))) ((char=? char #\)) (set! depth (- depth 1))))
+            (unless (<= 0 depth 64) (error "model datum nesting bound"))) (string->list text))
+          (unless (= depth 0) (error "unbalanced model datum")))
+        (call-with-input-string text (lambda (port)
+          (let (datum (read port))
+            (unless (eof-object? (read port)) (error "model datum trailing input"))
+            (prediction-value datum))))))))
+
+(def (read-bounded path limit)
+  (call-with-input-file path
+    (lambda (port)
+      (let loop ((chars []) (count 0))
+        (let (char (read-char port))
+          (cond ((eof-object? char) (list->string (reverse chars)))
+                ((>= count limit) (error "model response byte bound"))
+                (else (loop (cons char chars) (+ count 1)))))))))
+(def (read-prediction path)
+  (with-catch (lambda (_) (vector #f #f))
+    (lambda () (read-prediction-text (read-bounded path 8192)))))
+(def (trim text)
+  (let ((start 0) (end (string-length text)))
+    (let loop () (when (and (< start end) (char-whitespace? (string-ref text start)))
+                  (set! start (+ start 1)) (loop)))
+    (let loop () (when (and (< start end) (char-whitespace? (string-ref text (- end 1))))
+                  (set! end (- end 1)) (loop)))
+    (substring text start end)))
+(def (starts-at? text prefix position)
+  (let (end (+ position (string-length prefix)))
+    (and (<= end (string-length text)) (string=? prefix (substring text position end)))))
+(def (candidate-record text)
+  (let* ((text (trim text)) (prediction (read-prediction-text text)))
+    (and (vector-ref prediction 0)
+         (let (datum (call-with-input-string text read))
+           (list text (vector-ref prediction 1)
+                 (and (pair? datum) (memq (car datum) '(quote check-equal?)) #t))))))
+(def (assertion-candidates text)
+  (let (result [])
+    (let scan ((start 0))
+      (when (< start (string-length text))
+        (when (starts-at? text "(check-equal?" start)
+          (let close ((end start) (depth 0))
+            (when (< end (string-length text))
+              (let* ((char (string-ref text end))
+                     (next (+ depth (cond ((char=? char #\() 1) ((char=? char #\)) -1) (else 0)))))
+                (cond ((zero? next) (set! result (cons (substring text start (+ end 1)) result)))
+                      ((<= 1 next 64) (close (+ end 1) next)))))))
+        (scan (+ start 1))))
+    (reverse result)))
+(def (fence-candidates text)
+  (let ((result []) (body #f))
+    (for-each
+     (lambda (line)
+       (let (marker (trim line))
+         (cond
+          ((and body (string=? marker "```"))
+           (set! result (cons (apply string-append (reverse body)) result)) (set! body #f))
+          ((not body)
+           (when (member marker '("```" "```scheme" "```gerbil")) (set! body [])))
+          (else (set! body (cons (string-append line "\n") body))))))
+     (string-split text #\newline))
+    (reverse result)))
+(def (project-prediction text)
+  (with-catch (lambda (_) #f)
+    (lambda ()
+      (unless (and (string? text) (<= (u8vector-length (string->utf8 text)) 65536))
+        (error "model response byte bound"))
+      (let (direct (candidate-record text))
+        (if direct (car direct)
+          (let* ((records (filter-map candidate-record
+                            (append (assertion-candidates text) (fence-candidates text))))
+                 (explicit (filter caddr records)) (selected (if (pair? explicit) explicit records)))
+            (and (pair? selected)
+                 (andmap (lambda (record) (equal? (cadr record) (cadar selected))) selected)
+                 (caar selected))))))))
+(def (prediction-main path)
+  (displayln "MODULE-OK Scheme response projection") (force-output)
+  (let (candidate (with-catch (lambda (_) #f)
+                    (lambda () (project-prediction (read-bounded path 65536)))))
+    (displayln "NATIVE-PROJECTION " (json->string (hash ("prediction" candidate)))))
+  (displayln "HARNESS-OK Scheme response projection") (displayln "OK") (force-output))
