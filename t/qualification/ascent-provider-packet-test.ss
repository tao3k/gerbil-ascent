(import :std/test
 (only-in :clan/poo/object .o .ref .putslot! $constant-slot-spec compute-precedence-list!)
 (only-in :clan/poo/mop validate)
 :gerbil-ascent/table/provider
 (only-in :gerbil-ascent/table/storage gerbil-ascent-set-storage-provider)
 (only-in :gerbil-ascent/program/index gerbil-ascent-make-row-indexes row-indexes-rows)
 (only-in :gerbil-ascent/table/funs gerbil-ascent-index-row-snapshot/arity)
 :gerbil-ascent/t/performance/provider-packet/fixture)
(export ascent-provider-packet-test)
(def ascent-provider-packet-test
 (test-suite "Provider packet admission"
  (test-case "trusted receiver sources are sealed but descendants remain extensible"
   (for-each
    (lambda (provider)
     (for-each (lambda (source)
                  (check-exception (.putslot! source 'untrusted ($constant-slot-spec #t)) error?))
               (compute-precedence-list! provider)))
    (list gerbil-ascent-hash-index-provider gerbil-ascent-curried-index-provider
          gerbil-ascent-set-storage-provider))
   (let (derived (.o (:: @ gerbil-ascent-hash-index-provider)))
    (.putslot! derived 'extension ($constant-slot-spec 'allowed))
    (check-equal? (.ref derived 'extension) 'allowed)
    (check-equal? (gerbil-ascent-canonical-hash-index-provider? derived) #f)
    (check-equal? (eq? (validate GerbilAscentIndexProviderContract derived) derived) #t)))
  (test-case "native generic contracts reject malformed arguments before extension callbacks"
   (let* ((calls 0)
          (provider (.o (:: @ gerbil-ascent-hash-index-provider)
                     (.build-index (lambda args (set! calls (+ 1 calls))))
                     (.extend-index! (lambda args (set! calls (+ 1 calls))))
                     (.lookup-index (lambda args (set! calls (+ 1 calls)))))))
    (check-exception (gerbil-ascent-index-provider-build provider 'bad '(0)) error?)
    (check-exception (gerbil-ascent-index-provider-build provider [] '(-1)) error?)
    (check-exception (gerbil-ascent-index-provider-extend! provider #f [] '(a)) error?)
    (check-exception (gerbil-ascent-index-provider-lookup provider #f 'bad) error?)
    (check-equal? calls 0)
    (check-exception (validate GerbilAscentIndexProviderContract
                       (.o (:: @ gerbil-ascent-hash-index-provider) (.lookup-index #f))) error?)))
  (test-case "C4 composes diamond extensions once and rejects contradictory precedence"
   (let* ((events [])
          (base (.o (:: @ gerbil-ascent-hash-index-provider)
                  (.lookup-index (lambda (_index _key) (set! events (cons 'base events)) '((0 1))))))
          (left (.o super: inherited inherit: (list base)
                  (.lookup-index (let (next (inherited))
                    (lambda (index key) (set! events (cons 'left events)) (next index key))))))
          (right (.o super: inherited inherit: (list base)
                   (.lookup-index (let (next (inherited))
                     (lambda (index key) (set! events (cons 'right events)) (next index key))))))
          (diamond (validate GerbilAscentIndexProviderContract (.o inherit: (list left right)))))
    (check-equal? (gerbil-ascent-index-provider-lookup diamond #f '(0)) '((0 1)))
    (check-equal? (reverse events) '(left right base))
    (check-equal? (gerbil-ascent-canonical-hash-index-provider? diamond) #f)
    (let ((ordered (.o inherit: (list left right))) (opposed (.o inherit: (list right left))))
     (check-exception (compute-precedence-list! (.o inherit: (list ordered opposed))) error?))
    (check-equal? (reverse events) '(left right base))))
  (test-case "C4 extensions retain complete native packet admission and revocation"
   (let* ((bad? #f) (builds 0) (visits []) (rows (map (lambda (n) (list 0 n)) (iota 32)))
          (base (.o (:: @ gerbil-ascent-hash-index-provider)
                  (.build-index (lambda (rows _columns) (set! builds (+ builds 1)) rows))
                  (.lookup-index (lambda (index _key) (set! visits (cons 'base visits))
                                   (if bad? '((9 9)) index)))))
          (left (.o super: inherited inherit: (list base)
                  (.lookup-index (let (next (inherited))
                    (lambda (index key) (set! visits (cons 'left visits)) (next index key))))))
          (right (.o super: inherited inherit: (list base)
                   (.lookup-index (let (next (inherited))
                     (lambda (index key) (set! visits (cons 'right visits)) (next index key))))))
          (provider (validate GerbilAscentIndexProviderContract (.o inherit: (list left right))))
          (indexes (gerbil-ascent-make-row-indexes (vector rows) (vector rows) (vector 32) (vector 32)
                     (vector 0) (vector 0) (vector provider)))
          (atom (vector 0 '((literal . 0) (wildcard . #f)) '(0) [] '((literal . 0)))))
    (def (lookup) ((row-indexes-rows indexes) atom [] #f #f))
    (check-equal? (lookup) rows)
    (check-equal? (reverse visits) '(left right base))
    (set! bad? #t)
    (check-equal? (with-catch error-message (lambda () (lookup) 'unexpected))
                  "ASCENT index provider returned foreign row")
    (set! bad? #f)
    (check-equal? (lookup) rows)
    (check-equal? builds 2)
    (check-equal? (reverse visits) '(left right base left right base left right base))))
  (test-case "all widths preserve field identity with detached spines"
   (for-each (lambda (width)
    (let* ((value (vector 'borrowed)) (row (make-list width value))
           (rows (list row row)) (copy (gerbil-ascent-index-row-snapshot/arity rows width)))
     (check-equal? copy rows)
     (check-equal? (eq? copy rows) #f)
     (when (positive? width)
      (check-equal? (eq? (car copy) row) #f)
      (check-equal? (eq? (car copy) (cadr copy)) #f)
      (check-equal? (andmap (cut eq? <> value) (car copy)) #t)
      (set-car! row 'mutated)
      (check-equal? (eq? (caar copy) value) #t)
      (set-car! (car copy) 'private)
      (check-equal? (eq? (caadr copy) value) #t))))
    (iota 257)))
  (test-case "bounded rejection of short long improper and cyclic rows"
   (for-each (lambda (width)
    (let (cycle (list 'cycle))
     (set-cdr! cycle cycle)
     (for-each (lambda (bad)
      (check-equal?
       (with-catch (lambda (failure) (error-message failure))
        (lambda () (gerbil-ascent-index-row-snapshot/arity
                     (list (make-list width #f) bad) width) 'unexpected))
       "ASCENT index provider returned wrong row arity"))
      (append (list cycle (make-list (+ width 1) #f) 'atom)
       (if (zero? width) [] (list (make-list (- width 1) #f) (cons #f 'improper)))))))
    (iota 257)))
  (test-case "complete warm lookup agrees with frozen owner and independent checksum"
   (for-each (lambda (width)
    (for-each (lambda (count)
     (let (input (packet-input width count 3))
      (check-equal? (packet-workflow #t input) (packet-expected input))
      (check-equal? (packet-workflow #f input) (packet-expected input)))) '(0 1 31 32 33 64)))
    '(2 3 4 8 64 256)))))
