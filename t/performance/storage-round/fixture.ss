(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/table/interface gerbil-ascent-set-storage-provider
                 gerbil-ascent-trrel-uf-storage-provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/storage-round/reference-evaluate old-)
        (only-in :gerbil-ascent/t/performance/view-lattice-round/fixture vl-program)
        (only-in :gerbil-ascent/t/performance/scc-execution/fixture scc-project))
(export sr-provider sr-program sr-prepare sr-consume sr-expected sr-project)
(def (sr-provider (observe (lambda (_all _pending _row) #f)) (expand list))
  (.o (:: @ gerbil-ascent-set-storage-provider)
      (.extend-rows (lambda (_state all pending row _budget)
                      (observe all pending row) (expand row)))))
(def (limit scenario) (case scenario ((wide) 128) ((mixed retained) 64) ((index) 16) (else 1)))
(def (padding scenario) (case scenario ((wide retained) 512) ((mixed) 384) (else 0)))
(def (name i) (string->symbol (string-append "unused" (number->string i))))
(def (custom name rows (index gerbil-ascent-hash-index-provider))
  (gerbil-ascent-relation name 2 rows index (sr-provider)))
(def (view name rows)
  (gerbil-ascent-relation name 2 rows gerbil-ascent-hash-index-provider gerbil-ascent-trrel-uf-storage-provider))
(def (sr-program scenario)
  (if (eq? scenario 'native) (vl-program 'view)
    (let* ((v (gerbil-ascent-variable 'v)) (next (gerbil-ascent-variable 'next))
           (key (gerbil-ascent-literal 0)) (n (limit scenario)))
      (def (atom name) (gerbil-ascent-atom name (list key v)))
      (gerbil-ascent-program
       (case scenario
         ((dense) (cons (gerbil-ascent-relation 'input 2 (map (lambda (i) (list 0 i)) (iota 32)))
                        (map (lambda (i) (custom (name i) [])) (iota 40))))
         ((mixed) (append (list (custom 'counter '((0 0))) (view 'reach []))
                          (map (lambda (i) (if (even? i) (custom (name i) []) (view (name i) [])))
                               (iota (padding scenario)))))
         (else (cons (custom 'counter (if (eq? scenario 'retained) [] '((0 0)))
                             (if (eq? scenario 'index) (.o (:: @ gerbil-ascent-hash-index-provider))
                                 gerbil-ascent-hash-index-provider))
                     (if (= (padding scenario) 0) (list (gerbil-ascent-relation 'sentinel 2 []))
                         (map (lambda (i) (custom (name i) [])) (iota (padding scenario)))))))
       (case scenario
         ((retained) [])
         ((dense) (list (gerbil-ascent-rule (map (lambda (i) (atom (name i))) (iota 40))
                         (list (atom 'input) (gerbil-ascent-guard '(v) (lambda (_) #t))))))
         (else (append (list (gerbil-ascent-rule
                              (list (gerbil-ascent-atom 'counter (list key next)))
                              (list (atom 'counter) (gerbil-ascent-guard '(v) (lambda (value) (< value n)))
                                    (gerbil-ascent-binding 'next '(v) (lambda (value) (+ value 1))))))
                        (if (eq? scenario 'mixed)
                          (list (gerbil-ascent-rule (list (atom 'reach)) (list (atom 'counter)))) []))))
       200000 200000 200000))))
(def sr-project scc-project)
(def (sr-prepare old? scenario)
  (let* ((program (sr-program scenario)) (names (map (cut .ref <> 'name) (.ref program 'relations)))
         (counter (map (lambda (i) (list 0 i)) (iota (+ (limit scenario) 1))))
         (star (append (map (lambda (i) (list 0 i)) (iota 65))
                       (map (lambda (i) (list i i)) (iota 64 1))))
         (rows (case scenario
                 ((native) (cons star (make-list 512 [])))
                 ((retained) (cons (map (lambda (i) (list 0 i)) (iota 64)) (make-list 512 [])))
                 ((mixed) (append (list counter star) (make-list 384 [])))
                 ((dense) (make-list 41 (map (lambda (i) (list 0 i)) (iota 32))))
                 (else (cons counter (make-list (- (length names) 1) [])))))
         (expected (list #t names (map (lambda (n rs) (cons n (length rs))) names rows)
                         rows 'stratified-semi-naive (length (.ref program 'rules)))))
    ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t)
    (vector program expected)))
(def (sr-consume state scenario old?)
  (let* ((program (if (eq? scenario 'cold) (sr-program scenario) (vector-ref state 0)))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine)
                  program (eq? scenario 'retained) #f #f #f #f #f 1)))
    (if (eq? scenario 'retained)
      (let (run (.ref engine '.run))
        (run)
        (for-each (lambda (i)
                    ((.ref engine '.append-source!) 'counter (list 0 i))
                    (let (result (run))
                      (for-each (lambda (_) (unless (eq? result (run)) (error "clean result identity changed")))
                                (iota 4)))) (iota 64))
        (sr-project (run)))
      (sr-project (engine)))))
(def (sr-expected state scenario) (vector-ref state 1))
