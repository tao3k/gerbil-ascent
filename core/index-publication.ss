;;; Generated by CachePublication.lean; preserve evaluation and publication order.
(export gerbil-ascent-index-rebuild! gerbil-ascent-index-extend!)
;; gerbil-ascent-index-rebuild!
;; : (-> Entry Version MembersExpression LookupExpression LookupWriter WitnessWriter VersionWriter Lookup)
;; | doc m%
;;     Publish lookup, witness and version only after both constructors finish.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-index-rebuild! e v members lookup put-lookup! put-witness! put-version!)
;;     ;; => the completely built lookup
;;     ```
;;   %
(defrule (gerbil-ascent-index-rebuild! entry version members-expr lookup-expr write-lookup! write-witness! write-version!)
  (let* ((owner entry) (members members-expr) (built lookup-expr))
    (write-lookup! owner built)
    (write-witness! owner members)
    (write-version! owner version)
    built))
;; gerbil-ascent-index-extend!
;; : (-> Entry Version MutationExpression WitnessExpression LookupWriter VersionWriter Result)
;; | doc m%
;;     Revoke the version before mutation; failures cannot publish a current version.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-index-extend! e v mutate witness put-lookup! put-version!)
;;     ;; => publication after mutation and witness completion
;;     ```
;;   %
(defrule (gerbil-ascent-index-extend! entry next-version mutate-expr witness-expr write-lookup! write-version!)
  (let (owner entry)
    (write-version! owner #f)
    (let ((built mutate-expr))
      (write-lookup! owner built)
      witness-expr
      (write-version! owner next-version))))
