;;; Complete-output native comparisons of two row propagation families.
(import :gerbil/runtime/gambit :gerbil/expander
        (only-in :clan/poo/object .o .mix .ref .call)
        (only-in :clan/poo/trie UIntTrieSet)
        :gerbil-ascent/t/performance/row-propagation/kernel
        :gerbil-ascent/t/performance/row-propagation/reference)
(for-each
 (lambda (name)
   (let* ((actual (gx#module-context-path (gx#import-module
                   (string->symbol (string-append ":gerbil-ascent/t/performance/row-propagation/" name)))))
          (expected (string-append (getenv "ASCENT_ROW_LIB") "/gerbil-ascent/t/performance/row-propagation/" name ".ssi")))
     (unless (equal? actual expected) (error "research probe must use native modules" actual expected))
     (displayln "NATIVE-MODULE-OK " actual))) '("reference" "kernel"))
(def (statistic samples fraction)
  (list-ref (list-sort < samples)
            (- (quotient (* (length samples) fraction) 100) 1)))

(def (allocated) (inexact->exact (f64vector-ref (##process-statistics) 7)))
(def (measured call repetitions)
  (let ((start-bytes (allocated)) (start (current-jiffy)) (result #f))
    (let loop ((left repetitions))
      (when (> left 0) (set! result (call)) (loop (- left 1))))
    (let ((elapsed (quotient (* (- (current-jiffy) start) 1000000000)
                             (* repetitions (jiffies-per-second))))
          (bytes (quotient (- (allocated) start-bytes) repetitions)))
      (values result bytes elapsed))))

(def (matched name old new check repetitions primary?)
  (displayln "CASE " name " samples=1000 repetitions=" repetitions)
  (force-output)
  (for-each (lambda (_) (check (old) (new))) (iota 20))
  (let ((old-samples []) (new-samples []) (old-times []) (new-times []))
    (let loop ((sample 0))
      (when (< sample 1000)
        (let-values (((old-result old-bytes old-ns new-result new-bytes new-ns)
                      (if (even? sample)
                        (let-values (((left left-bytes left-ns) (measured old repetitions))
                                     ((right right-bytes right-ns) (measured new repetitions)))
                          (values left left-bytes left-ns right right-bytes right-ns))
                        (let-values (((right right-bytes right-ns) (measured new repetitions))
                                     ((left left-bytes left-ns) (measured old repetitions)))
                          (values left left-bytes left-ns right right-bytes right-ns)))))
          (check old-result new-result)
          (set! old-samples (cons old-bytes old-samples))
          (set! new-samples (cons new-bytes new-samples))
          (set! old-times (cons old-ns old-times))
          (set! new-times (cons new-ns new-times)))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "PROGRESS " name " " (+ sample 1) "/1000")
          (force-output))
        (loop (+ sample 1))))
    (let* ((old-p50 (statistic old-samples 50))
           (new-p50 (statistic new-samples 50))
           (wins (foldl (lambda (pair total)
                          (if (< (cdr pair) (car pair)) (+ total 1) total))
                        0 (map cons old-samples new-samples))))
      (displayln "RESULT " name " old-p50-bytes=" old-p50
                 " new-p50-bytes=" new-p50 " paired-wins=" wins "/1000")
      (force-output)
      (list (cons 'name name) (cons 'repetitions repetitions)
            (cons 'primary? primary?)
            (cons 'old-p50-bytes old-p50) (cons 'new-p50-bytes new-p50)
            (cons 'old-p95-bytes (statistic old-samples 95))
            (cons 'new-p95-bytes (statistic new-samples 95))
            (cons 'paired-wins wins)
            (cons 'old-samples-bytes (reverse old-samples))
            (cons 'new-samples-bytes (reverse new-samples))
            (cons 'old-p50-ns (statistic old-times 50))
            (cons 'new-p50-ns (statistic new-times 50))
            (cons 'old-p95-ns (statistic old-times 95))
            (cons 'new-p95-ns (statistic new-times 95))
            (cons 'time-paired-wins
                  (foldl (lambda (pair total) (if (< (cdr pair) (car pair)) (+ total 1) total))
                         0 (map cons old-times new-times)))
            (cons 'old-samples-ns (reverse old-times))
            (cons 'new-samples-ns (reverse new-times))))))


(def (source width step)
  (.call UIntTrieSet .<-list
    (apply append (map (lambda (from)
      (map (lambda (distance) (+ (* from width) (modulo (+ from distance) width)))
           (iota step 1))) (iota width)))))
(def (chain width)
  (.call UIntTrieSet .<-list
    (map (lambda (from) (+ (* from width) (+ from 1))) (iota (- width 1)))))
(def (expression prototype pairs width)
  (.mix prototype (.o (source-pairs pairs) (radix width))))
(def (slots value)
  (let* ((projection (.ref value 'at-most-two-hop-pairs))
         (closure (.ref value 'closure-pairs))
         (distances (.ref value 'shortest-distance-pairs))
         (lookup (.ref value 'shortest-distance-of)))
    (list projection closure distances (map lookup distances))))
(def (probe name prototype pairs radix demand primary?)
  (matched name
    (lambda () (demand (expression row-reference-prototype pairs radix)))
    (lambda () (demand (expression prototype pairs radix)))
    (lambda (left right) (unless (equal? left right) (error "row propagation changed results" name)))
    1 primary?))
(let (receipts [])
  (for-each
   (lambda (entry)
     (let ((prefix (car entry)) (prototype (cdr entry)))
       (for-each
        (lambda (degree)
          (set! receipts (cons (probe
            (string->symbol (string-append prefix "-complete-32-degree-" (number->string degree)))
            prototype (source 32 degree) 32 slots (= degree 31)) receipts))) '(1 2 4 8 16 31))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-complete-fanout-64"))
                                  prototype (source 64 63) 64 slots #t) receipts))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-projection-256"))
                                  prototype (source 256 2) 256 (lambda (e) (.ref e 'at-most-two-hop-pairs)) #f) receipts))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-closure-chain-32"))
                                  prototype (chain 32) 32 (lambda (e) (.ref e 'closure-pairs)) #f) receipts))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-distance-chain-32"))
                                  prototype (chain 32) 32
                                  (lambda (e) (let ((rows (.ref e 'shortest-distance-pairs)) (lookup (.ref e 'shortest-distance-of)))
                                                (list rows (map lookup rows)))) #f) receipts))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-empty-distances-512"))
                                  prototype (.call UIntTrieSet .<-list []) 512 (lambda (e) (.ref e 'shortest-distance-pairs)) #f) receipts))
       (set! receipts (cons (probe (string->symbol (string-append prefix "-sparse-distances-512"))
                                  prototype (.call UIntTrieSet .<-list '(1 514)) 512
                                  (lambda (e) (let ((rows (.ref e 'shortest-distance-pairs)) (lookup (.ref e 'shortest-distance-of)))
                                                (list rows (map lookup rows)))) #f) receipts))))
   (list (cons "frontier" row-frontier-prototype) (cons "warshall" row-warshall-prototype)))
  (call-with-output-file (getenv "ASCENT_ROW_RECEIPT")
    (lambda (port) (write (reverse receipts) port) (newline port)))
  (displayln "OK"))
