;;; Generated by ActorEnvelope.lean; arbitrary payload/reference identities stay intact.
(export gerbil-ascent-send-round! gerbil-ascent-match-round!)
;; gerbil-ascent-send-round!
;; : (-> Thread MessageKind RunKey Worker Task Payload Void)
;; | doc m%
;;     Send one five-field envelope; preserve payload identity.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-send-round! owner 'done key worker task payload)
;;     ;; => one mailbox envelope
;;     ```
;;   %
(defrule (gerbil-ascent-send-round! owner kind key worker task payload)
  (thread-send owner [kind key worker task payload]))
;; gerbil-ascent-match-round!
;; : (-> Message MatchBranch MalformedBranch Result)
;; | doc m%
;;     Bind an exact five-field envelope or select the malformed branch.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-match-round! 'bad ([k r w t p] #t) (else #f))
;;     ;; => #f
;;     ```
;;   %
(defrule (gerbil-ascent-match-round! message ([kind key worker task payload] matched) (else malformed))
  (match message
    ([kind key worker task payload] matched)
    (else malformed)))
