(import :gerbil-ascent/core/relation-view
        (prefix-in "reference-relation-view.ss" old-))
(export ui-prepare ui-consume ui-expected ui-allocate)
(def (capture old? groups size indexed?)
  (defrule (build rectangle view)
    (view (map (lambda (group)
                 ;; Equal values deliberately belong to distinct frozen owners.
                 (let (axis (iota size)) (rectangle (list group) axis axis)))
            (iota groups)) (* groups size size) (* groups size 2) indexed?))
  (if old? (build old-make-rectangle old-gerbil-ascent-rectangle-view)
    (build make-rectangle gerbil-ascent-rectangle-view)))
(def (capture-components old? groups components size)
  (defrule (build rectangle view)
    (view (apply append (map (lambda (group)
      (let (prefix (list group))
        (map (lambda (component)
          (let (axis (map (lambda (value) (+ (* group components size) (* component size) value)) (iota size)))
            (rectangle prefix axis axis))) (iota components)))) (iota groups)))
      (* groups components size size) (* groups components size 2) #t))
  (if old? (build old-make-rectangle old-gerbil-ascent-rectangle-view)
    (build make-rectangle gerbil-ascent-rectangle-view)))
(def (ui-prepare old? scenario)
  (let* ((groups (if (memq scenario '(small repeated-small unindexed)) 1 64))
         (size (if (memq scenario '(small repeated-small)) 4 128))
         (repeats (case scenario ((small) 1) ((repeated-small) 4096) ((single-axis) 4) (else 256)))
         (columns (case scenario
                    ((grouped point-tail point-absent unindexed small repeated-small) '(0 1 2))
                    ((reordered component-query) '(2 0 1 0 2))
                    ((wide wide-rows) (apply append (make-list 8 '(1 2))))
                    ((conflict) '(1 2 1))
                    ((single-axis) '(2))
                    ((partial partial-absent) '(0 1 0))
                    (else [])))
         (keys (map (lambda (i)
                      (case scenario
                        ((grouped unindexed small repeated-small) (list (modulo i groups) 3 2))
                        ((point-tail) (list (modulo i groups) (- size 1) (- size 2)))
                        ((point-absent) (list (modulo i groups) (+ size 1) 2))
                        ((reordered) (list 2 (modulo i groups) 3 (modulo i groups) 2))
                        ((component-query)
                         (let* ((group (modulo i groups)) (base (* group size)))
                           (list (+ base 2) group (+ base 3) group (+ base 2))))
                        ((wide wide-rows) (apply append (make-list 8 '(3 2))))
                        ((conflict) '(3 2 4))
                        ((single-axis) '(2))
                        ((partial) (list (modulo i groups) 3 (modulo i groups)))
                        ((partial-absent) '(99 3 99))
                        (else []))) (iota repeats))))
    (list (if (eq? scenario 'component-query) (capture-components old? groups 32 4)
            (capture old? groups size (not (eq? scenario 'unindexed))))
          columns keys groups size)))
(def (ui-consume prepared scenario old?)
  (if (memq scenario '(capture tiny-capture))
    ((if old? old-relation-view-count relation-view-count) (if (eq? scenario 'tiny-capture) (capture old? 1 4 #t) (capture old? 64 128 #t)))
    (if (eq? scenario 'wide)
      (let (count 0)
        (for-each (lambda (key)
          ((if old? old-gerbil-ascent-visit-view-parts! gerbil-ascent-visit-view-parts!)
            (car prepared) (cadr prepared) key
            (lambda (_prefix _left _right) (set! count (+ count 1))))) (caddr prepared))
        count)
      (foldl (lambda (key count)
             (+ count (length ((if old? old-gerbil-ascent-view-rows gerbil-ascent-view-rows)
                                (car prepared) (cadr prepared) key)))) 0 (caddr prepared)))))
(def (expected-rows prepared scenario key)
  (case scenario
    ((grouped reordered unindexed small repeated-small)
     (list (list (if (eq? scenario 'reordered) (cadr key) (car key)) 3 2)))
    ((component-query) (list (list (cadr key) (caddr key) (car key))))
    ((point-tail) (list (list (car key) (- (list-ref prepared 4) 1) (- (list-ref prepared 4) 2))))
    ((point-absent) [])
    ((wide wide-rows) (map (lambda (group) (list group 3 2)) (iota (list-ref prepared 3))))
    ((conflict partial-absent) [])
    ((partial) (map (lambda (right) (list (car key) 3 right)) (iota (list-ref prepared 4))))
    ((single-axis)
     (apply append (map (lambda (group)
                         (map (lambda (left) (list group left 2)) (iota (list-ref prepared 4))))
                       (iota (list-ref prepared 3)))))
    (else [])))
(def (ui-expected prepared scenario)
  (let (candidate (ui-prepare #f scenario))
    (unless (memq scenario '(capture tiny-capture))
      ;; Exact ordered tuples follow independent Cartesian arithmetic, outside
      ;; every measured interval. Both arms use identical stored-owner inputs.
      (for-each (lambda (key)
                  (let (expected (expected-rows prepared scenario key))
                    (unless (and (equal? expected (old-gerbil-ascent-view-rows (car prepared) (cadr prepared) key))
                                 (equal? expected (gerbil-ascent-view-rows (car candidate) (cadr candidate) key)))
                      (error "UF query differs from independent ordered truth" scenario key))))
                (if (eq? scenario 'single-axis) (take (caddr prepared) 1) (caddr prepared))))
    (let (expected (case scenario
                    ((capture) (* 64 128 128)) ((tiny-capture) 16)
                    ((conflict point-absent partial-absent) 0)
                    ((wide wide-rows) (* 256 64))
                    ((single-axis) (* 4 64 128))
                    ((partial) (* 256 128))
                    ((small) 1) ((repeated-small) 4096)
                    (else 256)))
      (unless (and (= (ui-consume prepared scenario #t) expected)
                   (= (ui-consume candidate scenario #f) expected))
        (error "UF query cardinality differs" scenario))
      expected)))

;; Keep the CPU consumer intact. Bounded allocation legs cover all 4096 keys;
;; only identical input-spine slicing and result assembly are outside counters.
(def (ui-allocate prepared scenario old? measure batch-size)
  (unless (and (exact-integer? batch-size) (> batch-size 0))
    (error "invalid UF query allocation batch size" batch-size))
  (let loop ((pending (caddr prepared)) (result 0) (bytes 0) (leg 0))
    (if (null? pending) (values result bytes)
      (let* ((size (min batch-size (length pending)))
             (keys (take pending size))
             (batch (cons (car prepared) (cons (cadr prepared) (cons keys (cdddr prepared))))))
        (let-values (((count allocated) (measure (cut ui-consume batch scenario old?))))
          (displayln "ALLOCATION-QUERY-LEG " scenario " old=" old? " leg=" leg
                     " queries=" size " count=" count " bytes=" allocated)
          (loop (drop pending size) (+ result count) (+ bytes allocated) (+ leg 1)))))))
