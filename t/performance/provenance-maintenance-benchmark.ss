(import :gerbil/expander
        (only-in :gerbil-ascent/candidate/types make-reasoning-candidate)
        (only-in :gerbil-ascent/candidate/reasoning reasoning-source-snapshot)
        (only-in :gerbil-ascent/candidate/provenance-graph candidate-positive-provenance
                 candidate-open-provenance-maintenance candidate-provenance-withdraw! provenance-maintenance-rows)
        (rename-in (only-in :gerbil-ascent/t/performance/provenance-maintenance/reference
                           candidate-positive-provenance candidate-open-provenance-maintenance
                           candidate-provenance-withdraw! provenance-maintenance-rows)
                   (candidate-positive-provenance old-graph) (candidate-open-provenance-maintenance old-open)
                   (candidate-provenance-withdraw! old-withdraw!) (provenance-maintenance-rows old-rows)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call)
  (##gc)
  (def (counter)
    (let (s (##process-statistics))
      (values (+ (f64vector-ref s 0) (f64vector-ref s 1))
              (f64vector-ref s 7) (f64vector-ref s 9))))
  (let-values (((cpu bytes _) (counter)))
    (let (result (call))
      (let-values (((after allocated overhead) (counter)))
        (let (delta (- allocated bytes overhead))
          (unless (>= delta 0) (error "invalid allocation counter" delta))
          (values result (- after cpu) delta))))))
(def (main scenario library receipt)
  (add-load-path! library)
  (unless (member scenario '("wide" "duplicates" "read" "small")) (error "unknown maintenance scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "maintenance benchmark requires matched native modules" name)))
    '("candidate/provenance-maintenance" "candidate/provenance-graph" "t/performance/provenance-maintenance/reference"))
  (let* ((small? (string=? scenario "small")) (read? (string=? scenario "read"))
         (duplicates? (string=? scenario "duplicates")) (count (if small? 1 256))
         (rows (map (lambda (i) (list (if duplicates? 1 i))) (iota count)))
         (initial (if duplicates? '((1)) rows))
         (snapshot (reasoning-source-snapshot 'maintenance-benchmark 1 (list (list 's 1 rows))))
         (spec (make-reasoning-candidate '((p . 1)) []
                 (list (vector '(p ?x) '((s ?x)) 10) (vector '(p ?x) '((p ?x)) 11))
                 (vector '(p ?x) 12) '(4096 4096 8192)))
         (prior (old-graph snapshot spec 'program 'complete initial 100000 4096))
         (current (candidate-positive-provenance snapshot spec 'program 'complete initial 100000 4096))
         (selectors (map (lambda (i) (list 's (+ i 1))) (iota (if (or small? duplicates?) count 128))))
         (truth (cond (read? initial) ((or small? duplicates?) []) (else (map list (iota 128 128)))))
         (ac []) (bc []) (ab []) (bb []) (wins 0) (work #f))
    (def (prepare old?)
      ((if old? old-open candidate-open-provenance-maintenance)
       snapshot spec 'program 'complete initial (if old? prior current) 100000 4096))
    (def (invoke old? state)
      (if read? (list ((if old? old-rows provenance-maintenance-rows) state) 0)
          (let-values (((rows steps) ((if old? old-withdraw! candidate-provenance-withdraw!) state selectors 100000)))
            (list rows steps))))
    (def (check result)
      (unless (equal? (list-sort (lambda (a b) (< (car a) (car b))) (car result)) truth)
        (error "maintenance result differs from independent truth" scenario)))
    (for-each (lambda (_) (check (invoke #t (prepare #t))) (check (invoke #f (prepare #f)))) (iota 3))
    ;; Verification/copying is intentionally outside withdrawal/read timing.
    ;; Every pair uses fresh independently verified states; no repeated no-op
    ;; withdrawals or steadily growing retained selectors stand in for deletion.
    (for-each
     (lambda (i)
       (let ((old (prepare #t)) (new (prepare #f)))
         (let-values (((a x u b y v)
                       (if (even? i)
                         (let-values (((a x u) (measure (lambda () (invoke #t old))))
                                      ((b y v) (measure (lambda () (invoke #f new))))) (values a x u b y v))
                         (let-values (((b y v) (measure (lambda () (invoke #f new))))
                                      ((a x u) (measure (lambda () (invoke #t old))))) (values a x u b y v)))))
           (check a) (check b)
           (unless (equal? a b) (error "ordered rows or exact work count differ" scenario i))
           (set! work (cadr b))
           (set! ac (cons x ac)) (set! bc (cons y bc)) (set! ab (cons u ab)) (set! bb (cons v bb))
           (when (< y x) (set! wins (+ wins 1))))
         (when (zero? (modulo (+ i 1) 5))
           (displayln "MAINTENANCE-PAIRS " scenario " " (+ i 1) "/50") (force-output)))) (iota 50))
    ;; Fixed before sampling: large withdrawal saves 30% CPU/35 wins, bounded
    ;; index cost <=3x old allocation+16KiB. Read saves 50% CPU with <=1KiB extra.
    ;; Small permits 5%+30us CPU overhead and <=8KiB extra transient allocation.
    (let* ((a (median ac)) (b (median bc)) (x (median ab)) (y (median bb))
           (pass? (cond (small? (and (<= b (+ (* a 1.05) 0.000030)) (<= y (+ x 8192))))
                        (read? (and (<= b (* a 0.50)) (>= wins 35) (<= y (+ x 1024))))
                        (else (and (<= b (* a 0.70)) (>= wins 35) (<= y (+ (* x 3) 16384)))))))
      (call-with-output-file receipt (lambda (p) (write (list scenario (cons 'baseline 'daf78bbd08c2ce24ecd1c2494326b3f216367015)
        (cons 'passed? pass?) (cons 'cpu-wins wins) (cons 'work work)
        (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000)) (cons 'old-bytes x) (cons 'new-bytes y)
        (cons 'old-cpu ac) (cons 'new-cpu bc) (cons 'old-bytes-pairs ab) (cons 'new-bytes-pairs bb)) p)))
      (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                 " bytes " x " -> " y " wins " wins " work " work) (force-output)
      (unless pass? (error "maintenance performance gate failed" scenario)))))
