(import :gerbil/expander :std/test :clan/poo/object
        :gerbil-ascent/program/interface
        (only-in :gerbil-ascent/interface/closed-source ascent-closed-dsl-parts)
        (only-in :gerbil-ascent/interface/closed-evidence ascent-closed-evidence-scope)
        (only-in :gerbil-ascent/evidence/declaration evidence-module-program evidence-module-bindings evidence-module-explain))
(def (check! actual expected) (unless (equal? actual expected) (error "closed lowering mismatch" actual expected)))
(def (macro-part form)
  (parameterize ((current-expander-context (make-top-context)))
    (core-expand '(import :gerbil/core :gerbil-ascent/program/syntax :gerbil-ascent/program/interface))
    (eval-syntax form #t)))
(def (with-facts part facts)
  (gerbil-ascent-program
   (map (lambda (r) (.o (:: @ r) rows: (cond ((assq (.ref r 'name) facts) => cdr) (else []))))
        (.ref part 'relations))
   (.ref part 'rules)))
(def (answers part facts)
  (with-catch (lambda (failure) (list 'error (error-message failure)))
    (lambda ()
      (let (result (gerbil-ascent-evaluate-program (with-facts part facts)))
        (map (lambda (r) (cons (.ref r 'name) ((.ref result 'rows-of) (.ref r 'name))))
             (.ref part 'relations))))))
(def (signature part)
  (map (lambda (r) (list (.ref r 'name) (.ref r 'arity) (.ref r 'rows) (.ref r 'field-predicates)))
       (.ref part 'relations)))
(def (parity form facts)
  (let* ((parts (ascent-closed-dsl-parts [form])) (direct (and parts (car parts)))
         (reference (macro-part form)))
    (unless direct (error "fixture not recognized" form))
    (check! (signature direct) (signature reference))
    (check! (answers direct facts) (answers reference facts))
    (check! (length (.ref direct 'rules)) (length (.ref reference 'rules)))))

(export closed-dsl-test)
(def closed-dsl-test
  (test-suite "Closed DSL native lowering"
    (test-case "original macro and canonical constructors preserve answers and errors"
  (for-each (lambda (expression)
    (parity `(ascent-fragment
       (relation input ((x integer?))) (relation output ((x integer?)))
       ((output X) <-- (input X) (if (X) ,expression))) '((input (0) (1) (2) (-1)))))
    '((< X 2) (<= X 1) (>= X 0) (> X -1) (= X 0) (even? X)
      (and) (or) (and #f (even? "invalid")) (or 0 (even? "invalid"))
      (and (>= X 0) (<= (+ X 1) 2)) (not (odd? X))
      (zero? (* X X)) (positive? (- X 1)) (negative? X)))
  (parity '(ascent-fragment
    (relation input ((x string?) (y string?))) (relation output ((x string?)))
    ((output V) <-- (input V W) (if (V W) (not (equal? V W)))))
    '((input ("a" "a") ("a" "b") ("" "") ("" "b"))))
  (parity '(ascent-fragment
    (relation input ((x integer?))) (relation output ((x integer?)))
    ((output V) <-- (input V) (if (V) (equal? V 1))))
    '((input (0) (1) (2))))
  (parity '(ascent-fragment
    (relation edge ((x symbol?) (y symbol?))) (relation path ((x symbol?) (y symbol?)))
    ((path X Y) <-- (edge X Y)) ((path X Y) <-- (edge X Z) (path Z Y)))
    '((edge (a b) (b c) (c a))))
  (for-each (lambda (form) (check! (ascent-closed-dsl-parts [form]) #f))
    '((ascent-fragment (relation x (a)))
      (ascent-fragment (relation x ((a integer?))) (fact x (1)))
      (ascent-fragment ((x X) <-- (if (+) (+ 1 2))))
      (ascent-fragment ((x X) <-- (if (equal?) (equal? equal? equal?))))
      (ascent-fragment ((x X) <-- (if (X) (equal? X))))
      (ascent-fragment ((x X) <-- (if (W X Y Z) (begin (> W X)))))
      (ascent-fragment ((x X) <-- (if (X) (unknown X))))
      (ascent-fragment ((x X) <-- (guard (X) (lambda (X) #t))))
      (ascent-fragment (bounds 1 1 1))))

      (parity '(ascent-fragment
        (relation input ((x symbol?))) (relation blocked ((x symbol?)))
        (relation output ((x symbol?))) (relation other ((x symbol?)))
        (((output X) (other X)) <-- (input X) (not (blocked X))))
        '((input (a) (_)) (blocked (_))))
      (parity '(ascent-fragment
        (relation input ((x symbol?))) (relation output ((x symbol?)))
        ((output (lit '_)) <-- (input _))) '((input (a) (b))))
      ;; A later unsupported form selects the macro route before an invalid
      ;; recognized declaration can construct or validate any POO object.
      (check! (ascent-closed-dsl-parts
        '((ascent-fragment (relation x ((a symbol?))) (relation x ((a integer?))))
          (ascent-fragment ((x X) <-- (guard (X) (lambda (X) #t)))))) #f))
    (test-case "guards preserve fixed arity through the complete generated factory"
      (for-each (lambda (inputs)
        (let* ((form `(ascent-fragment ((answer X) <-- (input X) (if ,inputs #t))))
               (direct (car (ascent-closed-dsl-parts [form])))
               (reference (macro-part form))
               (a (.ref (cadr (.ref (car (.ref direct 'rules)) 'body)) 'predicate))
               (b (.ref (cadr (.ref (car (.ref reference 'rules)) 'body)) 'predicate)))
          (check! (apply a (map (lambda (_) 1) inputs)) #t)
          (check! (apply b (map (lambda (_) 1) inputs)) #t)
          (for-each (lambda (f)
            (check! (with-catch (lambda (_) 'wrong-arity)
                        (lambda () (apply f (make-list (+ 1 (length inputs)) 1)))) 'wrong-arity))
            [a b]))) (map (lambda (n) (map (lambda (i) (string->symbol (string-append "V" (number->string i)))) (iota n))) (iota 33)))
      (let (form '(ascent-fragment ((answer X) <-- (input X) (if (W X Y Z) (begin #t)))))
        (check! (ascent-closed-dsl-parts [form]) #f)
        (check! (apply (.ref (cadr (.ref (car (.ref (macro-part form) 'rules)) 'body)) 'predicate) '(1 2 3 4)) #t))
      (check! (ascent-closed-dsl-parts
        `((ascent-fragment ((answer X) <-- (input X)
                            (if ,(map (lambda (i) (string->symbol (string-append "V" (number->string i)))) (iota 33)) #t))))) #f))
    (test-case "canonical equality retains structural values and primitive arity"
      (let* ((form '(ascent-fragment ((output V) <-- (input V W) (if (V W) (equal? V W)))))
             (direct (car (ascent-closed-dsl-parts [form])))
             (reference (macro-part form))
             (a (.ref (cadr (.ref (car (.ref direct 'rules)) 'body)) 'predicate))
             (b (.ref (cadr (.ref (car (.ref reference 'rules)) 'body)) 'predicate)))
        (for-each (lambda (arguments)
          (check! (apply a arguments) (apply b arguments)))
          '(("a" "a") ("a" "b") ((a (1 2)) (a (1 2)))
            ((a (1 2)) (a (2 1))) (#(a 1) #(a 1)) ("1" 1) (#f #f)))
        (for-each (lambda (f)
          (check! (with-catch (lambda (_) 'wrong-arity) (lambda () (f "a"))) 'wrong-arity)) [a b])))
    (test-case "whole Evidence inventories preserve original constructors and export ownership"
      (let* ((form '(define-evidence (make-audit)
                     (sources (incoming edge)) (outputs path)
                     (relation edge ((x symbol?) (y symbol?)))
                     (relation path ((x symbol?) (y symbol?)))
                     ((path X Y) <-- (edge X Y))
                     ((path X Y) <-- (edge X Z) (path Z Y))))
             (scope (ascent-closed-evidence-scope [form] '(make-audit)))
             (a (scope "make-audit" []))
             (b (scope "make-audit" []))
             (reference
              (parameterize ((current-expander-context (make-top-context)))
                (core-expand '(import :gerbil/core :gerbil-ascent/evidence/interface))
                (eval-syntax `(let () ,form (make-audit)) #t))))
        (check! (eq? a b) #f)
        (check! (eq? (evidence-module-program a) (evidence-module-program b)) #f)
        (check! (evidence-module-bindings a) (evidence-module-bindings reference))
        (check! (signature (evidence-module-program a)) (signature (evidence-module-program reference)))
        (check! (answers (evidence-module-program a) '((edge (a b) (b c))))
                (answers (evidence-module-program reference) '((edge (a b) (b c)))))
        (check! (hash-get ((evidence-module-explain a) (evidence-module-program a) #f "path" "scope") "status") "recorded-only")
        (for-each (lambda (call)
          (check! (with-catch (lambda (_) 'rejected) call) 'rejected))
          [(lambda () (scope "unknown" [])) (lambda () (scope "make-audit" [1]))
           (lambda () (scope 1 []))])
        (check! (ascent-closed-evidence-scope [form form] #t) #f)
        (check! (ascent-closed-evidence-scope [form] '(unknown)) #f)
        (check! (ascent-closed-evidence-scope [form '(def helper 1)] #t) #f))
      (for-each (lambda (form)
        (check! (ascent-closed-evidence-scope [form] #t) #f))
        '((define-evidence (make-audit argument) (sources) (outputs))
          (define-evidence (make-audit) (sources) (outputs) (explain #f))
          (define-evidence (integer?) (sources) (outputs))
          (define-evidence (make-audit) (sources) (outputs) (bounds 1 2 3)))))))
