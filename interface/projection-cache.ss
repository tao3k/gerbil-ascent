;;; Reuse only private projection object graphs, never a validation result or wire value.
(import (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/program/objects gerbil-ascent-program)
        (only-in :gerbil-ascent/program/types gerbil-ascent-relation-with-rows
                 gerbil-ascent-projection-tree-current? gerbil-ascent-check-projection-program))
(export ascent-projection-program)
(defstruct projection-cache (generation relations rules handles limits program) final: #t)
(def (same-references? left right)
  (cond ((null? left) (null? right))
        ((null? right) #f)
        (else (and (eq? (car left) (car right))
                   (same-references? (cdr left) (cdr right))))))
(def (fresh-program original sources)
  (gerbil-ascent-program
    (map (lambda (relation)
      (let (source (assq (.ref relation 'name) sources))
        (if source (gerbil-ascent-relation-with-rows relation (cdr source)) relation)))
      (.ref original 'relations))
    (.ref original 'rules) (.ref original 'max-input-facts)
    (.ref original 'max-derived-facts) (.ref original 'max-output-facts)
    (.ref original 'source-handles)))
(def (ascent-projection-program original sources generation previous)
  (if (not (gerbil-ascent-projection-tree-current? original))
    (values (fresh-program original sources) #f)
    (let ((relations (.ref original 'relations)) (rules (.ref original 'rules))
          (handles (.ref original 'source-handles))
          (limits (list (.ref original 'max-input-facts) (.ref original 'max-derived-facts)
                        (.ref original 'max-output-facts))))
      (if (and previous (= generation (projection-cache-generation previous))
               (same-references? relations (projection-cache-relations previous))
               (eq? rules (projection-cache-rules previous))
               (equal? handles (projection-cache-handles previous))
               (equal? limits (projection-cache-limits previous)))
        (values (gerbil-ascent-check-projection-program (projection-cache-program previous)) previous)
        (let (program (fresh-program original sources))
          (values program (make-projection-cache generation (map identity relations) rules
                            (map identity handles) limits program)))))))
