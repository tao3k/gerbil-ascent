(import :gerbil/runtime/gambit
        (only-in :clan/poo/object .o .ref object-revision compute-precedence-list!)
        :gerbil-ascent/core/positive-plan
        (only-in :gerbil-ascent/t/qualification/fixtures/semi-naive/recursive recursive-declaration recursive-rules)
        (only-in :gerbil-ascent/t/qualification/fixtures/semi-naive/oracle finite-domain-closure)
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/table/provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/table/storage gerbil-ascent-set-storage-provider)
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-evaluate-program)
        (rename-in (only-in :gerbil-ascent/t/performance/index-entry/reference-evaluate
                           gerbil-ascent-evaluate-program)
                   (gerbil-ascent-evaluate-program old-evaluate))
        :gerbil-ascent/t/performance/index-entry/fixture)
(export main measure measure-pair paired empty-workflow empty-parity
        continuation-calibration metadata-calibration movable-calibration prime-equality-state!
        allocation-interval-verdict)
;;; Read-only native snapshots are diagnostic inputs, never replacement gate
;;; bytes. Positions 0..7 decompose the counter; 8..12 describe sections;
;;; 13..15 are stack-start, frame and break addresses. No-GC intervals bound
;;; legitimate section occupation independently of object/contract contents.
;;; A within-bound verdict is NOT an accounting or performance admission.
(def (allocation-interval-verdict before after section-bytes gc-before gc-after)
  (def (snapshot? value)
    (and (vector? value) (= (vector-length value) 16)
         (andmap (lambda (i)
                   (let (n (vector-ref value i))
                     (and (real? n) (integer? n) (<= (abs n) 9007199254740991)))) (iota 16))
         (= (vector-ref value 0)
            (apply + (map (cut vector-ref value <>) (iota 7 1))))
         (andmap (lambda (i) (>= (vector-ref value i) 0)) (iota 5 8))
         (andmap (lambda (i) (> (vector-ref value i) 0)) '(13 14 15))))
  (unless (and (snapshot? before) (snapshot? after)
               (exact-integer? section-bytes) (> section-bytes 0)
               (real? gc-before) (integer? gc-before) (>= gc-before 0)
               (real? gc-after) (integer? gc-after) (>= gc-after gc-before))
    (error "invalid native allocation diagnostic snapshot"))
  (let* ((sections (- (vector-ref after 10) (vector-ref before 10)))
         (ledger (- (vector-ref after 2) (vector-ref before 2)))
         ;; Both semispaces and both existing active regions are included.
         ;; This intentionally loose bound is a diagnostic, not a new gate.
         (bound (* 2 section-bytes (+ sections 2)))
         (address-gap (* 2 (- (vector-ref before 13) (vector-ref after 13)))))
    (cond
      ((not (= gc-before gc-after)) 'collection-boundary)
      ((or (< sections 0) (not (= (vector-ref before 1) (vector-ref after 1)))) 'unreviewed-transition)
      ((<= (abs ledger) bound) 'within-region-bound)
      ((and (not (= (vector-ref before 9) (vector-ref after 9)))
            (<= (abs (- ledger address-gap)) bound)) 'cross-region-address-gap)
      (else 'unexplained-ledger))))
;;; Diagnostic calibration only, never substitutes for the frozen rule task.
;;; Both return an immediate integer, so no result graph survives into arm two.
(def (continuation-calibration)
  (let loop ((n 0) (total 0))
    (if (= n 100) total
      (loop (+ n 1) (+ total (call-with-current-continuation (lambda (return) (return n))))))))
(def (metadata-calibration)
  (let loop ((n 0) (total 0))
    (if (= n 100) total
      (let (object (.o (value n)))
        (loop (+ n 1) (+ total (.ref object 'value)))))))
(def (movable-calibration)
  (let loop ((n 0) (rows []))
    (if (= n 1000000) (length rows)
      (loop (+ n 1) (cons n rows)))))
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (prime-equality-state! compare?)
  ;; Fixed, acyclic control data only. Never substitutes for a task comparison.
  (let ((a (make-list 30000 0)) (b (make-list 30000 0)))
    (if compare?
      (unless (and (equal? a b) (equal? (list 0) (list 0)))
        (error "equality preparation rejected identical control data"))
      (unless (and (= (length a) 30000) (= (length b) 30000))
        (error "allocation preparation differs")))))
(def (measure call repetitions (normalize? #f) (collections 1) (prime #f))
  (unless (and (procedure? call) (exact-integer? repetitions) (> repetitions 0) (boolean? normalize?)
               (memv collections '(1 2)) (memq prime '(#f allocation equality)))
    (error "invalid complete-call measurement contract"))
  ;; Same primitive/precondition as paired-study.ss. Keep its cost separate;
  ;; every collection occurring inside the complete call remains in the gate.
  (let* ((preparation (and normalize? (##process-statistics)))
         (preparation-start (and normalize? (current-jiffy)))
         (hint-prior ##equal-hint)
         (_prime (when prime (prime-equality-state! (eq? prime 'equality))))
         (_collect (when normalize? (##gc) (when (= collections 2) (##gc))))
         (counter (make-f64vector 2 0.0))
         (call-bytes (make-f64vector (* 2 repetitions) 0.0))
         (processors (make-vector (* 2 repetitions) #f))
         (before (##process-statistics)) (start (current-jiffy)) (hint-before ##equal-hint))
    (##get-bytes-allocated! counter 0)
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (begin
          (##get-bytes-allocated! counter 1)
          (let* ((hint-after ##equal-hint) (call-end (current-jiffy)) (after (##process-statistics)) (end (current-jiffy))
                 (cpu (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                            (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions))
                 (gc-cpu (/ (- (+ (f64vector-ref after 3) (f64vector-ref after 4))
                               (+ (f64vector-ref before 3) (f64vector-ref before 4))) repetitions)))
            (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                    cpu (/ (- end start) (* repetitions (jiffies-per-second)))
                    (list
                     (cons 'gc-count (- (f64vector-ref after 6) (f64vector-ref before 6)))
                     (cons 'equality-hint-prior hint-prior)
                     (cons 'equality-hint-before hint-before)
                     (cons 'equality-hint-after hint-after)
                     (cons 'gc-epoch (f64vector-ref before 6))
                     (cons 'statistics-bytes-before (f64vector-ref before 7))
                     (cons 'statistics-bytes-after (f64vector-ref after 7))
                     (cons 'direct-bytes-before (f64vector-ref counter 0))
                     (cons 'direct-bytes-after (f64vector-ref counter 1))
                     (cons 'call-byte-ranges (f64vector->list call-bytes))
                     (cons 'processors (vector->list processors))
                     (cons 'gc-cpu gc-cpu)
                     (cons 'gc-wall (/ (- (f64vector-ref after 5) (f64vector-ref before 5)) repetitions))
                     (cons 'cpu-minus-gc (- cpu gc-cpu))
                     (cons 'direct-bytes (/ (- (f64vector-ref counter 1) (f64vector-ref counter 0)) repetitions))
                     (cons 'statistics-getter-bytes (f64vector-ref after 9))
                     (cons 'statistics-tail-wall (/ (- end call-end) (* repetitions (jiffies-per-second))))
                     (cons 'minor-faults (- (f64vector-ref after 10) (f64vector-ref before 10)))
                     (cons 'major-faults (- (f64vector-ref after 11) (f64vector-ref before 11)))
                     (cons 'start-last-gc-live (f64vector-ref before 17))
                     (cons 'start-last-gc-heap (f64vector-ref before 15))
                     (cons 'start-last-gc-movable (f64vector-ref before 18))
                     (cons 'start-last-gc-still (f64vector-ref before 19))
                     (cons 'preparation-cpu (and preparation
                       (- (+ (f64vector-ref before 0) (f64vector-ref before 1))
                          (+ (f64vector-ref preparation 0) (f64vector-ref preparation 1)))))
                     (cons 'preparation-wall (and preparation-start
                       (/ (- start preparation-start) (jiffies-per-second))))
                     (cons 'preparation-gcs (and preparation
                       (- (f64vector-ref before 6) (f64vector-ref preparation 6))))))))
        (let ((offset (* 2 (- repetitions left))))
          (vector-set! processors offset (##current-processor-id))
          (##get-bytes-allocated! call-bytes offset)
          (let (value (call))
            (##get-bytes-allocated! call-bytes (+ 1 offset))
            (vector-set! processors (+ 1 offset) (##current-processor-id))
            (loop (- left 1) value)))))))
;;; One compiled measurement call site, while retaining the same two results.
;;; Diagnostic callers may project data and explicitly retain/release raw roots.
(def (measure-pair first second repetitions normalize? (project values) (retain? #f))
  (let loop ((pending (list first second)) (packets []) (roots []))
    (if (null? pending) (values (reverse packets) roots)
      (let-values (((result bytes cpu wall diagnostic) (measure (car pending) repetitions normalize?)))
        (let (payload (project result))
          (loop (cdr pending) (cons (vector payload bytes cpu wall diagnostic) packets)
                (if retain? (cons result roots) roots)))))))
(def (paired name old new parity repetitions mode (normalize? #f) (collections 1) (prime #f))
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (aw []) (bw []) (diagnostics []) (wins 0) (wall-wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y z ad b u v w bd)
                      (if (even? sample)
                        (let*-values (((a x y z ad) (measure old repetitions normalize? collections prime))
                                      ((b u v w bd) (measure new repetitions normalize? collections prime))) (values a x y z ad b u v w bd))
                        (let*-values (((b u v w bd) (measure new repetitions normalize? collections prime))
                                      ((a x y z ad) (measure old repetitions normalize? collections prime))) (values a x y z ad b u v w bd)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (set! aw (cons z aw)) (set! bw (cons w bw))
          (set! diagnostics (cons (list sample (if (even? sample) 'AB 'BA) ad bd) diagnostics))
          (when (< w z) (set! wall-wins (+ wall-wins 1)))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "INDEX-ENTRY-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50" " old-wall-us=" (* 1000000 (median aw))
               " new-wall-us=" (* 1000000 (median bw)) " wall-wins=" wall-wins "/50") (force-output)
    (let* ((allocation-valid? (and (andmap (cut >= <> 0) ab) (andmap (cut >= <> 0) bb)))
           (pass? (or (eq? mode 'observe)
                      (and allocation-valid?
                           (case mode
                             ((empty-net)
                              (and (<= (median bb) (+ (median ab) 256))
                                   (<= (median bc) (* 0.85 (median ac))) (>= wins 35)
                                   (<= (median bw) (* 0.85 (median aw))) (>= wall-wins 35)))
                             ((large)
                              (and (<= (median bb) (+ (median ab) 256))
                                   (<= (median bc) (* 0.85 (median ac))) (>= wins 35)))
                             (else
                              (and (<= (median bb) (+ (median ab) 8192))
                                   (<= (median bc) (+ (* 1.05 (median ac)) 0.000020)))))))))
      ;; Gates are fixed before sampling: wide index kernels require
      ;; 15% CPU with 35 wins and <=256 bytes; controls <=8 KiB and <=5%+20 us.
      (list (cons 'name name) (cons 'passed? pass?)
            (cons 'measurement-mode mode)
            (cons 'performance-admitted? (and (not (eq? mode 'observe)) pass?)) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'allocation-valid? allocation-valid?)
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-wall aw) (cons 'new-wall bw) (cons 'wall-wins wall-wins)
            (cons 'old-wall-us (* 1000000 (median aw))) (cons 'new-wall-us (* 1000000 (median bw)))
            (cons 'gc-precondition? normalize?)
            (cons 'gc-precondition-collections (if normalize? collections 0))
            (cons 'equality-preparation prime)
            (cons 'sample-diagnostics (reverse diagnostics))
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))

;;; Same implementation, same three frozen source cuts, fresh engine and index
;;; for every solve. No cross-arm or cross-cut state survives. Metering is a
;;; separate run; the timed workflow includes declaration, admission, all index
;;; maintenance and result construction, with natural GC after shared warmup.
(def empty-cuts '(((0 1) (1 2) (2 3)) ((0 1) (1 2) (3 2)) ((0 1) (1 2) (2 3))))
(def (empty-workflow reuse? (observe #f))
  (map (lambda (edges)
         (when observe (observe 'before-declaration))
         (let (program (recursive-declaration edges))
           (when observe (observe 'after-declaration))
           (let (result (gerbil-ascent-evaluate-program program empty-bucket-reuse?: reuse?))
             (when observe (observe 'after-solve))
             result))) empty-cuts))
(def (empty-cut-parity edges left right)
      (let (truth (finite-domain-closure '(0 1 2 3)
                    (list (cons 'edge edges) '(path) '(answer)) recursive-rules))
        (for-each (lambda (result)
          (unless (.ref result 'finished) (error "unfinished empty bucket solve"))
          (for-each (lambda (name)
            (let ((rows ((.ref result 'rows-of) name)) (expected (cdr (assq name truth))))
              (unless (and (= (length rows) (length expected))
                           (andmap (lambda (row) (member row expected)) rows))
                (error "independent empty bucket oracle mismatch" name)))) '(edge path answer))) (list left right))))
(def (empty-parity a b) (for-each empty-cut-parity empty-cuts a b))
(def (empty-study scenario receipt)
  (let* ((sources
          (map (lambda (provider) (map (lambda (source) (cons source (object-revision source)))
                                       (compute-precedence-list! provider)))
               (list gerbil-ascent-hash-index-provider gerbil-ascent-set-storage-provider)))
         (left? (string=? scenario "empty-bb"))
         (right? (not (string=? scenario "empty-aa")))
         (costs (map (lambda (reuse?)
                       (cons reuse?
                         (map (lambda (edges)
                           ;; The collector owns exactly one solve. Keep each
                           ;; cut's independent receipt instead of reusing it.
                           (let* ((cost (make-positive-plan-cost #f))
                                  (result (call-with-positive-plan-cost cost
                                            (lambda () (gerbil-ascent-evaluate-program (recursive-declaration edges)
                                                         empty-bucket-reuse?: reuse?)))))
                             (empty-cut-parity edges result result)
                             (cons edges (positive-plan-cost-snapshot cost)))) empty-cuts))) '(#f #t)))
         (result (paired scenario (lambda () (empty-workflow left?)) (lambda () (empty-workflow right?))
                   empty-parity 4 (if (string=? scenario "empty-reuse") 'empty-net 'control) #t)))
    ;; The same sealed native receivers and C4 sources serve every arm. This
    ;; is an extent check through POO, not another cache or an approval token.
    (for-each (lambda (group) (for-each (lambda (entry)
      (unless (= (cdr entry) (object-revision (car entry)))
        (error "native provider source changed during measurement"))) group)) sources)
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port)
        (write (list '(implementation . same-native-evaluator)
                     '(paired-samples . 50) '(repetitions . 4) '(cuts-per-repetition . 3)
                     '(warmup-pairs . 4) (cons 'source-cuts empty-cuts)
                     '(limits 1000 10000 12000) (cons 'left-reuse? left?) (cons 'right-reuse? right?)
                     '(certificate-update-stores . 2) '(extra-fields-per-entry . 2)
                     (cons 'provider-source-revisions (map (lambda (group) (map cdr group)) sources))
                     (cons 'costs costs) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "empty bucket net-benefit gate failed" scenario))))
(def (main scenario library receipt)
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "index entry benchmark requires symmetric native modules" name))))
   '("program/index" "program/evaluate" "t/performance/index-entry/reference"
     "t/performance/index-entry/reference-evaluate" "t/performance/index-entry/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (if (member scenario '("empty-aa" "empty-bb" "empty-reuse"))
    (empty-study scenario receipt)
  (let* ((width (if (member scenario '("scalar" "solve-small")) 1 64))
         (rows (map (lambda (n) (map (lambda (c) (+ n c)) (iota width))) (iota 128)))
         (atom (index-entry-atom (iota width) (iota width)))
         (mode (if (member scenario '("all" "delta" "advance")) 'large 'control))
         (result
          (cond
           ((member scenario '("all" "delta" "scalar"))
            (let* ((a (index-entry-harness #t rows gerbil-ascent-hash-index-provider))
                   (b (index-entry-harness #f rows gerbil-ascent-hash-index-provider))
                   (delta? (string=? scenario "delta"))
                   (old (lambda () ((vector-ref a 0) atom [] delta? #f)))
                   (new (lambda () ((vector-ref b 0) atom [] delta? #f))))
              (paired scenario old new
                      (lambda (a b) (unless (and (equal? a (list (car rows))) (equal? b a)) (error "warm lookup parity")))
                      512 mode)))
           ((string=? scenario "advance")
            (let* ((a (index-entry-harness #t rows gerbil-ascent-hash-index-provider))
                   (b (index-entry-harness #f rows gerbil-ascent-hash-index-provider)))
              (def (step h)
                ((vector-ref h 1) 0 (list (car rows)))
                (vector-set! (vector-ref h 6) 0 (+ 1 (vector-ref (vector-ref h 6) 0)))
                ((vector-ref h 0) atom [] #f #f))
              ((vector-ref a 0) atom [] #f #f) ((vector-ref b 0) atom [] #f #f)
              (paired scenario (lambda () (step a)) (lambda () (step b))
                      (lambda (a b) (unless (and (equal? a b) (equal? (car a) (car rows))) (error "advanced entry parity")))
                      10 mode)))
           ((string=? scenario "cold")
            (paired scenario
                    (lambda () ((vector-ref (index-entry-harness #t rows gerbil-ascent-hash-index-provider) 0) atom [] #f #f))
                    (lambda () ((vector-ref (index-entry-harness #f rows gerbil-ascent-hash-index-provider) 0) atom [] #f #f))
                    (lambda (a b) (unless (and (equal? a b) (equal? a (list (car rows)))) (error "cold index parity"))) 10 mode))
           ((string=? scenario "solve-sharing")
            (let* ((program (index-sharing-program 40)) (expected (map list (iota 40))))
              (paired scenario (lambda () (old-evaluate program))
                      (lambda () (gerbil-ascent-evaluate-program program))
                      (lambda (a b)
                        (for-each (lambda (result)
                                    (unless (equal? (list-sort (lambda (a b) (< (car a) (car b)))
                                                    (index-entry-result-rows result)) expected)
                                      (error "shared index independent truth mismatch"))) (list a b)))
                      1 'observe)))
           ((member scenario '("solve-wide" "solve-small"))
            (let* ((program (index-entry-program 128 width 4)) (expected (map list (iota 128))))
              (paired scenario (lambda () (old-evaluate program)) (lambda () (gerbil-ascent-evaluate-program program))
                      (lambda (a b)
                        (unless (and (equal? (index-entry-result-rows a) (index-entry-result-rows b))
                                     (equal? (list-sort (lambda (a b) (< (car a) (car b))) (index-entry-result-rows b)) expected))
                          (error "complete indexed solve parity"))) 10 mode)))
           (else (error "unknown index entry scenario" scenario)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline 'a890b9919504f1daadb9990aa501797777a00856)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "index entry CPU/allocation gate failed" scenario))))
  (displayln "OK") (force-output))
