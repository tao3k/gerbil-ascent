(import :gerbil/runtime/gambit :asp-gerbil-scheme/benchmark-api)
(export run-paired-study)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure-cpu call)
  (let (before (##process-statistics))
    (let (result (call))
      (let (after (##process-statistics))
        (values result
         (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
            (+ (f64vector-ref before 0) (f64vector-ref before 1)))
         (- (+ (f64vector-ref after 3) (f64vector-ref after 4))
            (+ (f64vector-ref before 3) (f64vector-ref before 4)))
         (- (f64vector-ref after 6) (f64vector-ref before 6)))))))
(def (measure-allocation call)
  ;; Normalize the allocation leg's starting heap before reading the VM counter.
  ;; CPU pairs retain natural GC; this collection is outside allocation accounting.
  (##gc)
  (let (counter (make-f64vector 2 0.0))
    (##get-bytes-allocated! counter 0)
    (let (result (call))
      (##get-bytes-allocated! counter 1)
      (let (bytes (- (f64vector-ref counter 1) (f64vector-ref counter 0)))
        (when (< bytes 0) (error "nonmonotone VM allocation" bytes))
        (values result bytes)))))
(def (measure-allocation-batches call count)
  ;; Preserve every declared trajectory, but assemble results outside the VM
  ;; counter intervals. This matches the existing complete-lookup protocol.
  (let loop ((pending count) (results []) (bytes 0))
    (if (zero? pending)
      (values (apply append (reverse results)) bytes)
      (let-values (((result allocated) (measure-allocation call)))
        (loop (- pending 1) (cons result results) (+ bytes allocated))))))
(def (run-paired-scenario contract prepare consume expected-for scenario receipt-path)
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid PAIRED-STUDY execution fixture"))
  (def (get key) (benchmark-fixture-ref contract key))
  (def config (assq (string->symbol scenario) (get 'scenarios)))
  (unless config (error "unknown PAIRED-STUDY execution scenario" scenario))
  (with ([ratio overhead minimum-wins] (cdr config))
    (let* ((input (string->symbol scenario))
           (old-state (prepare #t input))
           (new-state (prepare #f input))
           (expected (make-list (get 'trajectoriesPerSample) (expected-for old-state input)))
           (old-call (lambda ((count (get 'trajectoriesPerSample))) (map (lambda (_) (consume old-state input #t)) (iota count))))
           (new-call (lambda ((count (get 'trajectoriesPerSample))) (map (lambda (_) (consume new-state input #f)) (iota count))))
           (admission-state (prepare #f input)) (ab []) (bb []) (ac []) (bc []) (agc []) (bgc []) (agn []) (bgn []) (samples 0) (admissions 0) (wins 0))
      (def (check-results x y)
        (unless (and (equal? x y) (equal? y expected))
          (error "PAIRED-STUDY execution lifecycle differs" scenario)))
      (def (allocation call)
        (cond
          ((assq 'allocationBatchSize contract) =>
           (lambda (batch)
             (let ((size (cdr batch)) (total (get 'trajectoriesPerSample)))
               (unless (and (exact-integer? size) (> size 0) (zero? (modulo total size)))
                 (error "invalid PAIRED-STUDY allocation batch" size total))
               (measure-allocation-batches (cut call size) (quotient total size)))))
          (else (measure-allocation call))))
      (def (sample)
        (let-values (((x v gx nx y q gy ny)
          (if (even? samples)
            (let-values (((x v gx nx) (measure-cpu old-call)) ((y q gy ny) (measure-cpu new-call)))
              (values x v gx nx y q gy ny))
            (let-values (((y q gy ny) (measure-cpu new-call)) ((x v gx nx) (measure-cpu old-call)))
              (values x v gx nx y q gy ny)))))
          (check-results x y)
          (set! ac (cons v ac)) (set! bc (cons q bc))
          (set! agc (cons gx agc)) (set! bgc (cons gy bgc))
          (set! agn (cons nx agn)) (set! bgn (cons ny bgn))
          (when (< q v) (set! wins (+ wins 1))))
        (set! samples (+ samples 1))
        (displayln "PAIRED-STUDY-CPU " scenario " " samples "/20"
                   " old-us=" (* (car ac) 1000000) " new-us=" (* (car bc) 1000000)
                   " old-gc=" (car agn) " new-gc=" (car bgn))
        (force-output)
        samples)
      ;; Whole-export samples are calibrated above 20ms before final timing.
      ;; Both legs run the same fixed repetitions; every natural GC remains
      ;; charged to CPU. Admission measures only the candidate's full sample.
      (##gc)
      (for-each (lambda (_) (sample)) (iota 20))
      ;; ASP owns its group precondition; do not collect again before entering it.
      (let-values (((api-receipt _)
                    (benchmark-run/result contract
                     (lambda ()
                       (let (result (map (lambda (_) (consume admission-state input #f)) (iota (get 'trajectoriesPerSample))))
                         (check-results expected result)
                         (set! admissions (+ admissions 1))
                         (displayln "PAIRED-STUDY-ADMISSION " scenario " " admissions "/20")
                         (force-output) result)))))
        (for-each
         (lambda (index)
           (let-values (((x u y p)
             (if (even? index)
               (let-values (((x u) (allocation old-call))
                            ((y p) (allocation new-call))) (values x u y p))
               (let-values (((y p) (allocation new-call))
                            ((x u) (allocation old-call))) (values x u y p)))))
             (check-results x y)
             (set! ab (cons u ab)) (set! bb (cons p bb)))
           (displayln "PAIRED-STUDY-ALLOCATION " scenario " " (+ index 1) "/"
                      (get 'allocationSampleCount)) (force-output))
         (iota (get 'allocationSampleCount)))
        (let* ((u (median ac)) (v (median bc)) (x (median ab)) (y (median bb))
               (pass? (and (= samples 20) (= admissions 20)
                           (= (length ab) (get 'allocationSampleCount))
                           (eq? (benchmark-fixture-ref api-receipt 'status) 'pass)
                           (<= v (+ (* u ratio) overhead)) (>= wins minimum-wins)
                           (<= y (+ (* x (if (memq input (get 'allocationTargets)) (get 'targetAllocationRatio) (get 'allocationRatio))) (get 'allocationOverheadBytes))))))
          (call-with-output-file receipt-path (lambda (out)
            (write (list (cons 'scenario scenario) (cons 'passed? pass?) (cons 'cpu-wins wins)
                         (cons 'old-cpu-us (* u 1000000)) (cons 'new-cpu-us (* v 1000000))
                         (cons 'old-bytes x) (cons 'new-bytes y) (cons 'asp-receipt api-receipt)
                         (cons 'old-cpu ac) (cons 'new-cpu bc)
                         (cons 'old-gc-cpu agc) (cons 'new-gc-cpu bgc)
                         (cons 'old-gc-count agn) (cons 'new-gc-count bgn)
                         (cons 'trajectories-per-sample (get 'trajectoriesPerSample))
                         (cons 'old-allocation ab) (cons 'new-allocation bb)) out)))
          (displayln "RESULT " scenario " " pass? " CPU-us " (* u 1000000) " -> " (* v 1000000)
                     " bytes " x " -> " y " wins=" wins) (force-output)
          (unless pass? (error "PAIRED-STUDY execution gate failed" scenario))))))
  (displayln "SCENARIO-OK " scenario) (force-output))
(def (run-paired-study contract prepare consume expected-for scenario receipt-path)
  (if (equal? scenario "all")
    (for-each (lambda (config)
      (let (name (symbol->string (car config)))
        (run-paired-scenario contract prepare consume expected-for name
          (path-expand (string-append name "-final.ss") receipt-path))))
      (benchmark-fixture-ref contract 'scenarios))
    (run-paired-scenario contract prepare consume expected-for scenario receipt-path))
  (displayln "OK") (force-output) (exit 0))
