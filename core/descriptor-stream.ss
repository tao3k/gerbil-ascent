(export gerbil-ascent-certificate-terms!)
(def (gerbil-ascent-certificate-terms! sources actions slots count head?)
  (let/cc reject
    (unless (and (list? actions) (= (length sources) (length actions))) (reject #f))
    (for-each
      (lambda (source action)
        (unless (pair? action) (reject #f))
        (case (car source)
          ((literal wildcard) (unless (equal? source action) (reject #f)))
          ((variable)
            (let (known (hash-get slots (cdr source)))
              (if known (if (and (eq? (car action) 'bound) (eqv? (cdr action) known)) (void) (reject #f)) (if head? (reject #f) (if (and (eq? (car action) 'fresh) (eqv? (cdr action) count)) (begin (hash-put! slots (cdr source) count) (set! count (+ count 1))) (reject #f))))))
          (else (reject #f)))) sources actions)
    count))
