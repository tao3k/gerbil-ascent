(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/t/performance/component-scope/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
;; VM cumulative allocation after completed GC sums all processor counters.
;; Keep this lane separate: its forced collections do not enter CPU timing.
(def (measure-allocation call repetitions)
  (##gc)
  (let (before (f64vector-ref (##process-statistics) 16))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (begin
          (##gc)
          (let (bytes (/ (- (f64vector-ref (##process-statistics) 16) before) repetitions))
            (when (< bytes 0) (error "nonmonotonic VM allocation counter"))
            (values result bytes)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "COMPONENT-SCOPE-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (let ((raw-old ab) (raw-new bb))
    (set! ab []) (set! bb [])
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x b y)
                      (if (even? sample)
                        (let-values (((a x) (measure-allocation old repetitions)) ((b y) (measure-allocation new repetitions))) (values a x b y))
                        (let-values (((b y) (measure-allocation new repetitions)) ((a x) (measure-allocation old repetitions))) (values a x b y)))))
          (parity a b) (set! ab (cons x ab)) (set! bb (cons y bb)))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "COMPONENT-SCOPE-VM-ALLOCATION-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass?
          (case mode
            ((plan) (and (<= (median bb) (* 0.30 (median ab)))
                         (<= (median bc) (* 0.70 (median ac))) (>= wins 35)))
            ((closure) (and (<= (median bb) (median ab))
                            (<= (median bc) (* 0.60 (median ac))) (>= wins 35)))
            (else (and (<= (median bb) (+ (median ab) 4096))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))))
      ;; Fixed gates: plan saves 70% allocation / 30% CPU / 35 wins;
      ;; Cached-baseline admission: 40% CPU / 35 wins, allocation nonincrease.
      ;; Preserve the separate 30% allocation forecast below, even when missed.
      ;; Per-processor actor samples included negative deltas and are disqualified.
      ;; The new cached baseline gates are declared before its samples. Controls <=4 KiB;
      ;; nonplan CPU overhead <=5%+20 us.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'allocation-target-met? (or (not (eq? mode 'closure)) (<= (median bb) (* 0.70 (median ab)))))
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-vm-allocation ab) (cons 'new-vm-allocation bb)
            (cons 'disqualified-processor-old-allocation raw-old) (cons 'disqualified-processor-new-allocation raw-new)
            (cons 'old-cpu ac) (cons 'new-cpu bc))))))
(def (main scenario library receipt)
  (unless (member scenario '("sparse-plan" "multihead-plan" "closure-one" "closure-four" "small"))
    (error "unknown component scope scenario" scenario))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "component scope requires symmetric native modules" name))))
   '("program/component-plan" "program/component-worker" "program/positive-components"
     "t/performance/component-scope/reference" "t/performance/component-scope/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((plan? (member scenario '("sparse-plan" "multihead-plan")))
         (small? (string=? scenario "small"))
         (count (if plan? 128 (if small? 1 16)))
         (width (if plan? 32 1))
         (size (if plan? 1 (if small? 1 256)))
         (request (component-scope-request (component-scope-program count width size (string=? scenario "multihead-plan"))))
         (jobs (if (string=? scenario "closure-four") 4 1))
         (expected (make-vector (+ count 1) (map list (iota size))))
         (result
          (paired scenario
                  (lambda () (if plan? (component-scope-plan #t request) (component-scope-run #t request jobs)))
                  (lambda () (if plan? (component-scope-plan #f request) (component-scope-run #f request jobs)))
                  (lambda (a b)
                    (if plan?
                      (unless (and (= (length a) (length b) (+ count 1))
                                   (equal? (component-scope-normalize #t a) (component-scope-normalize #f b)))
                        (error "ordered projected component metadata differs"))
                      (unless (and (equal? a b) (equal? b expected)) (error "component closure independent truth differs"))))
                  (if plan? 4 1)
                  (cond (plan? 'plan) (small? 'control) (else 'closure)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline 'f2d41a3018425c9eb103c1242177ebc2d4cb7daf)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "component scope allocation/CPU gate failed" scenario)))
  (displayln "OK") (force-output))
