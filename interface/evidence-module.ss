(import :gerbil/expander
        (only-in :gerbil/runtime/init gerbil-load-expander! __scheme-source)
        "generated-resources.ss"
        (only-in :std/hash/misc hash-key?)
        (only-in :gerbil/runtime/gambit current-readtable
                 readtable-eval-allowed?-set readtable-sharing-allowed?-set)
        (only-in :clan/poo/object .ref))
(export ascent-load-evidence-module ascent-load-evidence-source ascent-load-evidence-components ascent-evidence-module
        evidence-module? evidence-module-program evidence-module-explain evidence-module-bindings
        ascent-evidence-module-descriptors ascent-source-scope-count)

(defstruct evidence-module (program explain bindings) final: #t)
(def (ascent-evidence-module program (explain #f) (bindings []))
  (unless (or (not explain) (procedure? explain))
    (error "Evidence explanation must be a native procedure"))
  (unless (and (list? bindings) (andmap (lambda (b) (and (pair? b) (symbol? (car b)) (symbol? (cdr b)))) bindings))
    (error "Evidence bindings must pair public labels with native relation handles"))
  (make-evidence-module program explain bindings))

(def (ascent-evidence-module-descriptors program (bindings []))
  (def (kind predicate)
    (cond ((eq? predicate symbol?) "symbol")
          ((eq? predicate exact-integer?) "integer")
          ((eq? predicate boolean?) "boolean")
          ((eq? predicate string?) "string")
          (else "native")))
  (let (sources (.ref program 'source-handles))
    (unless (andmap (lambda (b) (memq (cdr b) (map (cut .ref <> 'name) (.ref program 'relations)))) bindings)
      (error "Evidence binding does not name a native relation"))
    (map (lambda (relation)
           (let* ((n (.ref relation 'name))
                  (binding (find (lambda (b) (eq? (cdr b) n)) bindings)))
             (hash ("name" (symbol->string (if binding (car binding) n)))
                   ("columns" (let (predicates (.ref relation 'field-predicates))
                     (if (pair? predicates)
                       (map (lambda (p) (hash ("kind" (kind p)))) predicates)
                       (make-list (.ref relation 'arity) (hash ("kind" "native"))))))
                   ("source" (and (memq n sources) #t)))))
         (.ref program 'relations))))

;; Modules are trusted host code, built by build.ss, not inert rule documents.
;; The constructor runs with the module's native lexical/macro environment.
(def (ascent-load-evidence-module module constructor arguments)
  (unless (and (string? module) (string-prefix? ":" module)
               (<= (string-length module) 4096)
               (string? constructor) (< 0 (string-length constructor) 129)
               (list? arguments))
    (error "invalid native Evidence module entry"))
  (gerbil-load-expander!)
  (ascent-with-generated-resources (lambda ()
    (parameterize ((current-expander-context (make-top-context)))
      (eval-syntax '(import :gerbil/core))
      (eval-syntax `(import (only-in ,(string->symbol module) ,(string->symbol constructor))))
      (let (builder (eval-syntax (string->symbol constructor) #t))
        (unless (procedure? builder) (error "Evidence constructor is not callable"))
        (apply builder arguments))))))

(def source-module-loads 0)
(def source-core-context #f)
(def (make-source-context)
  (gerbil-load-expander!)
  (unless source-core-context
    (let (context (make-top-context))
      (ascent-with-generated-resources (lambda ()
        (parameterize ((current-expander-context context))
          (eval-syntax '(import :gerbil/core)))))
      (set! source-core-context context)))
  ;; Each declaration has a fresh module namespace and private gensym aliases.
  ;; Reuse the import context; it does not own the user's lexical definitions.
  source-core-context)
(def (ascent-source-scope-count) source-module-loads)
;; Expansion can retain global bindings. Optional caller ceilings cover all
;; runtime admissions, including failed expansions; closing does not reclaim them.
(def (check-source-scopes count ceiling)
  (unless (or (not ceiling) (and (exact-integer? ceiling) (> ceiling 0)))
    (error "source scope ceiling must be a positive integer"))
  (when (and ceiling (> (+ source-module-loads count) ceiling))
    (error "source module runtime load limit")))
(def (ascent-load-evidence-source source trusted (ceiling #f))
  (load-evidence-scope source trusted #f (gensym 'ascent-source) [] #t ceiling))

(def (load-evidence-scope source trusted context namespace imports exports ceiling)
  (unless (and (eq? trusted #t) (string? source)
               (<= (u8vector-length (string->utf8 source)) 262144))
    (error "explicit trusted host Scheme authorization and Evidence DSL required"))
  (check-source-scopes 1 ceiling)
  (let* ((forms
          (parameterize ((current-readtable
                          (readtable-sharing-allowed?-set
                            (readtable-eval-allowed?-set (current-readtable) #f) #f)))
            (call-with-input-string source
              (lambda (port)
                (let loop ((forms []) (nodes 0))
                  (let (form (read port))
                    (if (eof-object? form) (reverse forms)
                      (let ()
                        (unless (and (< (length forms) 256) (list? form) (pair? form)
                                     (not (memq (car form) '(import export module))))
                          (error "Evidence definitions required; module/import/build scaffolding belongs to the Library"))
                        (def (visit value depth)
                          (set! nodes (+ nodes 1))
                          (unless (and (<= nodes 65536) (<= depth 128))
                            (error "native module source structure bound"))
                          (when (pair? value)
                            (visit (car value) (+ depth 1)) (visit (cdr value) depth)))
                        (visit form 0)
                        (loop (cons form forms) nodes)))))))))
         (aliases (make-hash-table-eq)))
    (unless (pair? forms) (error "Evidence DSL definitions required"))
    (set! source-module-loads (+ source-module-loads 1))
    (gerbil-load-expander!)
    (ascent-with-generated-resources (lambda ()
      (unless context (set! context (make-source-context)))
      (parameterize ((current-expander-context context))
        (eval-syntax `(module ,namespace
                       (import :gerbil-ascent/evidence/interface
                               :gerbil-ascent/evidence/module
                               (only-in :clan/poo/object .ref) ,@imports)
                       (export ,@(if (eq? exports #t) '(#t) exports)) ,@forms)))))
    (lambda (export arguments)
      (unless (and (string? export) (< 0 (string-length export) 129) (list? arguments))
        (error "invalid module export call"))
      (ascent-with-generated-resources (lambda ()
        (parameterize ((current-expander-context context))
          (let* ((identifier (string->symbol export))
                 (read-binding (or (hash-get aliases identifier)
                   (let (alias (gensym 'ascent-call))
                     (eval-syntax `(import (rename-in (only-in ,namespace ,identifier)
                                                   (,identifier ,alias))))
                     ;; Read the binding on every call; mutable exports are not cached values.
                     (let (read-binding (eval-syntax `(lambda () ,alias) #t))
                       (hash-put! aliases identifier read-binding) read-binding))))
                 (procedure (read-binding)))
            (unless (procedure? procedure) (error "module export is not callable"))
            (apply procedure arguments))))))))

;; The manifest is transport data. Dependency selection and hygienic linking
;; happen here, before any trusted user definition is evaluated.
(def (ascent-load-evidence-components manifest sources entry trusted (ceiling #f))
  (unless (eq? trusted #t) (error "explicit trusted host Scheme authorization required"))
  (def (fields value expected)
    (unless (and (hash-table? value) (= (hash-length value) (length expected))
                 (andmap (cut hash-key? value <>) expected))
      (error "invalid Evidence component manifest fields")))
  (def (label value)
    (unless (and (string? value) (< 0 (string-length value) 129))
      (error "invalid Evidence component label")) value)
  (def (labels values)
    (unless (list? values) (error "Evidence component labels must be a list"))
    (let (seen (make-hash-table))
      (for-each (lambda (value)
        (label value)
        (when (hash-key? seen value) (error "duplicate Evidence component binding" value))
        (hash-put! seen value #t)) values)) values)
  (fields manifest '("schema" "components"))
  (unless (equal? (hash-ref manifest "schema") "ascent.evidence-components.v1")
    (error "unsupported Evidence component manifest"))
  (unless (hash-table? sources) (error "Evidence component sources must be an object"))
  (let ((components (hash-ref manifest "components")) (index (make-hash-table))
        (state (make-hash-table)) (order []) (paths (make-hash-table)))
    (unless (and (list? components) (pair? components) (<= (length components) 64))
      (error "Evidence component inventory bound"))
    (for-each (lambda (component)
      (fields component '("id" "source" "exports" "dependencies"))
      (let ((id (label (hash-ref component "id"))) (path (hash-ref component "source")))
        (unless (and (string? path) (hash-key? sources path) (string? (hash-ref sources path)))
          (error "missing Evidence component source" path))
        (when (hash-key? index id) (error "duplicate Evidence component" id))
        (labels (hash-ref component "exports"))
        (unless (list? (hash-ref component "dependencies"))
          (error "Evidence dependencies must be a list"))
        (hash-put! index id component) (hash-put! paths path #t))) components)
    (unless (= (hash-length paths) (hash-length sources))
      (error "unregistered Evidence component source"))
    (for-each (lambda (component)
      (let (bindings [])
        (for-each (lambda (dependency)
          (fields dependency '("component" "bindings"))
          (let* ((id (label (hash-ref dependency "component"))) (target (hash-get index id))
                 (names (labels (hash-ref dependency "bindings"))))
            (unless target (error "missing Evidence component dependency" id))
            (unless (andmap (cut member <> (hash-ref target "exports")) names)
              (error "Evidence dependency binding not exported" id))
            (set! bindings (append names bindings)))) (hash-ref component "dependencies"))
        (labels bindings))) components)
    (def (visit id)
      (case (hash-get state id)
        ((visiting) (error "cyclic Evidence component dependency" id))
        ((done) (void))
        (else
          (let (component (hash-get index id))
            (unless component (error "unknown Evidence component entry" id))
            (hash-put! state id 'visiting)
            (for-each (lambda (dependency) (visit (hash-ref dependency "component")))
                      (hash-ref component "dependencies"))
            (hash-put! state id 'done) (set! order (cons id order))))))
    (label entry) (visit entry)
    (let (selected (reverse order))
      ;; Check unselected cycles without admitting their definitions or effects.
      (for-each (lambda (component) (visit (hash-ref component "id"))) components)
      (check-source-scopes (length selected) ceiling)
      (let ((context (make-source-context)) (namespaces (make-hash-table))
            (resolvers (make-hash-table)))
        (for-each (lambda (id)
          (let* ((component (hash-ref index id)) (namespace (gensym 'ascent-component))
                 (imports (map (lambda (dependency)
                   `(only-in ,(hash-ref namespaces (hash-ref dependency "component"))
                             ,@(map string->symbol (hash-ref dependency "bindings"))))
                   (hash-ref component "dependencies")))
                 (resolver (load-evidence-scope (hash-ref sources (hash-ref component "source"))
                             trusted context namespace imports
                             (map string->symbol (hash-ref component "exports")) ceiling)))
            (hash-put! namespaces id namespace) (hash-put! resolvers id resolver))) selected)
        (values (lambda (export arguments (component entry))
                  (let (resolver (hash-get resolvers component))
                    (unless resolver (error "Evidence component not loaded" component))
                    (resolver export arguments))) selected)))))
