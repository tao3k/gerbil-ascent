(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/candidate/program candidate-inspect)
        (only-in :gerbil-ascent/candidate/reasoning reasoning-source-snapshot)
        :gerbil-ascent/candidate/finite-evidence
        (rename-in (only-in :gerbil-ascent/t/performance/finite-replay/reference
                           candidate-finite-evidence candidate-verify-finite-evidence
                           finite-evidence-status finite-evidence-closure)
                   (candidate-finite-evidence old-generate)
                   (candidate-verify-finite-evidence old-verify)
                   (finite-evidence-status old-status)
                   (finite-evidence-closure old-closure)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call)
  (let (before (##process-statistics))
    (let loop ((left 10) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) 10)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) 10)))
        (loop (- left 1) (call))))))
(def (paired name old new parity mode)
  (##gc)
  (parity (old) (new))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old)) ((b u v) (measure new))) (values a x y b u v))
                        (let-values (((b u v) (measure new)) ((a x y) (measure old))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "REPLAY-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    ;; Fixed before sampling: wide and duplicate-support workloads must save
    ;; 20% CPU and allocation with 35 wins. Small/constant-support controls
    ;; admit at most 8 KiB and 20 us of per-call setup overhead for indexes.
    (unless (if (eq? mode 'large)
              (and (<= (median bb) (* 0.8 (median ab)))
                   (<= (median bc) (* 0.8 (median ac))) (>= wins 35))
              (and (<= (median bb) (+ (median ab) 8192))
                   (<= (median bc) (+ (median ac) 0.000020))))
      (error "finite replay allocation/CPU gate failed" name))
    (displayln "OK " name) (force-output)))
(def (main scenario library)
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "finite replay benchmark requires symmetric native modules" name))))
   '("candidate/funs" "candidate/finite-evidence" "candidate/types" "candidate/datum"
     "t/performance/finite-replay/reference-funs" "t/performance/finite-replay/reference"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (unless (member scenario '("wide" "duplicates" "small" "constant")) (error "unknown scenario" scenario))
  (let* ((unique (map list (iota (cond ((string=? scenario "wide") 256)
                                      ((string=? scenario "duplicates") 64)
                                      ((string=? scenario "small") 2) (else 1)))))
         (input (cond ((string=? scenario "duplicates") (apply append (make-list 4 unique)))
                      ((string=? scenario "constant") (make-list 64 (car unique)))
                      (else unique)))
         (native (if (member scenario '("small" "constant")) unique (reverse unique)))
         (expected (list (list 's 1 unique) (list 'p 1 unique)))
         (snapshot (reasoning-source-snapshot 'finite-benchmark 1 (list (list 's 1 input))))
         (spec (candidate-inspect snapshot
                 '(candidate (relation p 1) (rule (p ?x) (s ?x)) (rule (p ?x) (p ?x))
                             (query p ?x) (limits 1024 1024 1024))))
         (mode (if (member scenario '("wide" "duplicates")) 'large 'control))
         (old (lambda () (old-generate snapshot spec 'bench 'complete native 100000)))
         (new (lambda () (candidate-finite-evidence snapshot spec 'bench 'complete native 100000)))
         (parity (lambda (a b)
                   (unless (and (eq? (old-status a) 'complete)
                                (eq? (finite-evidence-status b) 'complete)
                                (equal? (old-closure a) expected)
                                (equal? (finite-evidence-closure b) expected))
                     (error "finite replay ordered closure parity"))))
         (a (old)) (b (new)))
    (parity a b)
    (paired (string-append scenario "-generate") old new parity mode)
    (paired (string-append scenario "-verify")
            (lambda () (old-verify snapshot spec 'bench 'complete native a 100000))
            (lambda () (candidate-verify-finite-evidence snapshot spec 'bench 'complete native b 100000))
            (lambda (a b) (unless (and (eq? a 'valid) (eq? b 'valid)) (error "finite verification parity"))) mode))
  (displayln "OK") (force-output))
