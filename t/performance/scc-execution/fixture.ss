(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/scc-execution/reference-evaluate old-))
(export scc-program scc-prepare scc-consume scc-expected scc-project)
(def (name prefix index) (string->symbol (string-append prefix (number->string index))))
(def (less-row? a b)
  (cond ((null? a) (pair? b)) ((null? b) #f)
        ((= (car a) (car b)) (less-row? (cdr a) (cdr b))) (else (< (car a) (car b)))))
(def (scc-program scenario)
  (let* ((x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)) (z (gerbil-ascent-variable 'z))
         (indexed? (eq? scenario 'indexed))
         (count (case scenario ((wide) 128) ((chain) 96) (else 1)))
         (padding (if (memq scenario '(wide chain)) 512 0))
         (source (if indexed? (map (lambda (i) (list i (+ i 1))) (iota 31))
                     (map list (iota (if (memq scenario '(small cold)) 1 8)))))
         (relations
           (append (list (gerbil-ascent-relation 'source (if indexed? 2 1) source))
             (map (lambda (i) (gerbil-ascent-relation (name "unused" i) 1 [])) (iota padding))
             (map (lambda (i) (gerbil-ascent-relation (name "out" i) (if indexed? 2 1) [])) (iota count))))
         (rules
           (if indexed?
             (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'out0 (list x y)))
                                      (list (gerbil-ascent-atom 'source (list x y))))
                   (gerbil-ascent-rule (list (gerbil-ascent-atom 'out0 (list x z)))
                                      (list (gerbil-ascent-atom 'out0 (list x y))
                                            (gerbil-ascent-atom 'source (list y z)))))
             (map (lambda (i)
                    (gerbil-ascent-rule (list (gerbil-ascent-atom (name "out" i) (list x)))
                      (list (gerbil-ascent-atom (if (and (eq? scenario 'chain) (> i 0))
                                                (name "out" (- i 1)) 'source) (list x))))) (iota count)))))
    (gerbil-ascent-program relations rules 200000 200000 200000)))
(def (scc-project result)
  (let (names (.ref result 'relation-names))
    (list (.ref result 'finished) names ((.ref result 'relation-sizes))
          (map (lambda (n) (list-sort less-row? ((.ref result 'rows-of) n))) names)
          (.ref result 'evaluation-path) (.ref result 'active-rule-count))))
(def (scc-prepare old? scenario)
  (let* ((program (scc-program scenario))
         (relations (.ref program 'relations))
         (source (.ref (car relations) 'rows))
         (outputs (if (eq? scenario 'indexed)
                    (apply append (map (lambda (i) (map (lambda (j) (list i j))
                                                     (iota (- 31 i) (+ 1 i)))) (iota 31))) source))
         (rows (map (lambda (r) (case (.ref r 'name) ((source) source)
                                 (else (if (string-prefix? "out" (symbol->string (.ref r 'name))) outputs [])))) relations))
         (names (map (cut .ref <> 'name) relations))
         (expected (list #t names (map (lambda (n rs) (cons n (length rs))) names rows) rows
                         'stratified-semi-naive (length (.ref program 'rules)))))
    ;; Admit analysis outside warm clocks, without solving or deriving expected rows.
    ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t)
    (vector program expected)))
(def (scc-consume state scenario old?)
  (let* ((program (if (eq? scenario 'cold) (scc-program scenario) (vector-ref state 0)))
         (jobs (if (eq? scenario 'serial) 1 (##cpu-count)))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine)
                  program #f #f #f #f #f #f jobs)))
    (scc-project (engine))))
(def (scc-expected state scenario) (vector-ref state 1))
