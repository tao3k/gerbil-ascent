(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/table/interface gerbil-ascent-trrel-uf-storage-provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/view-lattice-round/reference-evaluate old-)
        (prefix-in :gerbil-ascent/t/performance/scc-execution/fixture scc-)
        (prefix-in :gerbil-ascent/t/performance/round-workspace/fixture set-))
(export vl-program vl-prepare vl-consume vl-expected vl-project)
(def (limit scenario) (case scenario ((view mixed) 64) ((lattice) 128) ((custom) 16) (else 1)))
(def (padding scenario) (case scenario ((view lattice) 512) ((mixed) 384) (else 0)))
(def (name i) (string->symbol (string-append "unused" (number->string i))))
(def (view name rows)
  (gerbil-ascent-relation name 2 rows gerbil-ascent-hash-index-provider gerbil-ascent-trrel-uf-storage-provider))
(def (star n)
  (append (map (lambda (i) (list 0 i)) (iota (+ n 1)))
          (map (lambda (i) (list i i)) (iota n 1))))
;; Match production DSL composition: all declarations remain present and the
;; complete program is validated in the ordinary environment on scope exit.
;; The separate public-constructor tests retain immediate validation coverage.
(def (vl-program scenario)
  (gerbil-ascent-construct-inert-program (lambda () (vl-program-declarations scenario))))
(def (vl-program-declarations scenario)
  (if (eq? scenario 'set) (set-round-program 'serial)
    (let* ((v (gerbil-ascent-variable 'v)) (next (gerbil-ascent-variable 'next))
           (key (gerbil-ascent-literal 0)) (n (limit scenario))
           (custom (.o (:: @ gerbil-ascent-hash-index-provider))))
      (def (atom name) (gerbil-ascent-atom name (list key v)))
      (def (step destination source)
        (gerbil-ascent-rule (list (gerbil-ascent-atom destination (list key next)))
          (list (atom source) (gerbil-ascent-guard '(v) (lambda (value) (< value n)))
                (gerbil-ascent-binding 'next '(v) (lambda (value) (+ value 1))))))
      (gerbil-ascent-program
       (case scenario
         ((view) (cons (view 'reach '((0 0))) (map (lambda (i) (view (name i) [])) (iota (padding scenario)))))
         ((mixed) (append (list (view 'reach '((0 0))) (gerbil-ascent-lattice 'score 2 [] max))
                         (map (lambda (i) (if (even? i) (view (name i) [])
                                             (gerbil-ascent-lattice (name i) 2 [] max))) (iota (padding scenario)))))
         ((dense) (cons (gerbil-ascent-relation 'input 2 (map (lambda (i) (list 0 i)) (iota 32)))
                        (map (lambda (i) (view (name i) [])) (iota 40))))
         (else (cons (gerbil-ascent-lattice 'score 2 '((0 0)) max
                        (if (eq? scenario 'custom) custom gerbil-ascent-hash-index-provider))
                     (if (= (padding scenario) 0) (list (gerbil-ascent-relation 'sentinel 2 []))
                       (map (lambda (i) (gerbil-ascent-lattice (name i) 2 [] max)) (iota (padding scenario)))))))
       (case scenario
         ((view) (list (step 'reach 'reach)))
         ((mixed) (list (step 'reach 'reach)
                        (gerbil-ascent-rule (list (atom 'score)) (list (atom 'reach)))))
         ((dense) (list (gerbil-ascent-rule (map (lambda (i) (atom (name i))) (iota 40))
                        (list (atom 'input) (gerbil-ascent-guard '(v) (lambda (_) #t))))))
         (else (list (step 'score 'score))))
       200000 200000 200000))))
(def vl-project scc-scc-project)
(def (vl-prepare old? scenario)
  (let* ((program (vl-program scenario)) (names (map (cut .ref <> 'name) (.ref program 'relations)))
         (rows (case scenario
                 ((set) (list (map list (iota 17))))
                 ((view) (cons (star (limit scenario))
                               (make-list (padding scenario) [])))
                 ((mixed) (append (list (star (limit scenario))
                                        (list (list 0 (limit scenario)))) (make-list (padding scenario) [])))
                 ((dense) (cons (map (lambda (i) (list 0 i)) (iota 32)) (make-list 40 (star 31))))
                 (else (cons (list (list 0 (limit scenario))) (make-list (- (length names) 1) [])))))
         (expected (list #t names (map (lambda (n rs) (cons n (length rs))) names rows)
                         rows 'stratified-semi-naive (length (.ref program 'rules)))))
    ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t)
    (vector program expected)))
(def (vl-consume state scenario old?)
  (let* ((program (if (eq? scenario 'cold) (vl-program scenario) (vector-ref state 0)))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine)
                  program #f #f #f #f #f #f 1)))
    (vl-project (engine))))
(def (vl-expected state scenario) (vector-ref state 1))
