;;; Build-only inventory, reusing the original artifact hashing owner.
(import (only-in "../bindings/artifact.ss" artifact-file-sha256))
(def (collect-files directory accept emit)
  (when (file-exists? directory)
    (for-each (lambda (name)
      (let (path (path-expand name directory))
        (cond ((equal? (file-info-type (file-info path)) 'directory)
               (unless (or (equal? name "static") (string-suffix? ".dSYM" name))
                 (collect-files path accept emit)))
              ((accept name) (emit path))))) (directory-files directory))))
(def (source? name) (member (path-extension name) '(".ss" ".rs")))
(def (resource? name)
  (let (extension (path-extension name))
    (or (equal? extension ".ssi")
        (and (string-suffix? ".ssxi.ss" name) #t)
        (and (> (string-length extension) 2) (string-prefix? ".o" extension)
             (let (version (string->number (substring extension 2 (string-length extension))))
               (and (exact-integer? version) (> version 0)))))))
(def (write-inventory output name function entries)
  (call-with-output-file output (lambda (port)
    (display (string-append "static " name ": &[(&str,&str)] = &[\n") port)
    (for-each (lambda (entry)
      (display "(" port) (write (car entry) port) (display "," port)
      (write (cdr entry) port) (display "),\n" port))
      entries)
    (display (string-append "]; fn " function "() -> gerbil_ascent::Data { gerbil_ascent::Data::Map("
      name ".iter().map(|(path,sha)|(path.to_string(),gerbil_ascent::Data::from(*sha))).collect()) }") port))))
(def (main root out application-runtime sdk-runtime)
  (def sources [])
  (def resources [])
  (def (source path)
    (set! sources (cons (cons (substring path (+ (string-length root) 1) (string-length path))
                             (artifact-file-sha256 path)) sources)))
  ;; Cargo watches source inputs only, never our generated .oN/archive outputs.
  (for-each (lambda (directory)
              (let (path (path-expand directory root))
                (displayln "cargo:rerun-if-changed=" path)
                (collect-files path source? source)))
    '("interface" "evidence" "program" "core" "table" "candidate" "applications"
      "rust/ascent/src" "rust/ascent-scheme/src" "rust/ascent-python/src"))
  (for-each (lambda (name)
              (let (path (path-expand name root))
                (displayln "cargo:rerun-if-changed=" path)
                (source path)))
    '("build.ss" "build-modules.ss" "gerbil.pkg" "rust/Cargo.toml" "rust/Cargo.lock" "rust/ascent/Cargo.toml" "rust/ascent/build.rs"
      "rust/ascent-scheme/Cargo.toml" "rust/ascent-scheme/build.rs" "rust/ascent-python/Cargo.toml"
      "python/pyproject.toml"))
  (for-each (lambda (directory) (collect-files directory resource? (lambda (path)
    (set! resources (cons (cons path (artifact-file-sha256 path)) resources)))))
    (list application-runtime sdk-runtime))
  (write-inventory (path-expand "compiled_identity.rs" out) "COMPILED_INPUTS" "compiled_inputs" sources)
  (write-inventory (path-expand "runtime_identity.rs" out) "RUNTIME_INPUTS" "runtime_inputs" resources))
