(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :asp-gerbil-scheme/benchmark-api
        :gerbil-ascent/core/expression-plan
        (rename-in :gerbil-ascent/t/performance/callback-plan/expression-reference
          (gerbil-ascent-compile-frame-call old-call)
          (gerbil-ascent-compile-frame-sequence old-sequence)
          (gerbil-ascent-compile-input-guard old-guard)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (##gc)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result
            (/ (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9)) repetitions)
            (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                  (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/callback-plan/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid callback contract"))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                         (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "callback comparison requires native modules" name))))
   '("core/expression-plan" "t/performance/callback-plan/expression-reference"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown callback scenario" scenario))
  (let* ((get (lambda (key) (benchmark-fixture-ref (cdr entry) key)))
         (size (get 'size)) (phase (get 'phase))
         (names (map (lambda (n) (string->symbol (string-append "v" (number->string n)))) (iota size)))
         (a (old-guard names)) (b (gerbil-ascent-compile-input-guard names))
         (frame (list->vector (iota size)))
         (f (lambda args (apply + args)))
         (old-invoke (old-call f (reverse (iota size))))
         (new-invoke (gerbil-ascent-compile-frame-call f (reverse (iota size))))
         (payload (vector names f))
         (old (case phase
                ((call) (lambda () (old-invoke frame)))
                ((guarded) (lambda () (let* ((current-procedure (vector-ref payload 1))
                                             (current-names (vector-ref payload 0)))
                              (and (eq? current-procedure f) (a current-names) (old-invoke frame)))))
                (else (lambda () (a names)))))
         (new (case phase
                ((call) (lambda () (new-invoke frame)))
                ((guarded) (lambda () (let* ((current-procedure (vector-ref payload 1))
                                             (current-names (vector-ref payload 0)))
                              (and (eq? current-procedure f) (b current-names) (new-invoke frame)))))
                (else (lambda () (b names)))))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (def (check x y)
      (if (memq phase '(call guarded))
        (unless (= x y (/ (* size (- size 1)) 2)) (error "ordered callback value mismatch"))
        (unless (and x y) (error "callback metadata guard mismatch"))))
    (def (sample)
      (let-values (((x u v y p q)
                    (if (even? count)
                      (let-values (((x u v) (measure old (get 'repetitions)))
                                   ((y p q) (measure new (get 'repetitions)))) (values x u v y p q))
                      (let-values (((y p q) (measure new (get 'repetitions)))
                                   ((x u v) (measure old (get 'repetitions)))) (values x u v y p q)))))
        (check x y)
        (set! ab (cons u ab)) (set! bb (cons p bb))
        (set! ac (cons v ac)) (set! bc (cons q bc))
        (when (< q v) (set! wins (+ wins 1))))
      (set! count (+ count 1))
      (when (zero? (modulo count 5))
        (displayln "CALLBACK-PAIRS " scenario " " count "/50") (force-output))
      count)
    (check (old) (new))
    (let-values (((api-receipt _) (benchmark-run/result contract sample)))
      (let* ((x (median ab)) (y (median bb)) (u (median ac)) (v (median bc))
             (pass? (and (= count 50) (eq? (benchmark-fixture-ref api-receipt 'status) 'pass)
                         (<= y (+ x (get 'allocationOverheadBytes)))
                         (<= v (+ (* u (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path
          (lambda (out) (write (list (cons 'scenario scenario) (cons 'passed? pass?)
              (cons 'baseline (benchmark-fixture-ref contract 'baseline))
              (cons 'asp-receipt api-receipt) (cons 'old-bytes x) (cons 'new-bytes y)
              (cons 'old-cpu-us (* u 1000000)) (cons 'new-cpu-us (* v 1000000))
              (cons 'wins wins) (cons 'old-allocation ab) (cons 'new-allocation bb)
              (cons 'old-cpu ac) (cons 'new-cpu bc)) out)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* u 1000000) " -> " (* v 1000000)
                   " bytes " x " -> " y " wins " wins) (force-output)
        (unless pass? (error "callback performance gate failed" scenario))))))
