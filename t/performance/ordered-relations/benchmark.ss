;;; Complete relation materialization, exact previous-native-module comparison.
(import :gerbil/runtime/gambit :gerbil/expander
        (only-in :clan/poo/object .o .mix .ref .call)
        (only-in :clan/poo/trie UIntTrieSet)
        :gerbil-ascent/core/binary-relation
        (only-in :gerbil-ascent/table/expression gerbil-ascent-table-expression-prototype)
        (only-in :gerbil-ascent/t/performance/ordered-relations/reference
                 ordered-relations-reference-prototype))
(for-each
 (lambda (name)
   (let* ((actual (gx#module-context-path (gx#import-module (string->symbol (string-append ":gerbil-ascent/" name)))))
          (expected (string-append (getenv "ASCENT_ORDERED_RELATIONS_LIB") "/gerbil-ascent/" name ".ssi")))
     (unless (equal? actual expected) (error "ordered relation probe must use native modules" actual expected))
     (displayln "NATIVE-MODULE-OK " actual)))
 '("core/binary-relation" "table/expression" "t/performance/ordered-relations/reference"))
(def (statistic samples fraction)
  (list-ref (list-sort < samples)
            (- (quotient (* (length samples) fraction) 100) 1)))

(def (allocated) (inexact->exact (f64vector-ref (##process-statistics) 7)))
(def (measured call repetitions)
  (let ((start-bytes (allocated)) (start (current-jiffy)) (result #f))
    (let loop ((left repetitions))
      (when (> left 0) (set! result (call)) (loop (- left 1))))
    (let ((elapsed (quotient (* (- (current-jiffy) start) 1000000000)
                             (* repetitions (jiffies-per-second))))
          (bytes (quotient (- (allocated) start-bytes) repetitions)))
      (values result bytes elapsed))))

(def (matched name old new check repetitions primary?)
  (displayln "CASE " name " samples=1000 repetitions=" repetitions)
  (force-output)
  (for-each (lambda (_) (check (old) (new))) (iota 20))
  (let ((old-samples []) (new-samples []) (old-times []) (new-times []))
    (let loop ((sample 0))
      (when (< sample 1000)
        (let-values (((old-result old-bytes old-ns new-result new-bytes new-ns)
                      (if (even? sample)
                        (let-values (((left left-bytes left-ns) (measured old repetitions))
                                     ((right right-bytes right-ns) (measured new repetitions)))
                          (values left left-bytes left-ns right right-bytes right-ns))
                        (let-values (((right right-bytes right-ns) (measured new repetitions))
                                     ((left left-bytes left-ns) (measured old repetitions)))
                          (values left left-bytes left-ns right right-bytes right-ns)))))
          (check old-result new-result)
          (set! old-samples (cons old-bytes old-samples))
          (set! new-samples (cons new-bytes new-samples))
          (set! old-times (cons old-ns old-times))
          (set! new-times (cons new-ns new-times)))
        (when (zero? (modulo (+ sample 1) 100))
          (displayln "PROGRESS " name " " (+ sample 1) "/1000")
          (force-output))
        (loop (+ sample 1))))
    (let* ((old-p50 (statistic old-samples 50))
           (new-p50 (statistic new-samples 50))
           (wins (foldl (lambda (pair total)
                          (if (< (cdr pair) (car pair)) (+ total 1) total))
                        0 (map cons old-samples new-samples))))
      (displayln "RESULT " name " old-p50-bytes=" old-p50
                 " new-p50-bytes=" new-p50 " paired-wins=" wins "/1000")
      (force-output)
      (list (cons 'name name) (cons 'repetitions repetitions)
            (cons 'primary? primary?)
            (cons 'old-p50-bytes old-p50) (cons 'new-p50-bytes new-p50)
            (cons 'old-p95-bytes (statistic old-samples 95))
            (cons 'new-p95-bytes (statistic new-samples 95))
            (cons 'paired-wins wins)
            (cons 'old-samples-bytes (reverse old-samples))
            (cons 'new-samples-bytes (reverse new-samples))
            (cons 'old-p50-ns (statistic old-times 50))
            (cons 'new-p50-ns (statistic new-times 50))
            (cons 'old-p95-ns (statistic old-times 95))
            (cons 'new-p95-ns (statistic new-times 95))
            (cons 'time-paired-wins
                  (foldl (lambda (pair total) (if (< (cdr pair) (car pair)) (+ total 1) total))
                         0 (map cons old-times new-times)))
            (cons 'old-samples-ns (reverse old-times))
            (cons 'new-samples-ns (reverse new-times))))))


(def (source width step)
  (.call UIntTrieSet .<-list
         (apply append
                (map (lambda (from)
                       (map (lambda (distance)
                              (+ (* from width) (modulo (+ from distance) width)))
                            (iota step 1)))
                     (iota width)))))
(def (chain width)
  (.call UIntTrieSet .<-list
         (map (lambda (from) (+ (* from width) (+ from 1))) (iota (- width 1)))))
(def (expression prototype pairs pair-radix)
  (.mix prototype (.o (source-pairs pairs) (radix pair-radix))))
(def (slots value)
  (let* ((projection (.ref value 'at-most-two-hop-pairs))
         (closure (.ref value 'closure-pairs))
         (distances (.ref value 'shortest-distance-pairs))
         (distance-of (.ref value 'shortest-distance-of)))
    (list projection closure distances (map distance-of distances))))
(def (probe name pairs radix demand primary?)
  (matched name
    (lambda () (demand (expression ordered-relations-reference-prototype pairs radix)))
    (lambda () (demand (expression gerbil-ascent-table-expression-prototype pairs radix)))
    (lambda (old new) (unless (equal? old new) (error "materialization changed result" name)))
    1 primary?))
(def dense (source 256 2))
(def small-chain (chain 32))
(def small-cycle (source 16 2))
(def sparse (.call UIntTrieSet .<-list '(515 1029)))
(def left (.call UIntTrieSet .<-list '(1 258 515 772)))
(let (receipts
      (list
       (probe 'cold-projection-256 dense 256 (lambda (e) (.ref e 'at-most-two-hop-pairs)) #t)
       (probe 'complete-snapshot-16 small-cycle 16 slots #t)
       (probe 'complete-fanout-32 (source 32 31) 32 slots #t)
       (probe 'closure-chain-32 small-chain 32 (lambda (e) (.ref e 'closure-pairs)) #t)
       (probe 'distance-chain-32 small-chain 32
              (lambda (e)
                (let* ((pairs (.ref e 'shortest-distance-pairs))
                       (distance (.ref e 'shortest-distance-of)))
                  (list pairs (map distance pairs)))) #t)
       (probe 'sparse-projection-513 sparse 513 (lambda (e) (.ref e 'at-most-two-hop-pairs)) #f)
       (probe 'external-compose-256 dense 256
              (lambda (e) ((.ref e 'compose-left) left)) #f)
       (probe 'empty-distances-512 (.call UIntTrieSet .<-list []) 512
              (lambda (e) (.ref e 'shortest-distance-pairs)) #f)
       (probe 'sparse-distances-512 (.call UIntTrieSet .<-list '(1 514)) 512
              (lambda (e) (.ref e 'shortest-distance-pairs)) #f)
       (probe 'cold-index-256 dense 256
              (lambda (e) (procedure? (.ref e 'right-index))) #f)))
  (call-with-output-file (getenv "ASCENT_ORDERED_RELATIONS_RECEIPT")
    (lambda (port) (write receipts port) (newline port)))
  (for-each
   (lambda (receipt)
     (when (cdr (assq 'primary? receipt))
       (unless (and (<= (cdr (assq 'new-p50-bytes receipt)) (cdr (assq 'old-p50-bytes receipt)))
                    (>= (cdr (assq 'paired-wins receipt)) 900))
         (error "materialization failed matched allocation gate" (car receipt))))) receipts)
  (displayln "OK"))
