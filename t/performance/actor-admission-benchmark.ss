(import :gerbil/expander
        (only-in :std/misc/process run-process)
        (only-in :gerbil-ascent/program/actor-round gerbil-ascent-run-actor-round!)
        (rename-in (only-in :gerbil-ascent/t/performance/actor-admission/reference gerbil-ascent-run-actor-round!)
                   (gerbil-ascent-run-actor-round! reference-round))
        (rename-in (only-in :gerbil-ascent/t/performance/actor-coordinator/reference gerbil-ascent-run-actor-round!)
                   (gerbil-ascent-run-actor-round! pool-round))
        (only-in :gerbil-ascent/t/performance/native-library assert-native-library!))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repeats allocation?)
  (when allocation? (##gc))
  ;; Keep only the required scalar across task switches and collection.
  (def (counter (end? #f))
    (let (statistics (##process-statistics))
      ;; Gambit's ##time subtracts the end statistics vector's own allocation.
      (if allocation? (- (f64vector-ref statistics 7)
                         (if end? (f64vector-ref statistics 9) 0))
          (+ (f64vector-ref statistics 0) (f64vector-ref statistics 1)))))
  (let (before (counter))
    (let loop ((n repeats) (result #f))
      (if (zero? n)
        (begin
          (let (after (counter #t))
            ;; Field 7 observes the call before cleanup GC; field 16 is the
            ;; last collection's snapshot and is unsafe for this actor span.
            (when allocation? (##gc))
            (values result (/ (- after before) repeats))))
        (loop (- n 1) (call))))))
(def (main scenario library receipt (baseline "admission") (execution "gxi") (executable #f))
  (assert-native-library!)
  (unless (member baseline '("admission" "coordinator")) (error "invalid actor baseline" baseline))
  (for-each
   (lambda (name)
     (unless (equal? (gx#core-resolve-library-module-path
                      (string->symbol (string-append ":gerbil-ascent/" name)))
                     (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (error "admission benchmark module is not native" name)))
   (list "program/actor-round" (string-append "t/performance/actor-" baseline "/reference")))
  (unless (member scenario '("wide" "backlog" "stream" "small")) (error "invalid admission scenario" scenario))
  (let* ((small? (string=? scenario "small")) (stream? (string=? scenario "stream")) (n (if (or small? stream?) 4 1024))
         (jobs (if (string=? scenario "backlog") 64 2))
         (tasks (map (lambda (id) (vector id)) (iota n)))
         (width (if stream? 4096 1)) (offsets (iota width)) (truth (iota (* n width))) (repeats (if small? 20 1))
         (run (lambda (round)
                (let (rows [])
                  (round (vector 'admission) tasks jobs
                         (lambda (task emit! checkpoint!)
                           (for-each (lambda (offset)
                                       (when stream? (checkpoint!))
                                       (emit! task (list (+ (* (vector-ref task 0) width) offset)))) offsets))
                         (lambda (task row) (set! rows (cons (car row) rows))))
                  (list-sort < rows))))
         (old (lambda () (run (if (string=? baseline "coordinator") pool-round reference-round))))
         (new (lambda () (run gerbil-ascent-run-actor-round!)))
         (old-cpu []) (new-cpu []) (old-bytes []) (new-bytes []) (wins 0))
    ;; Allocation gets a fresh VM for each side, independent of CPU-loop history.
    ;; Both children construct identical inputs and measure one cold full round.
    (when (member execution '("allocation-old" "allocation-new"))
      (let-values (((result bytes) (measure (if (string=? execution "allocation-old") old new) 1 #t)))
        (unless (equal? result truth) (error "allocation child candidates differ"))
        (when (< bytes 0) (error "invalid cold allocation delta" scenario bytes))
        (write bytes) (newline) (force-output) (exit 0)))
    (def (measure-side call allocation? side)
      (if allocation?
        (begin
          (unless executable (error "allocation qualification requires the native entry"))
          (let* ((output (run-process [executable "-:max-heap=1G,debug=q" scenario library receipt baseline side]))
                 (bytes (call-with-input-string output read)))
            (unless (and (real? bytes) (>= bytes 0) (< bytes +inf.0))
              (error "invalid allocation child receipt" output))
            (values truth bytes)))
        (measure call repeats #f)))
    (unless (and (equal? (old) truth) (equal? (new) truth)) (error "admission warmup differs"))
    (##gc)
    ;; Before sampling: wide workloads save 15% CPU and 20% allocation, win
    ;; >=35/50 pairs. Small control permits 5% + 15 us and 2 KiB overhead.
    (for-each
     (lambda (allocation?)
       (for-each
        (lambda (sample)
          (let-values (((a x b y)
                        (if (even? sample)
                          (let-values (((a x) (measure-side old allocation? "old"))
                                       ((b y) (measure-side new allocation? "new"))) (values a x b y))
                          (let-values (((b y) (measure-side new allocation? "new"))
                                       ((a x) (measure-side old allocation? "old"))) (values a x b y)))))
            (unless (and (equal? a truth) (equal? b truth)) (error "admission candidates differ" scenario sample))
            (if allocation?
              (begin (when (or (< x 0) (< y 0)) (error "invalid allocation delta" scenario sample x y))
                     (set! old-bytes (cons x old-bytes)) (set! new-bytes (cons y new-bytes)))
              (begin (set! old-cpu (cons x old-cpu)) (set! new-cpu (cons y new-cpu))
                     (when (< y x) (set! wins (+ wins 1))))))
          (when (zero? (modulo (+ sample 1) 5))
            (displayln "ADMISSION-PAIRS " scenario " " (if allocation? 'allocation 'cpu) " " (+ sample 1) "/50")
            (force-output))) (iota 50))) '(#f #t))
    (let* ((a (median old-cpu)) (b (median new-cpu))
           (x (median old-bytes)) (y (median new-bytes))
           (passed? (if small? (and (<= b (+ (* a 1.05) 0.000015)) (<= y (+ x 2048)))
                        (and (<= b (* a 0.85)) (<= y (* x 0.8)) (>= wins 35))))
           (result (list scenario (cons 'baseline (if (string=? baseline "coordinator")
                                               'cf658f97dc9e8e62e38f551a5a283efd300932ed
                                               '6b4295189eb11b527a7ce3d22b5f2ceb78bbe2d6))
                         (cons 'execution execution) (cons 'allocation-state 'fresh-process)
                         (cons 'cpu-repeats repeats) (cons 'allocation-repeats 1)
                         (cons 'vm-processors (##current-vm-processor-count)) (cons 'jobs jobs)
                         (cons 'paired-samples-per-lane 50) (cons 'passed? passed?) (cons 'cpu-wins wins)
                         (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
                         (cons 'old-bytes x) (cons 'new-bytes y)
                         (cons 'old-cpu old-cpu) (cons 'new-cpu new-cpu)
                         (cons 'old-allocation old-bytes) (cons 'new-allocation new-bytes))))
      (call-with-output-file [path: receipt truncate: #t] (lambda (out) (write result out) (newline out)))
      (displayln "RESULT " scenario " " passed? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                 " bytes " x " -> " y " wins " wins) (force-output)
      (unless passed? (error "actor admission performance gate failed" scenario))
      (displayln "OK") (force-output))))
