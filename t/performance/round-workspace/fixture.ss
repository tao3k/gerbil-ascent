(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/round-workspace/reference-evaluate old-)
        (prefix-in :gerbil-ascent/t/performance/scc-execution/fixture scc-))
(export round-program round-prepare round-consume round-expected round-project)
(def (depth scenario) (case scenario ((wide) 128) ((chain) 96) ((serial resume) 16) (else 1)))
(def (padding scenario) (case scenario ((wide) 512) ((chain) 1024) ((resume) 8) (else 0)))
(def (round-program scenario)
  (if (eq? scenario 'indexed) (scc-scc-program 'indexed)
    (let ((x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)) (n (depth scenario)))
      (def (step destination source)
        (gerbil-ascent-rule (list (gerbil-ascent-atom destination (list y)))
          (list (gerbil-ascent-atom source (list x))
                (gerbil-ascent-guard '(x) (lambda (value) (< value n)))
                (gerbil-ascent-binding 'y '(x) (lambda (value) (+ value 1))))))
      (gerbil-ascent-program
       (append (list (gerbil-ascent-relation 'counter 1 '((0))))
               (map (lambda (i) (gerbil-ascent-relation
                                 (string->symbol (string-append "unused" (number->string i))) 1 []))
                    (iota (padding scenario)))
               (if (eq? scenario 'chain) (list (gerbil-ascent-relation 'relay 1 [])) []))
       (if (eq? scenario 'chain) (list (step 'relay 'counter) (step 'counter 'relay))
           (list (step 'counter 'counter)))
       200000 200000 200000))))
(def round-project scc-scc-project)
(def (round-prepare old? scenario)
  (let* ((program (round-program scenario))
         (names (map (cut .ref <> 'name) (.ref program 'relations)))
         (rows
          (if (eq? scenario 'indexed)
            (let* ((source (map (lambda (i) (list i (+ i 1))) (iota 31)))
                   (output (apply append (map (lambda (i) (map (lambda (j) (list i j))
                                                               (iota (- 31 i) (+ i 1)))) (iota 31)))))
              (list source output))
            (append (list (map list (if (eq? scenario 'chain)
                                     (iota (+ 1 (quotient (depth scenario) 2)) 0 2)
                                     (iota (+ 1 (depth scenario))))))
                    (make-list (padding scenario) [])
                    (if (eq? scenario 'chain)
                      (list (map list (iota (quotient (depth scenario) 2) 1 2))) []))))
         (expected (list #t names (map (lambda (n rs) (cons n (length rs))) names rows)
                         rows 'stratified-semi-naive (length (.ref program 'rules)))))
    ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t)
    (vector program expected)))
(def (round-consume state scenario old?)
  (let* ((program (if (eq? scenario 'cold) (round-program scenario) (vector-ref state 0)))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine)
                  program #f #f #f #f #f #f (if (eq? scenario 'serial) 1 (##cpu-count)))))
    (round-project (engine))))
(def (round-expected state scenario) (vector-ref state 1))
