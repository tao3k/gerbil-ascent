(import :gerbil/expander (only-in :std/misc/process run-process)
        :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/t/performance/component-scope/fixture component-scope-request component-scope-program)
        (only-in :gerbil-ascent/program/positive-components gerbil-ascent-run-positive-components!)
        (rename-in (only-in :gerbil-ascent/t/performance/component-workspace/reference-coordinator gerbil-ascent-run-positive-components!)
                   (gerbil-ascent-run-positive-components! reference-run)))
(export main)
(def (median values) (list-ref (list-sort < values) (quotient (length values) 2)))
(def (measure call repeats allocation?)
  (when allocation? (##gc))
  (def (counter (end? #f))
    (let (s (##process-statistics))
      (if allocation? (- (f64vector-ref s 7) (if end? (f64vector-ref s 9) 0))
          (+ (f64vector-ref s 0) (f64vector-ref s 1)))))
  (let (before (counter))
    (let loop ((n repeats) (result #f))
      (if (zero? n) (values result (/ (- (counter #t) before) repeats))
          (loop (- n 1) (call))))))
(def (recursive-program padding)
  (let ((x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)) (z (gerbil-ascent-variable 'z)))
    (gerbil-ascent-program
     (append (list (gerbil-ascent-relation 'edge 2 (map (lambda (i) (list i (+ i 1))) (iota 12)))
                   (gerbil-ascent-relation 'reach 2 []))
             (map (lambda (i) (gerbil-ascent-relation (string->symbol (string-append "unused" (number->string i))) 1 [])) (iota padding)))
     (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list x y))) (list (gerbil-ascent-atom 'edge (list x y))))
           (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list x z)))
                               (list (gerbil-ascent-atom 'reach (list x y)) (gerbil-ascent-atom 'edge (list y z)))))
     10000 10000 10000)))
(def (indexed-program)
  (let ((x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)))
    (gerbil-ascent-program
     (list (gerbil-ascent-relation 'seed 1 (map list (iota 64)))
           (gerbil-ascent-relation 'edge 2 (map (lambda (i) (list i (+ i 1))) (iota 64)))
           (gerbil-ascent-relation 'out 1 []))
     (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'out (list y)))
                               (list (gerbil-ascent-atom 'seed (list x)) (gerbil-ascent-atom 'edge (list x y)))))
     10000 10000 10000)))
(def (run kernel request)
  (let (rows (vector-copy (vector-ref request 2)))
    (kernel (vector-ref request 0) (vector-ref request 1) (vector-ref request 2) 2
            (lambda (atom row) (let (i (vector-ref atom 0)) (vector-set! rows i (cons row (vector-ref rows i)))))
            (lambda () #f))
    (vector-map (lambda (source) (list-sort (lambda (a b) (or (< (car a) (car b))
                           (and (= (car a) (car b)) (pair? (cdr a)) (< (cadr a) (cadr b))))) source)) rows)))
(def (main scenario library receipt (side #f))
  (add-load-path! library)
  (unless (member scenario '("scan" "recursive" "indexed" "small")) (error "invalid workspace scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "workspace benchmark native module mismatch" name)))
    '("program/index" "program/component-worker" "program/positive-components"
      "t/performance/component-workspace/reference-index" "t/performance/component-workspace/reference-worker"
      "t/performance/component-workspace/reference-coordinator"))
  (let* ((recursive? (string=? scenario "recursive")) (small? (string=? scenario "small"))
         (indexed? (string=? scenario "indexed"))
         (request (component-scope-request (cond (recursive? (recursive-program 1024))
                                                (indexed? (indexed-program))
                                                (else (component-scope-program (if small? 1 128) 1 1)))))
         (truth (cond (recursive? (let (v (make-vector 1026 []))
                                   (vector-set! v 0 (map (lambda (i) (list i (+ i 1))) (iota 12)))
                                   (vector-set! v 1 (apply append (map (lambda (a) (map (lambda (b) (list a b)) (iota (- 12 a) (+ a 1)))) (iota 12)))) v))
                      (indexed? (vector (map list (iota 64)) (map (lambda (i) (list i (+ i 1))) (iota 64)) (map list (iota 64 1))))
                      (else (make-vector (if small? 2 129) '((0))))))
         (old (lambda () (run reference-run request))) (new (lambda () (run gerbil-ascent-run-positive-components! request)))
         (repeats (if small? 20 1)))
    (def (check result) (unless (equal? result truth) (error "workspace result differs from independent truth" scenario)))
    (when side
      (unless (member side '("old" "new")) (error "invalid allocation side" side))
      (let-values (((result bytes) (measure (if (string=? side "old") old new) 1 #t)))
        (check result) (unless (>= bytes 0) (error "invalid allocation delta" bytes))
        (write bytes) (newline) (force-output) (exit 0)))
    (check (old)) (check (new)) (##gc)
    (let ((ac []) (bc []) (ab []) (bb []) (wins 0))
      (for-each (lambda (allocation?)
        (def (sample call side)
          (if allocation?
            (let* ((out (run-process [(car (command-line)) "-:max-heap=1G,debug=q" scenario library receipt side]))
                   (bytes (call-with-input-string out read)))
              (unless (and (real? bytes) (>= bytes 0) (< bytes +inf.0)) (error "invalid child measurement" out))
              (values truth bytes))
            (measure call repeats #f)))
        (for-each (lambda (i)
          (let-values (((a x b y) (if (even? i)
                       (let-values (((a x) (sample old "old")) ((b y) (sample new "new"))) (values a x b y))
                       (let-values (((b y) (sample new "new")) ((a x) (sample old "old"))) (values a x b y)))))
            (check a) (check b)
            (if allocation? (begin (set! ab (cons x ab)) (set! bb (cons y bb)))
                (begin (set! ac (cons x ac)) (set! bc (cons y bc)) (when (< y x) (set! wins (+ wins 1)))))
            (when (zero? (modulo (+ i 1) 5))
              (displayln "WORKSPACE-PAIRS " scenario " " (if allocation? "allocation" "cpu") " " (+ i 1) "/50") (force-output)))) (iota 50))) '(#f #t))
      ;; Fixed before samples: scan/recursive save 10% allocation. All scenarios
      ;; bound CPU overhead by 5%+20us; indexed/small permit 2KiB extra bytes.
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= b (+ (* a 1.05) 0.000020))
                         (if (or small? indexed?) (<= y (+ x 2048)) (<= y (* x 0.90))))))
        (call-with-output-file receipt (lambda (p) (write (list scenario (cons 'passed? pass?) (cons 'baseline '0f2fb517fa4b67b4f252880ab6e7c829defb16af)
          (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000)) (cons 'cpu-wins wins)
          (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu ac) (cons 'new-cpu bc) (cons 'old-bytes-pairs ab) (cons 'new-bytes-pairs bb)) p)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000) " bytes " x " -> " y " wins " wins) (force-output)
        (unless pass? (error "workspace performance gate failed" scenario))))))
