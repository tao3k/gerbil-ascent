(import :std/test :gerbil-ascent/core/relation-view
        :gerbil-ascent/t/performance/uf-dense/fixture
        (prefix-in :gerbil-ascent/t/performance/uf-dense/reference-trrel-uf old-)
        :gerbil-ascent/table/trrel-uf)
(export ascent-uf-dense-test)
(import (only-in :gerbil-ascent/program/view-replay gerbil-ascent-small-journal-export)
        (prefix-in :gerbil-ascent/t/performance/uf-dense/reference-view-replay historical-))
(def (replay call rows skip)
  (call (list (list 'source rows)) car cadr 200000 skip #t))
(def (rows state) (gerbil-ascent-view-rows (gerbil-ascent-trrel-uf-freeze state #f)))
(def (same-members? left right)
  (let (seen (list->hash-table (map (cut cons <> #t) left)))
    (and (= (length left) (length right)) (= (hash-length seen) (length left))
         (andmap (cut hash-get seen <>) right))))
(def ascent-uf-dense-test
  (test-suite "Dense UF storage and SCC ownership"
(test-case "dense storage retires partial SCC bits and preserves a retained snapshot"
  (let ((old (old-gerbil-ascent-trrel-uf-state)) (new (gerbil-ascent-trrel-uf-state)))
    (for-each (lambda (row)
      (check-equal? (gerbil-ascent-trrel-uf-count-insert! new row 200000)
                    (old-gerbil-ascent-trrel-uf-count-insert! old row 200000)))
      (map (lambda (i) (list i (+ i 1))) (iota 96)))
    (let* ((cut (gerbil-ascent-trrel-uf-freeze new #f)) (saved (gerbil-ascent-view-rows cut))
           (resources (gerbil-ascent-trrel-uf-resource-observation new)))
      (check-equal? (> (vector-ref resources 2) 0) #t)
      (check-equal? (< (* 4 (vector-ref resources 1)) (vector-ref resources 2)) #t)
      (for-each (lambda (row)
        (let ((before (gerbil-ascent-trrel-uf-resource-observation new))
              (needed (old-gerbil-ascent-trrel-uf-count-insert! old row 200000)))
          (when (> needed 0)
            (check-exception (gerbil-ascent-trrel-uf-count-insert! new row (- needed 1)) true)
            (check-equal? (gerbil-ascent-trrel-uf-resource-observation new) before))
          (check-equal? (gerbil-ascent-trrel-uf-count-insert! new row needed) needed)
          (check-equal? (gerbil-ascent-trrel-uf-validate new) #t)
          (check-equal? (same-members? (rows new)
                          (gerbil-ascent-view-rows (old-gerbil-ascent-trrel-uf-freeze old #f))) #t)))
        '((64 32) (97 98) (96 97) (98 0) (99 100) (98 99)))
      (check-equal? (gerbil-ascent-view-rows cut) saved))))
(test-case "retired birth-order gaps do not allocate a matrix"
  (let (state (gerbil-ascent-trrel-uf-state))
    (for-each (lambda (i)
      (gerbil-ascent-trrel-uf-count-insert! state (list 0 i) 2000000)
      (gerbil-ascent-trrel-uf-count-insert! state (list i 0) 2000000)) (iota 512 1))
    (check-equal? (gerbil-ascent-trrel-uf-resource-observation state) '#(0 0 0 0 0 0))
    (for-each (lambda (i) (gerbil-ascent-trrel-uf-count-insert! state (list 0 i) 2000000)) (iota 64 513))
    (check-equal? (gerbil-ascent-trrel-uf-validate state) #t)
    (let (resources (gerbil-ascent-trrel-uf-resource-observation state))
      (check-equal? (< (vector-ref resources 1) 10) #t)
      (check-equal? (vector-ref resources 2) 0))))
(test-case "sparse late births preserve dense snapshot truth without enlarging bitmaps"
  (let ((old (old-gerbil-ascent-trrel-uf-state)) (new (gerbil-ascent-trrel-uf-state)))
    (for-each (lambda (i)
      (old-gerbil-ascent-trrel-uf-count-insert! old (list i (+ i 1)) 2000000)
      (gerbil-ascent-trrel-uf-count-insert! new (list i (+ i 1)) 2000000)) (iota 96))
    (let (before (vector-ref (gerbil-ascent-trrel-uf-resource-observation new) 4))
      (for-each (lambda (i)
        (old-gerbil-ascent-trrel-uf-count-insert! old (list i i) 2000000)
        (gerbil-ascent-trrel-uf-count-insert! new (list i i) 2000000)) (iota 200 1000))
      (check-equal? (vector-ref (gerbil-ascent-trrel-uf-resource-observation new) 4) before)
      (check-equal? (gerbil-ascent-trrel-uf-validate new) #t)
      (check-equal? (same-members? (rows new)
                      (gerbil-ascent-view-rows (old-gerbil-ascent-trrel-uf-freeze old #f))) #t))))
    (test-case "all three-node replay histories preserve flags and ordered delta boundaries"
      (let (edges (apply append (map (lambda (a) (map (cut list a <>) (iota 3))) (iota 3))))
        (for-each (lambda (mask)
          (let* ((history (filter-map (lambda (row bit)
                            (and (not (= 0 (bitwise-and mask (arithmetic-shift 1 bit)))) row)) edges (iota 9)))
                 (raw (old-gerbil-ascent-trrel-uf-state)) (boundaries '(0)) (count 0))
            (for-each (lambda (row)
              (set! count (+ count (old-gerbil-ascent-trrel-uf-count-insert! raw row 32)))
              (set! boundaries (cons count boundaries))) history)
            (for-each (lambda (skip)
              (check-equal? (replay gerbil-ascent-small-journal-export history skip)
                (replay historical-gerbil-ascent-small-journal-export history skip))) boundaries))) (iota 512))))
    (test-case "weighted fresh sources and sinks reject before mutation and preserve scalar order"
      (let ((old (old-gerbil-ascent-trrel-uf-state)) (new (gerbil-ascent-trrel-uf-state)))
        (for-each (lambda (row)
          (let* ((expected (old-gerbil-ascent-trrel-uf-insert! old row 200000))
                 (needed (relation-view-count expected)) (before (gerbil-ascent-trrel-uf-observation new)))
            (when (> needed 0)
              (check-exception (gerbil-ascent-trrel-uf-count-insert! new row (- needed 1)) true)
              (check-equal? (gerbil-ascent-trrel-uf-observation new) before))
            (check-equal? (gerbil-ascent-trrel-uf-count-insert! new row needed) needed)
            (check-equal? (gerbil-ascent-trrel-uf-validate new) #t)
            (check-equal? (gerbil-ascent-trrel-uf-observation new) (old-gerbil-ascent-trrel-uf-observation old))))
          (map (cut cons #f <>)
            (append (apply append (map (lambda (i) (list (list 0 i) (list i 0))) (iota 69 1)))
                    '((70 0) (0 71) (71 70) (70 70) (72 72)))))
        (check-equal? (same-members? (rows new)
                       (gerbil-ascent-view-rows (old-gerbil-ascent-trrel-uf-freeze old #f))) #t)))
    (test-case "self injections and split frontiers retain exact admission rejection"
      (for-each (lambda (call)
        (check-exception (call (list (list 'source '((0 1) (1 2)))) car cadr 32 1 #t) true)
        (check-equal? (replay call '((0 0) (1 1) (0 1) (1 0) (2 2)) 0)
                     (replay historical-gerbil-ascent-small-journal-export '((0 0) (1 1) (0 1) (1 0) (2 2)) 0)))
        (list gerbil-ascent-small-journal-export historical-gerbil-ascent-small-journal-export)))
    (test-case "all fixed native and complete engine scenarios preserve independent truth"
      (for-each (lambda (scenario)
        (let* ((old (ui-prepare #t scenario)) (new (ui-prepare #f scenario))
               (expected (ui-expected old scenario)))
          (check-equal? (ui-consume old scenario #t) expected)
          (check-equal? (ui-consume new scenario #f) expected)))
        '(native-star native-groups native-small dense-cut dense chain cycle unique partitioned sparse grouped retained capture cold small packed adjacent large eqrel)))
    (test-case "dense axes and late SCC merge retain ordered scalar frontiers and atomic count rejection"
      (let ((old (old-gerbil-ascent-trrel-uf-state))
            (scalar (gerbil-ascent-trrel-uf-state)) (counted (gerbil-ascent-trrel-uf-state)))
        (for-each (lambda (row)
          (let* ((expected (old-gerbil-ascent-trrel-uf-insert! old row 200000))
                 (needed (relation-view-count expected))
                 (before (gerbil-ascent-trrel-uf-observation counted)))
            (check-equal? (gerbil-ascent-view-rows (gerbil-ascent-trrel-uf-insert! scalar row 200000))
                          (gerbil-ascent-view-rows expected))
            (when (> needed 0)
              (check-exception (gerbil-ascent-trrel-uf-count-insert! counted row (- needed 1)) true)
              (check-equal? (gerbil-ascent-trrel-uf-observation counted) before)
              (check-equal? (gerbil-ascent-trrel-uf-validate counted) #t))
            (check-equal? (gerbil-ascent-trrel-uf-count-insert! counted row needed) needed)
            (check-equal? (gerbil-ascent-trrel-uf-observation counted)
                          (old-gerbil-ascent-trrel-uf-observation old))
            (check-equal? (gerbil-ascent-trrel-uf-validate scalar) #t)
            (check-equal? (gerbil-ascent-trrel-uf-validate counted) #t)))
          (append (map (lambda (i) (list i (+ i 1))) (iota 96)) '((96 0) (97 98) (96 97) (98 0))))
        (let (truth (apply append (map (lambda (a) (map (cut list a <>) (iota 99))) (iota 99))))
          (check-equal? (same-members? (rows counted) truth) #t)
          (check-equal? (same-members? (rows scalar) truth) #t))))
    (test-case "all three-node histories preserve count-only state and mathematical closure"
      (let (edges (apply append (map (lambda (a) (map (cut list a <>) (iota 3))) (iota 3))))
        (for-each (lambda (mask)
          (let ((old (old-gerbil-ascent-trrel-uf-state)) (new (gerbil-ascent-trrel-uf-state)))
            (for-each (lambda (row bit)
              (when (not (= 0 (bitwise-and mask (arithmetic-shift 1 bit))))
                (check-equal? (gerbil-ascent-trrel-uf-count-insert! new row 16)
                              (relation-view-count (old-gerbil-ascent-trrel-uf-insert! old row 16))))) edges (iota 9))
            (check-equal? (gerbil-ascent-trrel-uf-validate new) #t)
            (check-equal? (same-members? (rows new)
                           (gerbil-ascent-view-rows (old-gerbil-ascent-trrel-uf-freeze old #f))) #t))) (iota 512))))))
