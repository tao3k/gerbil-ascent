(import :gerbil/expander (only-in :clan/poo/object .ref)
        (only-in :gerbil-ascent/program/operator relational-op-source relational-op-fix relational-op-union relational-op-compile)
        (only-in :gerbil-ascent/program/interface relational-admit relational-solve relational-query-name)
        (rename-in (only-in :gerbil-ascent/t/performance/operator-scope/reference
                           relational-op-source relational-op-fix relational-op-union relational-op-compile)
                   (relational-op-source old-source) (relational-op-fix old-fix)
                   (relational-op-union old-union) (relational-op-compile old-compile)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (fixture source fix union depth)
  (let (seed (source 'seed 1 '((7))))
    (fix 1 (lambda (parameter)
      (let loop ((n depth) (node parameter))
        (if (zero? n) (union seed node) (loop (- n 1) (union node node))))))))
(def (compile call root) (let-values (((program output) (call root 64 256 256))) (cons program output)))
(def (shape result)
  (let* ((program (car result)) (relations (.ref program 'relations)) (positions (make-hash-table-eq)))
    (for-each (lambda (relation i) (hash-put! positions (.ref relation 'name) i)) relations (iota (length relations)))
    (list (map (lambda (relation) (list (.ref relation 'arity) (.ref relation 'rows))) relations)
          (map (lambda (rule) (list (map (lambda (atom) (hash-ref positions (.ref atom 'relation))) (.ref rule 'heads))
                                    (map (lambda (atom) (hash-ref positions (.ref atom 'relation))) (.ref rule 'body)))) (.ref program 'rules))
          (hash-ref positions (cdr result)))))
(def (check result)
  (unless (equal? (relational-query-name (relational-solve (relational-admit (car result))) (cdr result)) '((7)))
    (error "compiled shared DAG differs from independent truth")))
(def (measure call)
  (##gc)
  (let (before (##process-statistics))
    (let (result (call))
      (let (after (##process-statistics))
        (let (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9)))
          (unless (>= bytes 0) (error "invalid allocation delta" bytes))
          (values result bytes (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                                  (+ (f64vector-ref before 0) (f64vector-ref before 1)))))))))
(def (main scenario library receipt)
  (add-load-path! library)
  (unless (member scenario '("diamond" "shared-diamond" "scaled-diamond" "deep-diamond" "small")) (error "invalid scope benchmark scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library)) (error "scope benchmark module mismatch" name)))
    '("program/operator" "program/operator-descriptor" "program/operator-analysis" "t/performance/operator-scope/reference"))
  (let* ((small? (string=? scenario "small")) (shared? (member scenario '("shared-diamond" "scaled-diamond")))
         (depth (cond (small? 1) ((string=? scenario "scaled-diamond") 19)
                      (shared? 18) ((string=? scenario "deep-diamond") 22) (else 14)))
         (old-root (fixture old-source old-fix old-union depth))
         (new-root (fixture relational-op-source relational-op-fix relational-op-union depth))
         (old (lambda () (compile old-compile old-root))) (new (lambda () (compile relational-op-compile new-root)))
         (ab []) (bb []) (ac []) (bc []) (wins 0))
    (check (old)) (check (new))
    (for-each (lambda (i)
      (let-values (((a x u b y v) (if (even? i)
                    (let-values (((a x u) (measure old)) ((b y v) (measure new))) (values a x u b y v))
                    (let-values (((b y v) (measure new)) ((a x u) (measure old))) (values a x u b y v)))))
        (unless (equal? (shape a) (shape b)) (error "emitted rule graph changed" i))
        (check a) (check b)
        (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
        (when (< v u) (set! wins (+ wins 1))))
      (when (zero? (modulo (+ i 1) 5)) (displayln "OPERATOR-SCOPE-PAIRS " scenario " " (+ i 1) "/50") (force-output))) (iota 50))
    ;; The original 80% gate failed at 14 levels; 22 levels overflowed old code.
    ;; Before any 18-level sample: >=20% CPU, >=35% allocation, >=35 wins.
    ;; The 19-level scaling qualification retains the same gate unchanged.
    ;; Keep both failed experiments callable with their original gate.
    ;; Small permits 5%+20us CPU overhead and <=2KiB extra allocation.
    (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
           (pass? (if small? (and (<= y (+ x 2048)) (<= b (+ (* a 1.05) 0.000020)))
                      (and (<= y (* x (if shared? 0.65 0.20)))
                           (<= b (* a (if shared? 0.80 0.20))) (>= wins 35)))))
      (call-with-output-file receipt (lambda (p) (write (list scenario (cons 'baseline 'f8ad9d9f39edfdabad2a14e9edd83985309acc33)
        (cons 'passed? pass?) (cons 'cpu-wins wins) (cons 'depth depth) (cons 'old-bytes x) (cons 'new-bytes y)
        (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
        (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) p)))
      (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000) " bytes " x " -> " y " wins " wins)
      (force-output) (unless pass? (error "operator scope performance gate failed" scenario)))))
