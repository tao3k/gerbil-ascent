(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/core/rule-bindings
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-evaluate-program)
        (rename-in (only-in :gerbil-ascent/t/performance/rule-bindings/reference
                           gerbil-ascent-expression-value gerbil-ascent-bind-row)
                   (gerbil-ascent-expression-value old-expression) (gerbil-ascent-bind-row old-bind))
        (rename-in (only-in :gerbil-ascent/t/performance/rule-bindings/reference-evaluate
                           gerbil-ascent-evaluate-program)
                   (gerbil-ascent-evaluate-program old-evaluate))
        :gerbil-ascent/t/performance/rule-bindings/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "BINDING-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass? (if (eq? mode 'large)
                  (and (<= (median bb) (* 0.9 (median ab)))
                       (<= (median bc) (* 0.9 (median ac))) (>= wins 35))
                  (and (<= (median bb) (+ (median ab) 8192))
                       (<= (median bc) (+ (median ac) 0.000020)))))
      ;; Gates are fixed before sampling: large kernels/complete solves save
      ;; 10% CPU and allocation with 35 wins; controls <=8 KiB and <=20 us.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "binding benchmark requires symmetric native modules" name))))
   '("core/rule-bindings" "core/positive-plan" "program/evaluate"
     "t/performance/rule-bindings/reference" "t/performance/rule-bindings/reference-positive"
     "t/performance/rule-bindings/reference-evaluate" "t/performance/rule-bindings/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((large? (member scenario '("guards" "patterns" "call-two" "bind-wide")))
         (mode (if large? 'large 'control))
         (result
          (cond
           ((member scenario '("call-two" "call-six"))
            (let* ((names (take '(a b c d e f) (if (string=? scenario "call-two") 2 6)))
                   (env '((a . 1) (b . 2) (c . 3) (d . 4) (e . 5) (f . 6)))
                   (payload (vector names +)) (expected (apply + (map cdr (take env (length names))))))
              (paired scenario (lambda () (old-expression payload env))
                      (lambda () (gerbil-ascent-expression-value payload env))
                      (lambda (a b) (unless (and (= a expected) (= b expected)) (error "callback value parity"))) 512 mode)))
           ((string=? scenario "bind-wide")
            (let* ((names (map (lambda (n) (string->symbol (number->string n))) (iota 64)))
                   (matched (iota 64))
                   (terms (list (cons 'pattern (vector names (lambda (_) matched)))))
                   (expected (map cons names matched)))
              (paired scenario (lambda () (old-bind terms '(0) []))
                      (lambda () (gerbil-ascent-bind-row terms '(0) []))
                      (lambda (a b) (unless (and (equal? a expected) (equal? b expected)) (error "pattern binding parity"))) 64 mode)))
           ((member scenario '("guards" "patterns" "small"))
            (let* ((size (if (string=? scenario "small") 2 128))
                   (program (if (string=? scenario "patterns") (pattern-program size 64)
                                (callback-program size (if (string=? scenario "small") 1 32))))
                   (expected (if (string=? scenario "patterns") (map (lambda (n) (list (+ n 63))) (iota size))
                                 (map (lambda (n) (list (+ n 2))) (iota (* 2 size))))))
              (paired scenario (lambda () (old-evaluate program)) (lambda () (gerbil-ascent-evaluate-program program))
                      (lambda (a b)
                        (unless (and (equal? (callback-rows a) (callback-rows b))
                                     (equal? (list-sort (lambda (a b) (< (car a) (car b))) (callback-rows b)) expected))
                          (error "complete callback solve parity"))) 10 mode)))
           (else (error "unknown binding scenario" scenario)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline '02d84463482a266c9dcc0196a0d2da0c5b5dfb9f)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "callback binding CPU/allocation gate failed" scenario)))
  (displayln "OK") (force-output))
