;;; Complete binary evaluation and persistent publication against the preceding native snapshot.
(import :gerbil/runtime/gambit :gerbil/expander
        (only-in :clan/poo/object .o .mix .ref .call)
        (only-in :clan/poo/trie UIntTrieSet)
        :gerbil-ascent/core/binary-relation :gerbil-ascent/table/expression
        :gerbil-ascent/core/binary-program
        :gerbil-ascent/t/performance/general-rounds/reference-expression
        :gerbil-ascent/t/performance/general-rounds/reference-program)
(for-each
 (lambda (name)
   (let* ((actual (gx#module-context-path (gx#import-module (string->symbol (string-append ":gerbil-ascent/" name)))))
          (expected (string-append (getenv "ASCENT_GENERAL_ROUNDS_LIB") "/gerbil-ascent/" name ".ssi")))
     (unless (equal? actual expected) (error "probe must use native modules" actual expected))
     (displayln "NATIVE-MODULE-OK " actual))) '("core/binary-relation" "table/expression" "core/binary-program" "t/performance/general-rounds/reference-expression" "t/performance/general-rounds/reference-program"))
(def (statistic samples fraction)
  (list-ref (list-sort < samples)
            (- (quotient (* (length samples) fraction) 100) 1)))

(def (measured call repetitions)
  (let ((start (current-jiffy)) (result #f))
    (let loop ((left repetitions))
      (when (> left 0) (set! result (call)) (loop (- left 1))))
    (let ((elapsed (quotient (* (- (current-jiffy) start) 1000000000)
                             (* repetitions (jiffies-per-second)))))
      (values result elapsed))))

(def (matched name old new check repetitions primary?)
  (displayln "CASE " name " samples=1000 repetitions=" repetitions)
  (force-output)
  (for-each (lambda (_) (check (old) (new))) (iota 20))
  (let ((old-times []) (new-times []))
    (let loop ((sample 0))
      (when (< sample 1000)
        (let-values (((old-result old-ns new-result new-ns)
                      (if (even? sample)
                        (let-values (((left left-ns) (measured old repetitions))
                                     ((right right-ns) (measured new repetitions)))
                          (values left left-ns right right-ns))
                        (let-values (((right right-ns) (measured new repetitions))
                                     ((left left-ns) (measured old repetitions)))
                          (values left left-ns right right-ns)))))
          (check old-result new-result)
          (set! old-times (cons old-ns old-times))
          (set! new-times (cons new-ns new-times)))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "PROGRESS " name " " (+ sample 1) "/1000")
          (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-p50-ns=" (statistic old-times 50)
               " new-p50-ns=" (statistic new-times 50))
    (force-output)
      (list (cons 'name name) (cons 'repetitions repetitions)
            (cons 'primary? primary?)
            (cons 'old-p50-ns (statistic old-times 50))
            (cons 'new-p50-ns (statistic new-times 50))
            (cons 'old-p95-ns (statistic old-times 95))
            (cons 'new-p95-ns (statistic new-times 95))
            (cons 'time-paired-wins
                  (foldl (lambda (pair total) (if (< (cdr pair) (car pair)) (+ total 1) total))
                         0 (map cons old-times new-times)))
            (cons 'old-samples-ns (reverse old-times))
            (cons 'new-samples-ns (reverse new-times)))))

(def (set rows) (.call UIntTrieSet .<-list rows))
(def (fanout width degree)
  (apply append (map (lambda (from)
    (map (lambda (step) (+ (* from width) (modulo (+ from step) width))) (iota degree 1))) (iota width))))
(def (chain width)
  (map (lambda (from) (+ (* from width) (+ from 1))) (iota (- width 1))))
(def (relation name rows) (gerbil-ascent-binary-relation name (set rows)))
(def (program edges width mode)
  (let* ((seed (if (eq? mode 'seeded) '(0) []))
         (clauses (case mode
                    ((copy) (list (gerbil-ascent-binary-copy-rule 'reach 'edge)))
                    ((join) (list (gerbil-ascent-binary-join-rule 'reach 'edge 'edge)))
                    ((guard) (list (gerbil-ascent-binary-filter-rule 'reach 'edge (lambda (from to) (even? to)))))
                    (else (list (gerbil-ascent-binary-copy-rule 'reach 'edge)
                                (gerbil-ascent-binary-join-rule 'reach 'reach 'edge))))))
    (.o (radix width) (relations (list (relation 'edge edges) (relation 'reach seed)))
        (rules clauses) (max-input-facts 1000000) (max-derived-pairs 1000000)
        (max-output-pairs 2000000))))
(def (published result)
  (list (.ref result 'evaluation-path) (.ref result 'relation-names)
        (map (lambda (name) ((.ref result 'pair-list-of) name)) (.ref result 'relation-names))))
(def (complete result)
  (list (published result)
        (map (lambda (name) (.call UIntTrieSet .list<- ((.ref result 'pairs-of) name))) (.ref result 'relation-names))))
(def (repeated result)
  (list (complete result) (complete result) (complete result)))
(def receipts [])
(def (add-program name edges width mode (materialize? #f))
  (let ((p (program edges width mode)) (demand (case materialize? ((repeat) repeated) ((#t) complete) (else published))))
    (set! receipts (cons (matched name
      (lambda () (demand (general-rounds-reference-evaluate-binary-program p)))
      (lambda () (demand (gerbil-ascent-evaluate-binary-program p)))
      (lambda (old new) (unless (equal? old new) (error "program output differs" name))) 1 (not (memq mode '(copy join guard seeded))) ) receipts))))
(def (many-right-program width heads)
  (let* ((inputs (map (lambda (i) (string->symbol (string-append "edge" (number->string i)))) (iota heads)))
         (outputs (map (lambda (i) (string->symbol (string-append "reach" (number->string i)))) (iota heads))))
    (.o (radix width)
        (relations (append (map (lambda (name) (relation name (map (lambda (from) (+ (* from width) (+ from 1))) (iota 19)))) inputs)
                           (map (lambda (name) (relation name '(0))) outputs)))
        (rules (map (lambda (head input) (gerbil-ascent-binary-join-rule head head input)) outputs inputs))
        (max-input-facts 1000000) (max-derived-pairs 1000000) (max-output-pairs 2000000))))
(def (run-program name p)
  (set! receipts (cons (matched name
      (lambda () (published (general-rounds-reference-evaluate-binary-program p)))
      (lambda () (published (gerbil-ascent-evaluate-binary-program p)))
      (lambda (old new) (unless (equal? old new) (error "program output differs" name))) 1 #t) receipts)))
(add-program 'seeded-chain-20 (chain 20) 20 'seeded)
(add-program 'seeded-chain-32 (chain 32) 32 'seeded)
(add-program 'seeded-chain-48 (chain 48) 48 'seeded)
(add-program 'seeded-degree-2-16 (fanout 16 2) 16 'seeded)
(add-program 'seeded-degree-2-32 (fanout 32 2) 32 'seeded)
(run-program 'right-inputs-8-32 (many-right-program 32 8))
(run-program 'right-inputs-32-32 (many-right-program 32 32))
(run-program 'right-inputs-32-128 (many-right-program 128 32))
(run-program 'right-inputs-8-513 (many-right-program 513 8))
(add-program 'general-copy-32 (fanout 32 16) 32 'copy)
(add-program 'general-join-32 (fanout 32 2) 32 'join)
(add-program 'general-guard-32 (fanout 32 16) 32 'guard)
(add-program 'specialized-chain-20 (chain 20) 20 'closure)
(add-program 'specialized-degree-31-32 (fanout 32 31) 32 'closure)
(call-with-output-file (getenv "ASCENT_GENERAL_ROUNDS_RECEIPT")
  (lambda (port) (write (reverse receipts) port) (newline port)))
(displayln "OK")
