      "driver_source": "(import :clan/poo/object :gerbil-ascent/program/objects\n        :gerbil-ascent/program/evaluate\n        :gerbil-ascent/table/storage :gerbil-ascent/table/provider)\n(displayln \"EQREL-ENGINE-START nodes=1000\") (force-output)\n(let* ((rows (map (lambda (i) (list 0 i)) (iota 1000)))\n       (program (gerbil-ascent-program\n                   (list (gerbil-ascent-relation 'eq 2 rows\n                           gerbil-ascent-hash-index-provider\n                           gerbil-ascent-eqrel-storage-provider))\n                   [] 2000 2000000 2000000))\n       (result (gerbil-ascent-evaluate-program program))\n       (sizes ((.ref result 'relation-sizes)))\n       (representation ((.ref result 'representation-observation))))\n  (unless (and (.ref result 'finished) (equal? sizes '((eq . 1000000)))\n               (equal? representation '((eq rectangles 1000000 1))))\n    (error \"equivalence engine representation mismatch\" sizes representation))\n  (displayln \"EQREL-ENGINE-OK logical-pairs=1000000 total-descriptors=1\")\n  (force-output))\n",
