(import :gerbil-ascent/core/relation-view :gerbil-ascent/table/trrel-uf
        (prefix-in :gerbil-ascent/t/performance/uf-weighted/reference-relation-view old-view-)
        (prefix-in :gerbil-ascent/t/performance/uf-weighted/reference-trrel-uf old-))
(export ui-prepare ui-consume ui-expected ui-scale-expected capture-input capture-view capture-rows capture-query)
(def (chain n) (map (lambda (i) (list i (+ i 1))) (iota n)))
(def (cycle n) (map (lambda (i) (list i (modulo (+ i 1) n))) (iota n)))
(def (query? scenario) (memq scenario '(left-query right-query)))
(def (capture-input scenario)
  (case scenario
    ((heavy) (cycle 384))
    ((large) (cycle 512))
    ((grouped) (apply append (map (lambda (g) (map (cut cons g <>) (cycle 192))) '(0 7))))
    ((left-query right-query) (cycle 384))
    ((dense) (chain 192))
    ((sparse) (map (lambda (i) (list i (+ i 1))) (iota 128 0 2)))
    (else '((0 1) (1 2)))))
(def (selected-query view old? scenario)
  (capture-query view old? (if (eq? scenario 'left-query) '(0) '(1)) '(0)))
(def (capture-view state old? indexed?)
  ((if old? old-gerbil-ascent-trrel-uf-freeze gerbil-ascent-trrel-uf-freeze) state indexed?))
(def (capture-rows view old?)
  ((if old? old-view-gerbil-ascent-view-rows gerbil-ascent-view-rows) view))
(def (capture-query view old? columns key)
  (let (rows [])
    ((if old? old-view-gerbil-ascent-for-each-row gerbil-ascent-for-each-row)
      (lambda (row) (set! rows (cons row rows)))
      ((if old? old-view-gerbil-ascent-view-select gerbil-ascent-view-select) view columns key))
    (reverse! rows)))
(def (ui-prepare old? scenario)
  (let (state ((if old? old-gerbil-ascent-trrel-uf-state gerbil-ascent-trrel-uf-state)))
    (for-each (lambda (row)
      ((if old? old-gerbil-ascent-trrel-uf-count-insert! gerbil-ascent-trrel-uf-count-insert!) state row 1000000))
      (capture-input scenario))
    (if (query? scenario) (capture-view state old? #t) state)))
(def (summary rows)
  (list (length rows)))
(def (ui-consume state scenario old?)
  (summary (if (query? scenario) (selected-query state old? scenario)
    (capture-rows (capture-view state old? (eq? scenario 'indexed)) old?))))
(def (ui-expected state scenario)
  (let* ((before (if (query? scenario) (selected-query state #t scenario)
                   (capture-rows (capture-view state #t (eq? scenario 'indexed)) #t)))
         (new-state (ui-prepare #f scenario))
         (after (if (query? scenario) (selected-query new-state #f scenario)
                  (capture-rows (capture-view new-state #f (eq? scenario 'indexed)) #f))))
    (unless (and (= (length before) (length after))
      (let (reference (list->hash-table (map (cut cons <> #t) before)))
        (andmap (cut hash-get reference <>) after)))
      (error "UF capture baseline answer mismatch" scenario))
    ;; Every closure answer is checked independently by native/Python DFS tests;
    ;; measured summaries retain no large full-row results in ASP receipts.
    (summary before)))

(def (ui-scale-expected old-state scenario)
  ;; A directed cycle reaches each ordered pair, including every diagonal.
  ;; An independent occupancy vector rejects duplicates, omissions and
  ;; out-of-domain rows. The timed consumer still materializes full lists.
  (let* ((vertices (length (capture-input scenario)))
         (cardinality (* vertices vertices))
         (new-state (ui-prepare #f scenario)))
    (def (verify state old?)
      (let ((seen (make-u8vector cardinality 0))
            (rows (capture-rows (capture-view state old? #f) old?)))
        (unless (= (length rows) cardinality)
          (error "dense cycle export cardinality differs" scenario old?))
        (for-each
          (lambda (row)
            (match row
              ([left right]
               (unless (and (exact-integer? left) (<= 0 left) (< left vertices)
                            (exact-integer? right) (<= 0 right) (< right vertices))
                 (error "dense cycle export row is outside its domain" scenario row))
               (let (index (+ (* left vertices) right))
                 (unless (zero? (u8vector-ref seen index))
                   (error "dense cycle export repeated a row" scenario row))
                 (u8vector-set! seen index 1)))
              (else (error "dense cycle export row has incorrect arity" scenario row))))
          rows)))
    (verify old-state #t)
    (verify new-state #f)
    (list cardinality)))
