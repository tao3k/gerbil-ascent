(import :std/test :gerbil-ascent/core/relation-view :gerbil-ascent/table/trrel-uf
        :gerbil-ascent/t/performance/uf-capture/fixture
        (prefix-in :gerbil-ascent/t/performance/uf-capture/reference-trrel-uf old-))
(export ascent-uf-capture-test)
(def (truth input)
  (let ((groups (make-hash-table)) (answer (make-hash-table)))
    (for-each (lambda (row)
      (let* ((prefix (take row (- (length row) 2))) (pair (drop row (- (length row) 2)))
             (adj (or (hash-get groups prefix) (let (table (make-hash-table))
                    (hash-put! groups prefix table) table))))
        (hash-put! adj (car pair) (cons (cadr pair) (or (hash-get adj (car pair)) [])))
        (unless (hash-key? adj (cadr pair)) (hash-put! adj (cadr pair) [])))) input)
    (hash-for-each (lambda (prefix adj)
      (hash-for-each (lambda (start _)
        (let (seen (make-hash-table))
          (let walk ((pending (list start)))
            (unless (null? pending)
              (let (node (car pending))
                (if (hash-key? seen node) (walk (cdr pending))
                  (begin (hash-put! seen node #t)
                    (hash-put! answer (append prefix (list start node)) #t)
                    (walk (append (hash-get adj node) (cdr pending)))))))))) adj)) groups)
    answer))
(def (exercise input indexed? tail)
  (let ((old (old-gerbil-ascent-trrel-uf-state)) (new (gerbil-ascent-trrel-uf-state)))
    (for-each (lambda (row)
      (old-gerbil-ascent-trrel-uf-count-insert! old row 1000000)
      (gerbil-ascent-trrel-uf-count-insert! new row 1000000)) input)
    (let* ((previous (capture-view old #t indexed?)) (held (capture-view new #f indexed?))
           (expected (capture-rows previous #t)) (actual (capture-rows held #f)) (wanted (truth input)))
      (let (reference (list->hash-table (map (cut cons <> #t) expected)))
        (check-equal? (length actual) (length expected))
        (check-equal? (andmap (cut hash-get reference <>) actual) #t))
      (check-equal? (length actual) (hash-length wanted))
      (check-equal? (hash-length (list->hash-table (map (cut cons <> #t) actual))) (hash-length wanted))
      (check-equal? (andmap (cut hash-get wanted <>) actual) #t)
      (for-each (lambda (constraints)
        (check-equal? (capture-query held #f (car constraints) (cadr constraints))
                      (filter (lambda (row)
                        (andmap (lambda (column key) (equal? (list-ref row column) key))
                          (car constraints) (cadr constraints))) actual)))
        (if (= (length (car input)) 2)
          '(((1) (64)) ((1 0) (64 0)) ((1 1) (64 64)) ((1 1) (64 63)) ((0 1) (0 64)) ((1) (999)))
          '(((2) (64)) ((0 2) (0 64)) ((2 2) (64 63)) ((2 0) (64 0)) ((0 1 2) (0 0 64)))))
      (let (public (capture-rows held #f))
        (set-car! (car public) 999) (set-cdr! public [])
        (for-each (cut gerbil-ascent-trrel-uf-count-insert! new <> 1000000) tail)
        (check-equal? (capture-rows held #f) actual)))))
(def ascent-uf-capture-test
  (test-suite "UF ordered singleton capture and query-local owner plans"
    (test-case "dense weighted grouped cuts retain exact order and independent DFS truth"
      (for-each (lambda (indexed?)
        (for-each (lambda (scenario)
          (exercise (capture-input scenario) indexed? [])) '(small sparse))
        (exercise (map (lambda (i) (list i (+ i 1))) (iota 96)) indexed? '((96 0)))
        (exercise (append (map (lambda (i) (list i (+ i 1))) (iota 96)) '((80 16))) indexed? '((96 0)))
        (exercise (apply append (map (lambda (g) (map (cut cons g <>)
          (map (lambda (i) (list i (+ i 1))) (iota 96)))) '(0 #f))) indexed? '((0 96 0) (#f 96 0)))) '(#f #t)))
    (test-case "nested readers own independent owner-cache coordinates"
      (let* ((state (ui-prepare #f 'indexed)) (view (capture-view state #f #t))
             (expected (capture-query view #f '(1) '(192))) (outer []) (nested? #f))
        (gerbil-ascent-for-each-row (lambda (row)
          (set! outer (cons row outer))
          (unless nested?
            (set! nested? #t)
            (check-equal? (length (capture-query view #f '(1) '(64))) 65)))
          (gerbil-ascent-view-select view '(1) '(192)))
        (check-equal? (reverse! outer) expected)))
    (test-case "published right plans preserve duplicate descriptors and all visitor protocols"
      (let* ((block (make-rectangle [] '(0 1) '(2 2 3)))
             (view (gerbil-ascent-rectangle-view
               (list block (make-rectangle [] '(4) '(2 5)) block) 14 5 #t))
             (expected '((0 2) (1 2) (4 2) (0 2) (1 2))))
        (check-equal? (capture-query view #f '(1) '(2)) expected)
        (for-each (lambda (visit)
          (let (rows [])
            (visit view '(1) '(2) (lambda (prefix left right)
              (set! rows (cons (append prefix (list left right)) rows))))
            (check-equal? (reverse! rows) expected)))
          (list gerbil-ascent-visit-view-parts! gerbil-ascent-visit-admitted-view-parts!))))
    (test-case "mixed descriptor arities keep checked routing semantics"
      (let (view (gerbil-ascent-rectangle-view
                  (list (make-rectangle [] '(0) '(1))
                        (make-rectangle '(scope label) '(2) '(3))
                        (make-rectangle '(scope label) '(4) '(3))) 3 6 #t))
        (check-equal? (capture-query view #f '(3) '(3)) '((scope label 2 3) (scope label 4 3)))))))
