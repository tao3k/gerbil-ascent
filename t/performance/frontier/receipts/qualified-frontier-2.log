PROGRESS recursive-chain-16 100/1000
PROGRESS recursive-chain-16 200/1000
PROGRESS recursive-chain-16 300/1000
PROGRESS recursive-chain-16 400/1000
PROGRESS recursive-chain-16 500/1000
PROGRESS recursive-chain-16 600/1000
PROGRESS recursive-chain-16 700/1000
PROGRESS recursive-chain-16 800/1000
PROGRESS recursive-chain-16 900/1000
PROGRESS recursive-chain-16 1000/1000
RESULT recursive-chain-16 old-p50-ns=23000 new-p50-ns=20000 paired-wins=869/1000
