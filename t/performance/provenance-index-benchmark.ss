(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/candidate/types make-reasoning-candidate)
        (only-in :gerbil-ascent/candidate/reasoning reasoning-source-snapshot)
        (only-in :gerbil-ascent/candidate/provenance-graph
                 candidate-positive-provenance positive-provenance-status
                 positive-provenance-witness positive-provenance-alternatives)
        (rename-in (only-in :gerbil-ascent/t/performance/provenance-index/reference
                           candidate-positive-provenance positive-provenance-status
                           positive-provenance-witness positive-provenance-alternatives)
                   (candidate-positive-provenance old-provenance)
                   (positive-provenance-status old-status)
                   (positive-provenance-witness old-witness)
                   (positive-provenance-alternatives old-alternatives)))
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call)
  (let (before (##process-statistics))
    (let (result (call))
      (let (after (##process-statistics))
        (values result (- (f64vector-ref after 7) (f64vector-ref before 7))
          (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
             (+ (f64vector-ref before 0) (f64vector-ref before 1))))))))
(def (parity! old new)
  (unless (and (eq? (positive-provenance-status new) 'complete)
               (eq? (old-status old) 'complete)
               (equal? (positive-provenance-witness new) (old-witness old))
               (equal? (positive-provenance-alternatives new) (old-alternatives old)))
    (error "ordered provenance parity failed")))
(def (main scenario library)
  (unless (member scenario '("small" "wide" "duplicates")) (error "unknown scenario" scenario))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "provenance benchmark requires symmetric native modules" name))))
   '("candidate/provenance" "candidate/provenance-graph" "t/performance/provenance-index/reference"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((count (if (string=? scenario "small") 1 256))
         (duplicates? (string=? scenario "duplicates"))
         (rows (map (lambda (n) (list (if duplicates? 1 n))) (iota count)))
         (expected (if duplicates? '((1)) rows))
         (snapshot (reasoning-source-snapshot 'index-benchmark 1 (list (list 's 1 rows))))
         (spec (make-reasoning-candidate '((p . 1)) []
                 (list (vector '(p ?x) '((s ?x)) 10)
                       (vector '(p ?x) '((p ?x)) 11))
                 (vector '(p ?x) 12) '(4096 4096 8192)))
         (old (lambda () (old-provenance snapshot spec 'program 'complete expected 100000 4096)))
         (new (lambda () (candidate-positive-provenance snapshot spec 'program 'complete expected 100000 4096)))
         (ab []) (bb []) (ac []) (bc []) (wins 0))
    (##gc)
    (parity! (old) (new))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old)) ((b u v) (measure new))) (values a x y b u v))
                        (let-values (((b u v) (measure new)) ((a x y) (measure old))) (values a x y b u v)))))
          (parity! a b)
          (unless (= (length (positive-provenance-alternatives b))
                     (+ count (* 2 (length expected))))
            (error "independent alternative count failed" scenario))
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 5))
          (displayln "PROVENANCE-PAIRS-CHECKED " scenario " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " scenario " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    ;; Private indexes add memory; large enumeration must earn that cost.
    ;; The small scenario records fixed overhead without claiming a speedup.
    (unless (or (string=? scenario "small")
                (and (<= (median bb) (* 1.5 (median ab)))
                     (<= (median bc) (* 0.9 (median ac))) (>= wins 35)))
      (error "provenance index CPU/allocation gate failed" scenario))
    (displayln "OK") (force-output)))
