(import (only-in :asp-gerbil-scheme/benchmark-api
                 benchmark-fixture-ref benchmark-fixture-contract-pass? benchmark-run/result)
        (only-in :gerbil/expander core-resolve-library-module-path)
        (only-in :gerbil-ascent/candidate/types make-reasoning-candidate)
        (only-in :gerbil-ascent/candidate/reasoning reasoning-source-snapshot)
        (only-in :gerbil-ascent/candidate/finite-evidence candidate-finite-evidence)
        (only-in :gerbil-ascent/candidate/stratified-producer candidate-produce-stratified-proof)
        (only-in :gerbil-ascent/candidate/stratified-proof candidate-verify-stratified-proof)
        (rename-in (only-in :gerbil-ascent/t/performance/stratified-model/reference-producer
                           candidate-produce-stratified-proof)
                   (candidate-produce-stratified-proof old-produce))
        (rename-in (only-in :gerbil-ascent/t/performance/stratified-model/reference-proof
                           candidate-verify-stratified-proof)
                   (candidate-verify-stratified-proof old-verify)))
(export main)
;; : (-> (List Number) Number)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
;; : (forall (a) (-> (-> a) (values a Number Number)))
(def (measure call)
  (##gc)
  (let* ((before (##process-statistics)) (result (call)) (after (##process-statistics))
         (bytes (- (f64vector-ref after 7) (f64vector-ref before 7) (f64vector-ref after 9))))
    (unless (>= bytes 0) (error "invalid cumulative allocation delta"))
    (values result bytes (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                            (+ (f64vector-ref before 0) (f64vector-ref before 1))))))
;; : (-> String Path Path Void)
(def (main scenario library receipt-path)
  (add-load-path! library)
  (def contract (call-with-input-file "t/performance/stratified-model/benchmark.ss" read))
  (unless (benchmark-fixture-contract-pass? contract) (error "invalid stratified model fixture"))
  (def entry (assq (string->symbol scenario) (benchmark-fixture-ref contract 'scenarios)))
  (unless entry (error "unknown stratified model scenario" scenario))
  (for-each (lambda (name)
    (unless (equal? (core-resolve-library-module-path (string->symbol (string-append ":gerbil-ascent/" name)))
                    (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
      (error "stratified model module mismatch" name)))
    '("candidate/closure-index" "candidate/stratified-proof" "candidate/stratified-producer"
      "t/performance/stratified-model/reference-proof" "t/performance/stratified-model/reference-producer"))
  (let* ((config (cdr entry)) (get (lambda (key) (benchmark-fixture-ref config key)))
         (size (get 'rows)) (relations (get 'relations)) (distinct (get 'distinct))
         (derived? (get 'derived?))
         (names (map (lambda (i) (string->symbol (string-append "s" (number->string i)))) (iota relations)))
         (rows (map (lambda (i) (list (modulo i distinct))) (iota size)))
         (snapshot (reasoning-source-snapshot 'stratified-model 1
                      (map (lambda (name) (list name 1 rows)) names)))
         (name (if derived? 'p (last names)))
         (spec (make-reasoning-candidate (if derived? '((p . 1)) []) []
                 (if derived? (list (vector '(p ?x) (list (list (car names) '?x)) 10)) [])
                 (vector (list name '?x) 11) '(4096 4096 8192)))
         (expected (map list (iota distinct)))
         (certificate (candidate-finite-evidence snapshot spec 'program 'complete expected 100000))
         (old (lambda () (let-values (((status proof) (old-produce snapshot spec 'program 'complete expected certificate 100000 100000)))
                            (list status proof))))
         (new (lambda () (let-values (((status proof) (candidate-produce-stratified-proof snapshot spec 'program 'complete expected certificate 100000 100000)))
                            (list status proof))))
         (ab []) (bb []) (ac []) (bc []) (wins 0) (count 0))
    (def (check a b)
      (unless (and (eq? (car a) 'complete) (equal? a b)) (error "ordered proof differs" scenario))
      (let* ((proof (cadr b)) (nodes (list->vector (cadr proof)))
             (actual (map (lambda (id) (caddr (vector-ref nodes id))) (caddr proof))))
        (unless (equal? actual expected) (error "proof roots differ from direct truth" scenario))
        (unless (and (eq? (old-verify snapshot spec 'program 'complete expected certificate 100000 proof 100000) 'valid)
                     (eq? (candidate-verify-stratified-proof snapshot spec 'program 'complete expected certificate 100000 proof 100000) 'valid))
          (error "independent proof verification differs" scenario))))
    (def (sample)
      (let-values (((a x u b y v)
        (if (even? count)
          (let-values (((a x u) (measure old)) ((b y v) (measure new))) (values a x u b y v))
          (let-values (((b y v) (measure new)) ((a x u) (measure old))) (values a x u b y v)))))
        (check a b)
        (set! ab (cons x ab)) (set! bb (cons y bb)) (set! ac (cons u ac)) (set! bc (cons v bc))
        (when (< v u) (set! wins (+ wins 1))))
      (set! count (+ count 1))
      (when (zero? (modulo count 5))
        (displayln "MODEL-PAIRS " scenario " " count "/50") (force-output))
      count)
    (check (old) (new))
    (let-values (((api-receipt selected) (benchmark-run/result contract sample)))
      (let* ((x (median ab)) (y (median bb)) (a (median ac)) (b (median bc))
             (pass? (and (<= y (+ (* x (get 'allocationRatio)) (get 'allocationOverheadBytes)))
                         (<= b (+ (* a (get 'cpuRatio)) (get 'cpuOverheadSeconds)))
                         (>= wins (get 'minimumCpuWins)))))
        (call-with-output-file receipt-path (lambda (port)
          (write (list (cons 'scenario scenario) (cons 'baseline (benchmark-fixture-ref contract 'baseline))
            (cons 'passed? pass?) (cons 'asp-receipt api-receipt) (cons 'cpu-wins wins)
            (cons 'old-bytes x) (cons 'new-bytes y) (cons 'old-cpu-us (* a 1000000)) (cons 'new-cpu-us (* b 1000000))
            (cons 'old-allocation ab) (cons 'new-allocation bb) (cons 'old-cpu ac) (cons 'new-cpu bc)) port)))
        (displayln "RESULT " scenario " " pass? " CPU-us " (* a 1000000) " -> " (* b 1000000)
                   " bytes " x " -> " y " wins " wins)
        (force-output) (unless pass? (error "stratified model performance gate failed" scenario))))))
