(import (only-in "program.ss" candidate-variable?))
(export prepare-proof-binding-flow
        (struct-out proof-binding-flow) (struct-out proof-binding-clause))

;;; Plans own syntax and slots; a fresh frame owns one linear derivation.
;;; Absence has a private marker, independent of any supplied scalar value.
(defstruct proof-binding-flow (fresh head clauses) final: #t)
(defstruct proof-binding-clause (relation apply) final: #t)
(defstruct proof-binding-term (kind value) final: #t)

;;; Resolve names only within this verification. External rows and proofs stay
;;; untrusted: each derivation receives an empty frame and checks its bindings.
;;; A failed prefix discards that frame; no later node inherits partial writes.
;; : (forall (a) (-> (Atom a) (Clauses a) (ProofBindingFlow a)))
;; : (-> InspectedHead InspectedClauses ProofBindingFlow)
(def (prepare-proof-binding-flow head body)
  (let ((slots (make-hash-table-eq)) (known (make-hash-table-eq))
        (guards (make-hash-table)) (size 0) (unbound (gensym 'unbound)))
    (def (slot name)
      (cond ((hash-get slots name) => values)
            (else (let (index size)
                    (set! size (+ size 1))
                    (hash-put! slots name index) index))))
    (def (bound? frame index) (not (eq? (vector-ref frame index) unbound)))
    ;; Successful prefixes prove first bindings and immutable repeated bindings.
    ;; Classify terms in source order, including repeats within the same atom.
    (def (prepare-term term)
      (cond
       ((eq? term '?_) (make-proof-binding-term 'wildcard #f))
       ((candidate-variable? term)
        (let (index (slot term))
          (if (hash-get known term)
            (make-proof-binding-term 'bound index)
            (begin (hash-put! known term #t)
                   (make-proof-binding-term 'fresh index)))))
       (else (make-proof-binding-term 'literal term))))
    (def (prepare-atom atom)
      (let (actions (map prepare-term (cdr atom)))
        (foldr (lambda ((action :- proof-binding-term) next)
                 (case action.kind
                   ((wildcard) (lambda (row frame) (next (cdr row) frame)))
                   ((fresh)
                    (lambda (row frame)
                      (vector-set! frame action.value (car row))
                      (next (cdr row) frame)))
                   ((bound)
                    (lambda (row frame)
                      (and (equal? (vector-ref frame action.value) (car row))
                           (next (cdr row) frame))))
                   ((literal)
                    (lambda (row frame)
                      (and (equal? action.value (car row)) (next (cdr row) frame))))))
               (lambda (_row _frame) #t) actions)))
    (def (prepare-fixed clause)
      (with ([mode . _] clause)
        (let* ((form (if (eq? mode 'where) (cadr clause) (caddr clause)))
               (inputs (map slot (cdr form)))
               (output (and (eq? mode 'compute) (slot (cadr clause)))))
          (def (read-one frame)
            (let (index (car inputs))
              (and (bound? frame index) (vector-ref frame index))))
          (case mode
            ((where)
             (case (car form)
               ((even?)
                (lambda (frame)
                  (let (value (read-one frame))
                    (and (exact-integer? value) (even? value)))))
               ((<)
                (with ([left right] inputs)
                  (lambda (frame)
                    (let ((a (vector-ref frame left)) (b (vector-ref frame right)))
                      (and (exact-integer? a) (exact-integer? b) (< a b))))))))
            ((compute)
             (case (car form)
               ((identity)
                (let (input (car inputs))
                  (lambda (frame)
                    (and (bound? frame input) (not (bound? frame output))
                         (begin (vector-set! frame output (vector-ref frame input)) #t)))))
               ((+)
                (with ([left right] inputs)
                  (lambda (frame)
                    (let ((a (vector-ref frame left)) (b (vector-ref frame right)))
                      (and (not (bound? frame output))
                           (exact-integer? a) (exact-integer? b)
                           (begin (vector-set! frame output (+ a b)) #t))))))))))))
    (let* ((clauses
            (filter values (map (lambda (clause)
                   (case (car clause)
                     ((where)
                      ;; Fixed guards are pure and bindings never change after
                      ;; admission. A successful earlier equal guard proves this
                      ;; occurrence; producer work accounting remains separate.
                      (and (not (hash-get guards clause))
                           (begin (hash-put! guards clause #t)
                                  (make-proof-binding-clause #f (prepare-fixed clause)))))
                     ((compute)
                      (let (evaluate (prepare-fixed clause))
                        (hash-put! known (cadr clause) #t)
                        (make-proof-binding-clause #f evaluate)))
                     (else (make-proof-binding-clause (car clause) (prepare-atom clause))))) body)))
           (getters (map (lambda (term)
                          (if (candidate-variable? term)
                            (let (index (slot term))
                              (lambda (frame)
                                (unless (bound? frame index) (error "unbound positive proof head" term))
                                (vector-ref frame index)))
                            (lambda (_frame) term))) (cdr head))))
      (make-proof-binding-flow (lambda () (make-vector size unbound))
        (lambda (frame) (map (cut <> frame) getters)) clauses))))
