;;; Generated by SccState.lean; discovery index zero remains active.
(export gerbil-ascent-scc-state)
;; gerbil-ascent-scc-state
;; : (-> IndexExpression KnownBinding UnseenBranch CompletedBranch ActiveBranch Result)
;; | doc m%
;;     Read once: zero is active, false is unseen and true is complete.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-scc-state 0 (known) 'unseen 'done 'active)
;;     ;; => active
;;     ```
;;   %
(defrule (gerbil-ascent-scc-state index (known) unseen completed on-stack)
  (let (known index)
    (if (not known) unseen (if (eq? known #t) completed on-stack))))
