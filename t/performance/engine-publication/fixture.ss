(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/engine-publication/reference old-))
(export publication-prepare publication-consume publication-expected publication-project)
(def (publication-project result)
  (list (.ref result 'finished) (.ref result 'relation-names)
        ((.ref result 'relation-sizes)) ((.ref result 'rows-of) 'reach)
        (.ref result 'evaluation-path) (.ref result 'active-rule-count)))
(def (publication-prepare old? scenario)
  (let* ((width (case scenario ((wide) 1024) ((dirty) 256) (else 0)))
         (x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y))
         (program (gerbil-ascent-program
                    (append (list (gerbil-ascent-relation 'edge 2 (map (lambda (i) (list i (+ i 1))) (iota 16)))
                                  (gerbil-ascent-relation 'reach 1 '((0))))
                            (map (lambda (i) (gerbil-ascent-relation
                                              (string->symbol (string-append "unused" (number->string i))) 1 []))
                                 (iota width)))
                    (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list y)))
                             (list (gerbil-ascent-atom 'reach (list x)) (gerbil-ascent-atom 'edge (list x y)))))
                    1000000 1000000 1000000))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t))
         (initial ((.ref engine '.run)))
         (expected (list #t (map (cut .ref <> 'name) (.ref program 'relations))
                         (map (lambda (relation)
                                (cons (.ref relation 'name)
                                  (case (.ref relation 'name) ((edge) 16) ((reach) 17) (else 0))))
                              (.ref program 'relations))
                         (map list (iota 17)) 'stratified-semi-naive 1)))
    (unless (equal? (publication-project initial) expected) (error "initial publication truth differs" scenario))
    (vector program engine expected 0)))
(def (publication-consume state scenario old?)
  (with (#(program retained expected tick) state)
    (let* ((session? (not (eq? scenario 'fresh)))
           (engine (if (memq scenario '(cold fresh))
                     ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program session?)
                     retained))
           (repeats (if (memq scenario '(wide dirty)) 16 1)))
      (map (lambda (_)
             (when (memq scenario '(wide dirty))
               (vector-set! state 3 (+ 1 (vector-ref state 3)))
               ((.ref engine '.append-source!) 'unused0 (list (vector-ref state 3))))
             (when (eq? scenario 'duplicate) ((.ref engine '.append-source!) 'reach '(0)))
             (let (result (if session? ((.ref engine '.run)) (engine)))
               (let ((actual (publication-project result)) (wanted (vector-ref state 2)))
                 (if (memq scenario '(wide dirty))
                   (let* ((count (vector-ref state 3))
                          (sizes (map (lambda (entry)
                                        (if (eq? (car entry) 'unused0) (cons 'unused0 count) entry))
                                      (list-ref wanted 2)))
                          (truth (list (car wanted) (cadr wanted) sizes
                                       (list-ref wanted 3) (list-ref wanted 4) (list-ref wanted 5))))
                     (unless (and (equal? actual truth)
                                  (equal? ((.ref result 'rows-of) 'unused0) (map list (iota count 1))))
                       (error "changed publication truth differs" scenario count))
                     wanted)
                   actual)))) (iota repeats)))))
(def (publication-expected state scenario)
  (make-list (if (memq scenario '(wide dirty)) 16 1) (vector-ref state 2)))
