-                   re.findall(r'```(?:scheme|gerbil)?\s*\n(.*?)\n```', text, re.S)]
-    parsed = [(candidate, _prediction(candidate)) for candidate in candidates]
-    parsed = [(candidate, value) for candidate, value in parsed if value is not None]
