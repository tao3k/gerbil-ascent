(export gerbil-ascent-certificate-terms!)

;; gerbil-ascent-certificate-terms!
;; : (-> SourceTerms Actions SlotMap Natural Boolean (Maybe Natural))
;; | doc m%
;;     Check source/action agreement using a private slot map, never the compiler map.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-certificate-terms! '() '() (make-hash-table-eq) 0 #f)
;;     ;; => 0
;;     ```
;;   %
(def (gerbil-ascent-certificate-terms! sources actions slots count head?)
  (let/cc reject
    (unless (and (list? actions) (= (length sources) (length actions))) (reject #f))
    (for-each
      (lambda (source action)
        (unless (pair? action) (reject #f))
        (with ([kind . payload] source)
          (with ([action-kind . action-slot] action)
            (case kind
          ((literal wildcard) (unless (equal? source action) (reject #f)))
          ((variable)
            (let (known (hash-get slots payload))
              (if known (if (and (eq? action-kind 'bound) (eqv? action-slot known)) (void) (reject #f)) (if head? (reject #f) (if (and (eq? action-kind 'fresh) (eqv? action-slot count)) (begin (hash-put! slots payload count) (set! count (+ count 1))) (reject #f))))))
          (else (reject #f)))))) sources actions)
    count))
(export gerbil-ascent-certificate-keys?)

;; gerbil-ascent-certificate-keys?
;; : (-> SourceTerms Columns Keys SlotMap Boolean)
;; | doc m%
;;     Check each finite key coordinate against the independently reconstructed slot map.
;;
;;     # Examples
;;
;;     ```scheme
;;     (gerbil-ascent-certificate-keys? '() '() '() (make-hash-table-eq))
;;     ;; => #t
;;     ```
;;   %
(def (gerbil-ascent-certificate-keys? sources columns keys slots)
  (let/cc reject
    (unless (and (list? columns) (list? keys) (= (length columns) (length keys))) (reject #f))
    (unless (null? columns)
      (let* ((view (list->vector sources)) (width (vector-length view)))
        (for-each
          (lambda (column key)
            (unless (and (exact-integer? column) (<= 0 column) (< column width)) (reject #f))
            (let (source (vector-ref view column))
              (with ([kind . payload] source)
                (case kind
                ((literal) (unless (equal? key source) (reject #f)))
                ((variable)
                  (let (known (hash-get slots payload))
                    (unless (and known (pair? key)) (reject #f))
                    (with ([key-kind . key-slot] key)
                      (unless (and (eq? key-kind 'bound) (eqv? key-slot known)) (reject #f)))))
                (else (reject #f)))))) columns keys)))
    #t))
