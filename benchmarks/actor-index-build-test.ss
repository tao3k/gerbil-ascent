(import :std/test
        (only-in :gerbil/runtime/table &raw-table-table)
        (only-in :gerbil/runtime/interface &interface-instance-object)
        (only-in :gerbil-ascent/table/provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/table/access gerbil-ascent-physical-index-extend!)
        (only-in :gerbil-ascent/table/funs gerbil-ascent-index-order! gerbil-ascent-index-batch!))
(export actor-index-build-test)

(def (sample-quantile samples divisor)
  (let* ((ordered (list-sort < samples))
         (count (length ordered)))
    (* 1000000. (list-ref ordered (- (quotient (+ (* count divisor) 99) 100) 1)))))

(def (report-phase shape setup phase samples)
  (display "ACTOR-COLD-INDEX ")
  (write (list (cons 'shape shape) (cons 'table-setup setup) (cons 'phase phase)
               (cons 'samples (length samples)) (cons 'p50-cpu-us (sample-quantile samples 50))
               (cons 'p95-cpu-us (sample-quantile samples 95))))
  (newline))

(def (cold-fill! table rows)
  (gerbil-ascent-physical-index-extend! gerbil-ascent-hash-index-provider table rows '(0)))

(def (backing table)
  (&raw-table-table (&interface-instance-object table)))

;; Observe the native growth path once outside the timed samples. Each
;; backing identity change is one vector allocation in the pinned Gerbil.
(def (count-backing-cells! index rows reused?)
  (let* ((storage (backing index))
         (initial (vector-length storage))
         (cells (if reused? 0 initial)))
    (def (observe!)
      (let (next (backing index))
        (unless (eq? storage next)
          (set! cells (+ cells (vector-length next)))
          (set! storage next))))
    (when reused? (hash-clear! index))
    (gerbil-ascent-index-batch! index rows row
      (begin (observe!) (list-ref row 0)))
    (observe!)
    (gerbil-ascent-index-order! index)
    (observe!)
    (values initial (vector-length storage) cells)))

(def (measure-cold-build rows keys size shape setup)
  (def (new)
    (if (eq? setup 'hinted)
      (make-hash-table size: size)
      (make-hash-table)))
  (let (retained (and (eq? setup 'recycled) (gerbil-ascent-index-order! (cold-fill! (new) rows))))
  (def (sample)
    (let* ((started (cpu-time))
           (index (if retained (begin (hash-clear! retained) retained) (new)))
           (allocated (cpu-time))
           (_ (cold-fill! index rows))
           (filled (cpu-time))
           (_ (gerbil-ascent-index-order! index))
           (finished (cpu-time)))
      (check-equal? (hash-length index) keys)
      (check-equal? (hash-get index -1) #f)
      (values (- allocated started) (- filled allocated) (- finished filled)
              (- finished started))))

  ;; Compare row occurrence identity and order independently of table order.
  (let (index (or retained (new)))
    (let-values (((before after cells) (count-backing-cells! index rows (and retained #t))))
      (when retained (check-equal? cells 0))
      (display "ACTOR-COLD-TABLE ")
      (write (list (cons 'shape shape) (cons 'table-setup setup)
                   (cons 'initial-vector-slots before) (cons 'filled-vector-slots after)
                   (cons 'allocated-vector-slots cells) (cons 'bucket-pairs size)))
      (newline))
    (let ((expected (make-vector keys [])) (observed 0))
      (for-each (lambda (row)
                  (vector-set! expected (car row) (cons row (vector-ref expected (car row)))))
                (reverse rows))
      (hash-for-each (lambda (key bucket)
                       (let (exact (vector-ref expected key))
                         (check-equal? bucket exact)
                         (check-equal? (andmap eq? bucket exact) #t)
                         (set! observed (+ 1 observed))))
                     index)
      (check-equal? observed keys)))
  (let loop ((remaining 1000) (allocated []) (filled []) (ordered []) (total []))
    (if (zero? remaining)
      (for-each (lambda (phase samples) (report-phase shape setup phase samples))
                '(allocate fill order total) (list allocated filled ordered total))
      (let-values (((a b c d) (sample)))
        (loop (- remaining 1) (cons a allocated) (cons b filled)
          (cons c ordered) (cons d total)))))))

(def (project-keys rows)
  (let loop ((remaining 1000) (samples []))
    (if (zero? remaining)
      (report-phase 'chain 'projection 'sum-column-control samples)
      (let* ((started (cpu-time))
             (result (foldl (lambda (row acc) (+ acc (list-ref row 0))) 0 rows))
             (elapsed (- (cpu-time) started)))
        (check-equal? result 134209536)
        (loop (- remaining 1) (cons elapsed samples))))))

(def actor-index-build-test
  (test-suite "Canonical Actor cold bucket build phases"
    (test-case "native table allocation, bucket insertion and order on chain and skew"
      (let* ((size 16384)
             (chain (map (lambda (n) (list n (+ n 1))) (reverse (iota size))))
             (skew (map (lambda (n) (list (modulo n 32) (+ n 1))) (reverse (iota size)))))
        (project-keys chain)
        (for-each (lambda (setup) (measure-cold-build chain size size 'chain setup))
                  '(default hinted recycled))
        (for-each (lambda (setup) (measure-cold-build skew 32 size 'skew setup))
                  '(default hinted recycled))))))
