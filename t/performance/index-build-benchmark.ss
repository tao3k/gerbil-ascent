(import :gerbil/runtime/gambit
        (only-in :gerbil/expander core-resolve-library-module-path)
        :gerbil-ascent/t/performance/index-build/fixture)
(export main)
(def (median xs) (list-ref (list-sort < xs) (quotient (length xs) 2)))
(def (measure call repetitions)
  (let (before (##process-statistics))
    (let loop ((left repetitions) (result #f))
      (if (zero? left)
        (let (after (##process-statistics))
          (values result (/ (- (f64vector-ref after 7) (f64vector-ref before 7)) repetitions)
                  (/ (- (+ (f64vector-ref after 0) (f64vector-ref after 1))
                        (+ (f64vector-ref before 0) (f64vector-ref before 1))) repetitions)))
        (loop (- left 1) (call))))))
(def (paired name old new parity repetitions mode)
  (##gc)
  (for-each (lambda (_) (parity (old) (new))) (iota 4))
  (let ((ab []) (bb []) (ac []) (bc []) (wins 0))
    (let loop ((sample 0))
      (when (< sample 50)
        (let-values (((a x y b u v)
                      (if (even? sample)
                        (let-values (((a x y) (measure old repetitions)) ((b u v) (measure new repetitions))) (values a x y b u v))
                        (let-values (((b u v) (measure new repetitions)) ((a x y) (measure old repetitions))) (values a x y b u v)))))
          (parity a b)
          (set! ab (cons x ab)) (set! bb (cons u bb))
          (set! ac (cons y ac)) (set! bc (cons v bc))
          (when (< v y) (set! wins (+ wins 1))))
        (when (zero? (modulo (+ sample 1) 10))
          (displayln "INDEX-BUILD-PAIRS-CHECKED " name " " (+ sample 1) "/50") (force-output))
        (loop (+ sample 1))))
    (displayln "RESULT " name " old-bytes=" (median ab) " new-bytes=" (median bb)
               " old-cpu-us=" (* 1000000 (median ac)) " new-cpu-us=" (* 1000000 (median bc))
               " cpu-wins=" wins "/50") (force-output)
    (let (pass?
          (case mode
            ((scalar) (and (<= (median bb) (* 0.80 (median ab)))
                           (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))
            ((composite) (and (<= (median bb) (* 0.90 (median ab)))
                              (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))
            (else (and (<= (median bb) (+ (median ab) 1024))
                       (<= (median bc) (+ (* 1.05 (median ac)) 0.000020))))))
      ;; Fixed before sampling: scalar 20% / composite 10% less allocation;
      ;; controls <=1 KiB extra. Every CPU overhead <=5% + 20 us.
      (list (cons 'name name) (cons 'passed? pass?) (cons 'cpu-wins wins)
            (cons 'old-bytes (median ab)) (cons 'new-bytes (median bb))
            (cons 'old-cpu-us (* 1000000 (median ac))) (cons 'new-cpu-us (* 1000000 (median bc)))
            (cons 'old-allocation ab) (cons 'new-allocation bb)
            (cons 'old-cpu ac) (cons 'new-cpu bc)))))
(def (main scenario library receipt)
  (unless (member scenario '("scalar-dense" "scalar-unique" "composite-dense" "composite-unique" "empty" "small" "solve"))
    (error "unknown index build scenario" scenario))
  (for-each
   (lambda (name)
     (let (path (path-expand (string-append "gerbil-ascent/" name ".ssi") library))
       (unless (and (equal? path (core-resolve-library-module-path
                                  (string->symbol (string-append ":gerbil-ascent/" name))))
                    (file-exists? (string-append (path-strip-extension path) ".o1")))
         (error "index build requires symmetric native modules" name))))
   '("table/funs" "table/access" "program/index" "program/evaluate"
     "t/performance/index-build/reference-funs" "t/performance/index-build/reference-access"
     "t/performance/index-build/reference-index" "t/performance/index-build/reference-evaluate"
     "t/performance/index-build/fixture"))
  (displayln "NATIVE-MODULES-OK") (force-output)
  (let* ((solve? (string=? scenario "solve"))
         (small? (member scenario '("small" "empty")))
         (size (cond ((string=? scenario "empty") 0) (small? 4) (solve? 1024) (else 4096)))
         (scalar? (or small? (member scenario '("scalar-dense" "scalar-unique"))))
         (unique? (member scenario '("scalar-unique" "composite-unique")))
         (columns (if scalar? (if unique? '(1) '(0)) (if unique? '(1 3) '(0 2))))
         (source (index-build-source size))
         (batch (if small? [] (index-build-source 32 size)))
         (keys (map (lambda (row) (index-build-key row columns)) (take source (min 8 size))))
         (expected (if solve? (map list (iota 1024))
                     (map (lambda (key)
                            (filter (lambda (row) (equal? (index-build-key row columns) key))
                                    (append (reverse batch) source))) keys)))
         (program (and solve? (index-build-program)))
         (call (lambda (old?)
                 (if solve? (index-build-solve old? program)
                   (index-build-lifecycle old? source batch columns keys))))
         (result (paired scenario (lambda () (call #t)) (lambda () (call #f))
                         (lambda (a b) (unless (and (equal? a b) (equal? b expected))
                                         (error "ordered index independent oracle differs" scenario)))
                         (if small? 128 4)
                         (cond ((or small? solve?) 'control) (scalar? 'scalar) (else 'composite)))))
    (call-with-output-file [path: receipt truncate: #t]
      (lambda (port) (write (list (cons 'baseline '3eb66283edd50f25d0ce74c6743fb17d131302b6)
                                  (cons 'paired-samples 50) result) port) (newline port)))
    (unless (cdr (assq 'passed? result)) (error "index build allocation/CPU gate failed" scenario)))
  (displayln "OK") (force-output))
