(import :clan/poo/object :gerbil-ascent/program/objects
        (only-in :gerbil-ascent/table/interface gerbil-ascent-eqrel-storage-provider
                 gerbil-ascent-trrel-uf-storage-provider gerbil-ascent-hash-index-provider)
        (only-in :gerbil-ascent/program/evaluate gerbil-ascent-make-engine)
        (prefix-in :gerbil-ascent/t/performance/view-export/reference-evaluate old-))
(export ve-program ve-prepare ve-consume ve-expected ve-project)
(def (size scenario) (case scenario ((eqrel) 128) ((retained native uf) 64) ((grouped) 8) ((derived) 16) (else 1)))
(def (edges n) (map (lambda (i) (list i (+ i 1))) (iota n)))
(def (source scenario)
  (case scenario
    ((grouped) (apply append (map (lambda (g) (map (cut cons g <>) (edges 8))) (iota 32))))
    ((eqrel) (append (edges 128) (make-list 300 '(0 1))))
    ((uf) (append (edges 64) (make-list 300 '(0 1))))
    (else (edges (size scenario)))))
(def (ve-program scenario)
  (let* ((rows (source scenario))
         (relation (gerbil-ascent-relation 'reach (if (eq? scenario 'grouped) 3 2)
                     (if (eq? scenario 'derived) [] rows) gerbil-ascent-hash-index-provider
                     (if (memq scenario '(uf native)) gerbil-ascent-trrel-uf-storage-provider
                         gerbil-ascent-eqrel-storage-provider)))
         (x (gerbil-ascent-variable 'x)) (y (gerbil-ascent-variable 'y)))
    (gerbil-ascent-program
      (if (eq? scenario 'derived) (list (gerbil-ascent-relation 'input 2 rows) relation) (list relation))
      (if (eq? scenario 'derived)
        (list (gerbil-ascent-rule (list (gerbil-ascent-atom 'reach (list x y)))
                (list (gerbil-ascent-atom 'input (list x y))
                      (gerbil-ascent-guard '(x) (lambda (_) #t))))) [])
      200000 200000 200000)))
(def (ordered rows)
  (list-sort (lambda (a b)
               (let loop ((a a) (b b))
                 (and (pair? a) (or (< (car a) (car b))
                                   (and (= (car a) (car b)) (loop (cdr a) (cdr b))))))) rows))
(def (ve-project result)
  (let (names (.ref result 'relation-names))
    (list (.ref result 'finished) names ((.ref result 'relation-sizes))
          (map (lambda (name) ((.ref result 'rows-of) name)) names)
          (.ref result 'evaluation-path) (.ref result 'active-rule-count))))
(def (truth scenario n)
  (def (pairs transitive?)
    (apply append (map (lambda (a)
      (map (lambda (b) (list a b)) (if transitive? (iota (- (+ n 1) a) a) (iota (+ n 1))))) (iota (+ n 1)))))
  (let ((reach (if (eq? scenario 'grouped)
                 (apply append (map (lambda (g) (map (cut cons g <>) (pairs #f))) (iota 32)))
                 (pairs (memq scenario '(uf native))))))
    (if (eq? scenario 'derived) (list (edges n) reach) (list reach))))
(def (check-truth actual scenario n)
  (let ((rows (list-ref actual 3)) (wanted (truth scenario n)))
    (unless (and (car actual) (equal? (map ordered rows) (map ordered wanted))
                 (equal? (map cdr (list-ref actual 2)) (map length wanted)))
      (error "view export independent closure mismatch" scenario))))
(def (ve-prepare old? scenario)
  (let (program (ve-program scenario))
    ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t)
    (vector program)))
(def (ve-consume state scenario old?)
  (let* ((program (if (eq? scenario 'cold) (ve-program scenario) (vector-ref state 0)))
         (engine ((if old? old-gerbil-ascent-make-engine gerbil-ascent-make-engine) program #t))
         (run (.ref engine '.run)) (first (run)))
    (when (eq? scenario 'retained)
      (for-each (lambda (i)
                  ((.ref engine '.append-source!) 'reach (list i (+ i 1)))
                  (ve-project (run))) (iota 8 64)))
    (let (result (run))
      (map (lambda (_) (ve-project result)) (iota (if (memq scenario '(cold small)) 1 3))))))
;; The reference independently supplies exact historical export order. Matrix
;; truth separately checks the complete closure; both checks run in every leg.
(def (ve-expected state scenario)
  (let (result (ve-consume state scenario #t))
    (for-each (lambda (actual) (check-truth actual scenario (if (eq? scenario 'retained) 72 (size scenario)))) result)
    result))
